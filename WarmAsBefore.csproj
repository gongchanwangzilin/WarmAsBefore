<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>WarmAsBefore</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>温暖如初</ApplicationTitle>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Windows: 无 MSIX 打包，直接出 EXE -->
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>
    <UseMonoRuntime Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</UseMonoRuntime>
    <!-- 本地化：默认语言资源（zh-CN）放在 AppResources.resx，其他语言放 AppResources.&lt;culture&gt;.resx -->
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <!-- 保留自定义 Program.cs（含日志），禁用 WinUI XAML 编译器自动生成的 Main 入口 -->
    <DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- 官方 workaround：WindowsAppSDK #3337，publish 时用 -p:RuntimeIdentifierOverride=win10-x64 -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\mainname.png" />
    <MauiImage Include="Resources\Images\*" />
    <!-- <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FDF6EE" BaseSize="128,128" /> -->
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\**\*.gitkeep" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 主题 XAML 嵌入为资源 -->
  <ItemGroup>
    <EmbeddedResource Include="DesignSystem\Theme\ColorPalette.xaml" LogicalName="DesignSystem.Theme.ColorPalette.xaml" />
    <EmbeddedResource Include="DesignSystem\Theme\ColorPaletteSakura.xaml" LogicalName="DesignSystem.Theme.ColorPaletteSakura.xaml" />
    <EmbeddedResource Include="DesignSystem\Theme\ColorPaletteBamboo.xaml" LogicalName="DesignSystem.Theme.ColorPaletteBamboo.xaml" />
    <EmbeddedResource Include="DesignSystem\Theme\ColorPaletteMist.xaml" LogicalName="DesignSystem.Theme.ColorPaletteMist.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.*" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="4.1.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.*" />
  </ItemGroup>

  <!-- 桌面端截图（好感瞬间）仅 Windows 可用 -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

</Project>