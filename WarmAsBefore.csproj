<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <RootNamespace>WarmAsBefore</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>温暖如初</ApplicationTitle>
    <ApplicationDisplayVersion>1.65.0</ApplicationDisplayVersion>
    <ApplicationVersion>76</ApplicationVersion>
    <!-- 兼容目标：Android 11 (API 30) 及以上；minSdk 设 24 (Android 7.0) 留余量。
         若未来要求支持 Android 9 (API 28)，保持 24 不变即可（代码侧无 28+ 专属 API 依赖）。 -->
    <AndroidMinSdkVersion>24</AndroidMinSdkVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Windows: 无 MSIX 打包，直接出 EXE -->
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>
    <UseMonoRuntime Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</UseMonoRuntime>
    <!-- 本地化：默认语言资源（zh-CN）放在 AppResources.resx，其他语言放 AppResources.&lt;culture&gt;.resx -->
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <!-- 保留自定义 Program.cs（含日志），禁用 WinUI XAML 编译器自动生成的 Main 入口 -->
    <DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- 官方 workaround：WindowsAppSDK #3337，publish 时用 -p:RuntimeIdentifierOverride=win10-x64 -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\mainname.png" />
    <MauiImage Include="Resources\Images\*" />
    <!-- <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FDF6EE" BaseSize="128,128" /> -->
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\**\*.gitkeep" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Android 原生工具（proot 沙箱）：Termux 编译的 aarch64 二进制，宿主直接 exec。
       打进 APK assets，Android 首次启动时复制到应用数据目录并 chmod +x（APK 内资源无执行位）。 -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <MauiAsset Include="native\aarch64\proot" LogicalName="proot-sandbox/proot" />
    <MauiAsset Include="native\aarch64\libtalloc.so.2" LogicalName="proot-sandbox/libtalloc.so.2" />
    <MauiAsset Include="native\aarch64\libtermux-exec.so" LogicalName="proot-sandbox/libtermux-exec.so" />
    <MauiAsset Include="native\aarch64\libandroid-shmem.so" LogicalName="proot-sandbox/libandroid-shmem.so" />
    <!-- 阻止 MAUI Android 默认 glob 把 native/ 下文件当 jniLibs 收集（我们走 MauiAsset 路线） -->
    <AndroidNativeLibrary Remove="native\aarch64\**" />
    <None Remove="native\aarch64\**" />
  </ItemGroup>

  <!-- 阻止各平台 glob 把 native/ 下文件当 jniLibs / None 收集（Android 走 MauiAsset 路线） -->
  <ItemGroup>
    <None Remove="native\aarch64\**" />
  </ItemGroup>

  <!-- 本地工具链目录（.gitignore，CI 上不存在）：NDK 源码树里带了几个 .cs（spirv-headers 的 C# 绑定），
       会被默认 Compile glob 收进来撞成 CS0101 重复定义。显式排除，保证「SDK/JDK 放仓库内」的本地布局也能直接编译。 -->
  <ItemGroup>
    <Compile Remove="android-sdk\**" />
    <Compile Remove="android-jdk\**" />
    <!-- tools/ 下的独立控制台工程（rules_selftest 等）会在自己的 obj/ 里生成
         AssemblyInfo.cs / GlobalUsings.g.cs；默认 Compile glob 会把它们收进主项目，
         撞成 CS0579 特性重复。工具工程只应被自己编译，主项目整棵排除。 -->
    <Compile Remove="tools\**" />
  </ItemGroup>

  <!-- 主题 XAML 嵌入为资源 -->
  <ItemGroup>
    <EmbeddedResource Include="DesignSystem\Theme\ColorPalette.xaml" LogicalName="DesignSystem.Theme.ColorPalette.xaml" />
    <EmbeddedResource Include="DesignSystem\Theme\ColorPaletteSakura.xaml" LogicalName="DesignSystem.Theme.ColorPaletteSakura.xaml" />
    <EmbeddedResource Include="DesignSystem\Theme\ColorPaletteBamboo.xaml" LogicalName="DesignSystem.Theme.ColorPaletteBamboo.xaml" />
    <EmbeddedResource Include="DesignSystem\Theme\ColorPaletteMist.xaml" LogicalName="DesignSystem.Theme.ColorPaletteMist.xaml" />
    <EmbeddedResource Include="DesignSystem\Theme\ColorPaletteEndfield.xaml" LogicalName="DesignSystem.Theme.ColorPaletteEndfield.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.*" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="4.1.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.*" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <!-- 自定义性别逻辑 / 插件钩子：嵌入式 JS，不依赖 WebView 与 Chrome 内核 -->
    <PackageReference Include="Jint" Version="4.0.3" />
  </ItemGroup>

  <!-- 桌面端截图（好感瞬间）仅 Windows 可用 -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!-- 「系统识别」引擎用桌面 SAPI：WinRT SpeechRecognizer 在 unpackaged 进程里开不了麦，只会返回 Unknown -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <!-- 兼容修复：MAUI 9.0.120 的 nupkg 内不含 HybridWebView.js，但 .NET 10 SDK 的
       Windows publish 复制清单会去找它，缺文件时报 MSB3030。占位一份即可（该文件不参与
       本应用逻辑：本项目未使用 HybridWebView）。用 Condition 保证只在缺失时创建。 -->
  <Target Name="EnsureHybridWebViewJsForNet10Sdk" BeforeTargets="PrepareForBuild"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ItemGroup>
      <_MauiHybridJsMissing Include="$(NuGetPackageRoot)microsoft.maui.core/9.0.120/lib/net9.0-windows10.0.19041/Microsoft.Maui/Handlers/HybridWebView/HybridWebView.js" />
      <_MauiHybridJsMissing Include="$(NuGetPackageRoot)microsoft.maui.controls.core/9.0.120/lib/net9.0-windows10.0.19041/Microsoft.Maui/Handlers/HybridWebView/HybridWebView.js" />
    </ItemGroup>
    <MakeDir Directories="@(_MauiHybridJsMissing->'%(RootDir)%(Directory)')" Condition="!Exists('%(_MauiHybridJsMissing.Identity)')" />
    <WriteLinesToFile File="%(_MauiHybridJsMissing.Identity)" Lines="// placeholder: MAUI 9 package does not ship this file; .NET 10 SDK publish expects it."
                      Overwrite="false" Condition="!Exists('%(_MauiHybridJsMissing.Identity)')" />
  </Target>

  <!-- v1.61 3D 天气大气场：Evergine（各端渲染后端不同，按 TFM 条件引用）。
       版本统一在下方属性，双端保持同一引擎版本，避免场景代码出现 API 漂移。 -->
  <PropertyGroup>
    <EvergineVersion>2026.11.12.8</EvergineVersion>
    <!-- 场景全部用 C# 代码创建（不引入 Evergine Studio 的 .weproj 资产管线），
         关掉资产导出，避免 GetScenesToCompileTask 要求 EvergineAssetContent 目录。 -->
    <GenerateEvergineAssets>false</GenerateEvergineAssets>
    <GenerateEvergineScenesCode>false</GenerateEvergineScenesCode>
    <!-- 纯代码场景无 Studio 资产，但 targets 的内容通配符需要一个存在的安全根目录。 -->
    <EvergineAssetContent>$(MSBuildProjectDirectory)\EvergineContent</EvergineAssetContent>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <EvergineProfileName>#MAUI#Windows</EvergineProfileName>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <EvergineProfileName>#MAUI#Android</EvergineProfileName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Evergine.Common" Version="$(EvergineVersion)" />
    <PackageReference Include="Evergine.Framework" Version="$(EvergineVersion)" />
    <!-- PlaneMesh/MaterialComponent/PostProcessingGraphRenderer 等场景组件都在此包 -->
    <PackageReference Include="Evergine.Components" Version="$(EvergineVersion)" />
    <!-- MAUI 集成的 targets：Evergine.Targets 提供 EvergineContentExport 目标，
         Evergine.Targets.Maui 在其上做 MAUI 平台适配；两者必须同时引用（官方模板如此）。 -->
    <PackageReference Include="Evergine.Targets" Version="$(EvergineVersion)" />
    <PackageReference Include="Evergine.Targets.Maui" Version="$(EvergineVersion)" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- 官方 MAUI 模板 Windows 端用 DirectX11 + HLSLEverywhere（不是 DirectX12） -->
    <PackageReference Include="Evergine.CodeScenes" Version="$(EvergineVersion)" />
    <PackageReference Include="Evergine.DirectX11" Version="$(EvergineVersion)" />
    <PackageReference Include="Evergine.HLSLEverywhere" Version="$(EvergineVersion)" />
    <PackageReference Include="Evergine.XAudio2" Version="$(EvergineVersion)" />
    <PackageReference Include="Evergine.WinUI" Version="$(EvergineVersion)" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Evergine.Android" Version="$(EvergineVersion)" />
    <PackageReference Include="Evergine.Vulkan" Version="$(EvergineVersion)" />
    <PackageReference Include="Evergine.OpenAL" Version="$(EvergineVersion)" />
  </ItemGroup>

</Project>