<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <RootNamespace>WarmAsBefore</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>温暖如初</ApplicationTitle>
    <ApplicationDisplayVersion>1.3.0</ApplicationDisplayVersion>
    <ApplicationVersion>13</ApplicationVersion>
    <!-- 兼容目标：Android 11 (API 30) 及以上；minSdk 设 24 (Android 7.0) 留余量。
         若未来要求支持 Android 9 (API 28)，保持 24 不变即可（代码侧无 28+ 专属 API 依赖）。 -->
    <AndroidMinSdkVersion>24</AndroidMinSdkVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Windows: 无 MSIX 打包，直接出 EXE -->
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>
    <UseMonoRuntime Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</UseMonoRuntime>
    <!-- 本地化：默认语言资源（zh-CN）放在 AppResources.resx，其他语言放 AppResources.&lt;culture&gt;.resx -->
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <!-- 保留自定义 Program.cs（含日志），禁用 WinUI XAML 编译器自动生成的 Main 入口 -->
    <DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- 官方 workaround：WindowsAppSDK #3337，publish 时用 -p:RuntimeIdentifierOverride=win10-x64 -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\mainname.png" />
    <MauiImage Include="Resources\Images\*" />
    <!-- <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FDF6EE" BaseSize="128,128" /> -->
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\**\*.gitkeep" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Android 原生工具（proot 沙箱）：Termux 编译的 aarch64 二进制，宿主直接 exec。
       打进 APK assets，Android 首次启动时复制到应用数据目录并 chmod +x（APK 内资源无执行位）。 -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <MauiAsset Include="native\aarch64\proot" LogicalName="proot-sandbox/proot" />
    <MauiAsset Include="native\aarch64\loader" LogicalName="proot-sandbox/loader" />
    <MauiAsset Include="native\aarch64\loader32" LogicalName="proot-sandbox/loader32" />
    <MauiAsset Include="native\aarch64\libtalloc.so.2" LogicalName="proot-sandbox/libtalloc.so.2" />
    <MauiAsset Include="native\aarch64\libtermux-exec.so" LogicalName="proot-sandbox/libtermux-exec.so" />
    <MauiAsset Include="native\aarch64\libandroid-shmem.so" LogicalName="proot-sandbox/libandroid-shmem.so" />
    <!-- 阻止 MAUI Android 默认 glob 把 native/ 下文件当 jniLibs 收集（我们走 MauiAsset 路线） -->
    <AndroidNativeLibrary Remove="native\aarch64\**" />
    <None Remove="native\aarch64\**" />
  </ItemGroup>

  <!-- 阻止各平台 glob 把 native/ 下文件当 jniLibs / None 收集（Android 走 MauiAsset 路线） -->
  <ItemGroup>
    <None Remove="native\aarch64\**" />
  </ItemGroup>

  <!-- 主题 XAML 嵌入为资源 -->
  <ItemGroup>
    <EmbeddedResource Include="DesignSystem\Theme\ColorPalette.xaml" LogicalName="DesignSystem.Theme.ColorPalette.xaml" />
    <EmbeddedResource Include="DesignSystem\Theme\ColorPaletteSakura.xaml" LogicalName="DesignSystem.Theme.ColorPaletteSakura.xaml" />
    <EmbeddedResource Include="DesignSystem\Theme\ColorPaletteBamboo.xaml" LogicalName="DesignSystem.Theme.ColorPaletteBamboo.xaml" />
    <EmbeddedResource Include="DesignSystem\Theme\ColorPaletteMist.xaml" LogicalName="DesignSystem.Theme.ColorPaletteMist.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.*" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="4.1.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.*" />
  </ItemGroup>

  <!-- 桌面端截图（好感瞬间）仅 Windows 可用 -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

</Project>