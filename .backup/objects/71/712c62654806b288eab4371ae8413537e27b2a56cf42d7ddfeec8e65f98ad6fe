using Microsoft.Maui.Controls;
using Microsoft.Maui.Essentials;
using WarmAsBefore.Services;
using WarmAsBefore.ViewModels;

namespace WarmAsBefore.Views;

public partial class CharacterLibraryPage : ContentPage
{
    private readonly LingshuImporter _lingshuImporter;

    public CharacterLibraryPage(CharacterLibraryViewModel vm, LingshuImporter lingshuImporter)
    {
        InitializeComponent();
        BindingContext = vm;
        _lingshuImporter = lingshuImporter;
    }

    protected override void OnAppearing()
    {
        base.OnAppearing();
        if (BindingContext is CharacterLibraryViewModel vm) _ = vm.RefreshCommand.ExecuteAsync(null);
    }

    private async void OnLingshuImportClicked(object sender, EventArgs e)
    {
        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "选择灵枢 AI 导出的 JSON 文件",
                FileTypes = FilePickerFilters.Custom(new[] 
                { 
                    ("JSON", new[] { ".json" }),
                    ("所有文件", new[] { "*/*" })
                })
            });

            if (result is null) return;

            // 显示导入选项
            var action = await Shell.Current.DisplayActionSheet(
                "导入灵枢记忆", "取消", null,
                "创建新角色", "覆盖当前角色", "追加到同名角色");

            if (action is null || action == "取消") return;

            var mode = action switch
            {
                "覆盖当前角色" => LingshuImporter.ImportMode.Overwrite,
                "追加到同名角色" => LingshuImporter.ImportMode.Append,
                _ => LingshuImporter.ImportMode.CreateNew
            };

            var importResult = await _lingshuImporter.ImportAsync(result.FullPath, mode);

            if (importResult.Success)
            {
                await DisplayAlert("导入成功", 
                    $"已导入角色「{importResult.CharacterName}」\n记忆片段：{importResult.ImportedMemories} 条\n对话历史：{importResult.ImportedDialogues} 条", 
                    "好的");
                if (BindingContext is CharacterLibraryViewModel vm2)
                    _ = vm2.RefreshCommand.ExecuteAsync(null);
            }
            else
            {
                await DisplayAlert("导入失败", importResult.ErrorMessage, "好的");
            }
        }
        catch (Exception ex)
        {
            App.WriteLog($"CharacterLibraryPage.OnLingshuImportClicked -> {ex}");
            await DisplayAlert("错误", ex.Message, "好的");
        }
    }
}
