using CommunityToolkit.Mvvm.ComponentModel;
using CommunityToolkit.Mvvm.Input;
using WarmAsBefore.Modules.SaveSystem;
using WarmAsBefore.Services;

namespace WarmAsBefore.ViewModels;

public sealed partial class TitleViewModel : ObservableObject
{
    private readonly GameEngine _engine;
    private readonly SettingsManager _settings;
    private readonly DesignSystem.Theme.ThemeManager _theme;
    private readonly SaveManager _save;

    [ObservableProperty] private bool _showGenderSelect;
    [ObservableProperty] private bool _hasSave;
    [ObservableProperty] private string _startLabel = "";
        [ObservableProperty] private bool _menuLeft = true;
        [ObservableProperty] private string _themeEffectName = "";
        [ObservableProperty] private string _themeColorName = "经典";
        [ObservableProperty] private int _menuColumn;
        [ObservableProperty] private int _decorColumn = 1;

    public TitleViewModel(GameEngine engine, SettingsManager settings,
        DesignSystem.Theme.ThemeManager theme, SaveManager save)
    {
        _engine = engine;
        _settings = settings;
        _theme = theme;
        _save = save;
        ShowGenderSelect = string.IsNullOrEmpty(Preferences.Get("player_gender", ""));
        ApplySettings();
        _settings.Applied += ApplySettings;
        _theme.Changed += ApplySettings;
        // 语言切换时刷新 VM 侧本地化文本
        LocalizationService.Current.PropertyChanged += (_, _) => MainThread.BeginInvokeOnMainThread(() =>
        {
            ApplySettings();
            RefreshStateCommand.Execute(null);
        });
        RefreshStateCommand.Execute(null);
    }

    /// <summary>有存档 → 「再续情缘」（读最后一次游玩的存档直接继续）；无存档 → 「创建新欢」（新开一局）。</summary>
    [RelayCommand]
    private async Task RefreshState()
    {
        try
        {
            var slots = await _save.List();
            HasSave = slots.Count > 0;
            StartLabel = HasSave
                ? LocalizationService.Current["Title_Continue"]
                : LocalizationService.Current["Title_Start"];
        }
        catch (Exception ex) { App.WriteLog("Title: RefreshState EX -> " + ex); }
    }

    private void ApplySettings()
    {
        MenuLeft = _settings.Current.MenuSide != "right";
        MenuColumn = MenuLeft ? 0 : 1;
        DecorColumn = MenuLeft ? 1 : 0;
        var effect = _theme.ActiveEffect switch
        {
            "glass" => LocalizationService.Current["Title_ThemeGlass"],
            "frost" => LocalizationService.Current["Title_ThemeFrost"],
            "liquid" => LocalizationService.Current["Title_ThemeLiquid"],
            _ => LocalizationService.Current["Title_ThemeClassic"]
        };
        ThemeEffectName = $"{LocalizationService.Current["Title_ThemePrefix"]} · {effect}";
    }

    [RelayCommand]
    private async Task StartGame()
    {
        App.WriteLog("Title: StartGame clicked, HasSave=" + HasSave + ", ShowGenderSelect=" + ShowGenderSelect);
        // 有存档：再续情缘——直接读最后一次游玩的存档继续；无存档：创建新欢（新开一局）
        if (HasSave)
        {
            try
            {
                if (await _save.LoadLatest())
                {
                    await Shell.Current.GoToAsync("main");
                    return;
                }
            }
            catch (Exception ex) { App.WriteLog("Title: LoadLatest EX -> " + ex); }
            await OpenSave();
            return;
        }
        if (ShowGenderSelect) return;
        try
        {
            await Shell.Current.GoToAsync("select");
            App.WriteLog("Title: StartGame navigation ok");
        }
        catch (Exception ex) { App.WriteLog("Title: StartGame EX -> " + ex); }
    }

    [RelayCommand]
    private async Task OpenSave()
    {
        App.WriteLog("Title: OpenSave clicked");
        try { await Shell.Current.GoToAsync("save"); App.WriteLog("Title: OpenSave nav ok"); }
        catch (Exception ex) { App.WriteLog("Title: OpenSave EX -> " + ex); }
    }

    [RelayCommand]
    private async Task OpenSettings()
    {
        App.WriteLog("Title: OpenSettings clicked");
        try { await Shell.Current.GoToAsync("settings"); App.WriteLog("Title: OpenSettings nav ok"); }
        catch (Exception ex) { App.WriteLog("Title: OpenSettings EX -> " + ex); }
    }

    /// <summary>平行宇宙：进入已导入的小说世界选择页。</summary>
    [RelayCommand]
    private async Task OpenNovels()
    {
        App.WriteLog("Title: OpenNovels clicked");
        try { await Shell.Current.GoToAsync("novelselect"); App.WriteLog("Title: OpenNovels nav ok"); }
        catch (Exception ex) { App.WriteLog("Title: OpenNovels EX -> " + ex); }
    }

    /// <summary>角色库：管理所有角色，AI 可调用她们，也可让 AI 改写人设。</summary>
    [RelayCommand]
    private async Task OpenRoster()
    {
        App.WriteLog("Title: OpenRoster clicked");
        try { await Shell.Current.GoToAsync("roster"); App.WriteLog("Title: OpenRoster nav ok"); }
        catch (Exception ex) { App.WriteLog("Title: OpenRoster EX -> " + ex); }
    }

    [RelayCommand]
    private async Task ExitGame()
    {
        App.WriteLog("Title: ExitGame clicked");
        Application.Current?.Quit();
    }

    [RelayCommand]
    private void SelectGender(string gender)
    {
        if (gender is not "MALE" and not "FEMALE") return;
        Preferences.Set("player_gender", gender);
        ShowGenderSelect = false;
    }
}
