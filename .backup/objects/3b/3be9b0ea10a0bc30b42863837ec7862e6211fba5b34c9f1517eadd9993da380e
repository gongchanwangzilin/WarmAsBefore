using Microsoft.Maui.Controls;
#if ANDROID
using Microsoft.Maui.Essentials;
#endif
using WarmAsBefore.Services;
using WarmAsBefore.ViewModels;

namespace WarmAsBefore.Views;

public partial class CharacterLibraryPage : ContentPage
{
    private readonly OperitImporter _operitImporter;

    public CharacterLibraryPage(CharacterLibraryViewModel vm, OperitImporter operitImporter)
    {
        InitializeComponent();
        BindingContext = vm;
        _operitImporter = operitImporter;
    }

    protected override void OnAppearing()
    {
        base.OnAppearing();
        if (BindingContext is CharacterLibraryViewModel vm) _ = vm.RefreshCommand.ExecuteAsync(null);
    }

    private async void OnLingshuImportClicked(object sender, EventArgs e)
    {
        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "选择 Operit 聊天导出文件",
                FileTypes = FilePickerFilters.Custom(new[] 
                { 
                    ("JSON", new[] { ".json" }),
                    ("所有文件", new[] { "*/*" })
                })
            });

            if (result is null) return;

            StatusLabel.Text = "正在验证文件...";
            StatusLabel.TextColor = Colors.Gray;

            // 验证文件
            var validation = await _operitImporter.ValidateAsync(result.FullPath);
            if (!validation.Valid)
            {
                await DisplayAlert("验证失败", validation.ErrorMessage, "好的");
                return;
            }

            // 显示预览
            var preview = $"聊天数量：{validation.ChatCount}\n总消息数：{validation.TotalMessages}";
            if (validation.ChatTitles is not null && validation.ChatTitles.Any())
                preview += $"\n聊天标题：{string.Join(", ", validation.ChatTitles.Take(3))}";
            if (!string.IsNullOrEmpty(validation.AiRoleName))
                preview += $"\nAI 角色：{validation.AiRoleName}";

            var continueAction = await DisplayActionSheet(
                $"导入聊天记忆\n{preview}",
                "取消", null,
                "追加到记忆",
                "覆盖记忆");

            if (continueAction is null || continueAction == "取消") return;

            var mode = continueAction == "覆盖记忆" 
                ? OperitImporter.ImportMode.Overwrite 
                : OperitImporter.ImportMode.Append;

            StatusLabel.Text = "正在导入...";
            StatusLabel.TextColor = Colors.Gray;

            // 导入（使用当前激活角色）
            var importResult = await _operitImporter.ImportAsync(result.FullPath, mode: mode);

            if (importResult.Success)
            {
                await DisplayAlert("导入成功", 
                    $"已导入 {importResult.ImportedMessages} 条消息到角色「{importResult.CharacterName}」", 
                    "好的");
                if (BindingContext is CharacterLibraryViewModel vm2)
                    _ = vm2.RefreshCommand.ExecuteAsync(null);
            }
            else
            {
                await DisplayAlert("导入失败", importResult.ErrorMessage, "好的");
            }
        }
        catch (Exception ex)
        {
            App.WriteLog($"CharacterLibraryPage.OnLingshuImportClicked -> {ex}");
            await DisplayAlert("错误", ex.Message, "好的");
        }
    }
}
