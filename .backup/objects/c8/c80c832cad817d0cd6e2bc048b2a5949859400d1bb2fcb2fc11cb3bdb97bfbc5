name: Build Windows Release

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:
    inputs:
      version:
        description: '版本号 (e.g., v0.2)'
        required: true
        default: 'v0.2'

jobs:
  build-windows:
    runs-on: windows-latest
    
    strategy:
      matrix:
        rid: [win-x64]
      
    steps:
    - name: Checkout
      uses: actions/checkout@v4
      
    - name: Setup .NET 9
      uses: actions/setup-dotnet@v4
      with:
        dotnet-version: '9.0.x'
        
    - name: Restore dependencies
      run: dotnet restore WarmAsBefore.csproj
      
    - name: Publish Windows ${{ matrix.rid }}
      run: dotnet publish WarmAsBefore.csproj -c Release -p:TargetFramework=net9.0-windows10.0.19041.0 -r ${{ matrix.rid }} -p:WindowsPackageType=None
      
    - name: Get version
      id: version
      run: |
        if ("${{ github.event_name }}" -eq "workflow_dispatch") {
          Write-Output "version=${{ github.event.inputs.version }}" >> $env:GITHUB_OUTPUT
        } else {
          Write-Output "version=${{ github.ref_name }}" >> $env:GITHUB_OUTPUT
        }
        
    - name: Create Release
      id: create_release
      uses: actions/create-release@v1
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      with:
        tag_name: ${{ steps.version.outputs.version }}
        release_name: ${{ steps.version.outputs.version }}
        draft: true
        prerelease: false
        
    - name: Upload Windows ${{ matrix.rid }}
      uses: actions/upload-release-asset@v1
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      with:
        upload_url: ${{ steps.create_release.outputs.upload_url }}
        asset_path: bin/Release/net9.0-windows10.0.19041.0/${{ matrix.rid }}/publish/WarmAsBefore.exe
        asset_name: WarmAsBefore-${{ steps.version.outputs.version }}-win-${{ matrix.rid }}.exe
        asset_content_type: application/octet-stream