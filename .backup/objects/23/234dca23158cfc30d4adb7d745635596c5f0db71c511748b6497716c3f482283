using System.Text.Json;
using WarmAsBefore.Models;

namespace WarmAsBefore.Services;

/// <summary>
/// Operit 聊天导入服务：解析 Operit 导出的 JSON 文件，导入角色记忆和对话历史
/// 用户选择目标角色后，将聊天记录作为记忆注入
/// </summary>
public sealed class OperitImporter
{
    private readonly CharacterLibrary _charLibrary;
    private readonly GameEngine _engine;
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true
    };

    public OperitImporter(CharacterLibrary charLibrary, GameEngine engine)
    {
        _charLibrary = charLibrary;
        _engine = engine;
    }

    /// <summary>
    /// 验证 Operit JSON 文件
    /// </summary>
    public async Task<ValidationResult> ValidateAsync(string filePath)
    {
        var result = new ValidationResult { Valid = false };

        try
        {
            if (!File.Exists(filePath))
            {
                result.ErrorMessage = "文件不存在";
                return result;
            }

            var json = await File.ReadAllTextAsync(filePath);
            var archive = JsonSerializer.Deserialize<OperitChatArchive>(json, JsonOptions);

            if (archive is null)
            {
                result.ErrorMessage = "JSON 格式无效";
                return result;
            }

            result.Valid = archive.ArchiveType == "operit_chat_archive" && archive.Chats.Any();
            result.ChatCount = archive.Chats.Count;
            result.TotalMessages = archive.Chats.Sum(c => c.Messages.Count);

            if (result.Valid)
            {
                result.ChatTitles = archive.Chats.Select(c => c.Title).ToList();
                result.AiRoleName = archive.Chats.FirstOrDefault()?.Messages
                    .FirstOrDefault(m => m.BaseMessage.Sender == "ai")?.BaseMessage.RoleName ?? "AI";
            }

            if (!result.Valid)
                result.ErrorMessage = "不是有效的 Operit 聊天导出文件";
        }
        catch (Exception ex)
        {
            result.ErrorMessage = $"验证失败：{ex.Message}";
        }

        return result;
    }

    /// <summary>
    /// 导入 Operit 聊天到指定角色
    /// </summary>
    /// <param name="filePath">JSON 文件路径</param>
    /// <param name="characterId">目标角色 ID，为空则使用当前激活角色</param>
    /// <param name="importMode">导入模式</param>
    public async Task<ImportResult> ImportAsync(string filePath, string? characterId = null, ImportMode importMode = ImportMode.Append)
    {
        var result = new ImportResult { Success = false };

        try
        {
            if (!File.Exists(filePath))
            {
                result.ErrorMessage = "文件不存在";
                return result;
            }

            var json = await File.ReadAllTextAsync(filePath);
            var archive = JsonSerializer.Deserialize<OperitChatArchive>(json, JsonOptions);

            if (archive is null || !archive.Chats.Any())
            {
                result.ErrorMessage = "无效的聊天档案";
                return result;
            }

            // 确定目标角色
            var targetChar = ResolveTargetCharacter(characterId);
            if (targetChar is null)
            {
                result.ErrorMessage = "未找到目标角色，请先选择一个角色";
                return result;
            }

            result.CharacterId = targetChar.Profile.Id;
            result.CharacterName = targetChar.Profile.Name;

            // 处理每个聊天
            foreach (var chat in archive.Chats)
            {
                if (chat.Messages.Count == 0) continue;

                // 提取 AI 角色名（用于识别对话角色）
                var aiRoleName = chat.Messages
                    .FirstOrDefault(m => m.BaseMessage.Sender == "ai")?.BaseMessage.RoleName
                    ?? "月璃";

                // 转换消息
                var messages = chat.Messages
                    .Where(m => !string.IsNullOrWhiteSpace(m.BaseMessage.Content))
                    .Select(m => new ChatMessage
                    {
                        Role = m.BaseMessage.Sender.ToLower() == "user" ? "user" : "assistant",
                        Content = CleanContent(m.BaseMessage.Content),
                        Stamp = TimestampToLocalDateTime(m.BaseMessage.Timestamp)
                    })
                    .ToList();

                if (messages.Count == 0) continue;

                // 保存记忆
                await SaveMemoriesAsync(targetChar.Profile.Id, chat.Title, messages, importMode);
                result.ImportedMessages += messages.Count;
            }

            result.Success = true;
            App.WriteLog($"OperitImporter: 成功导入 {result.ImportedMessages} 条消息到角色「{result.CharacterName}」");
        }
        catch (Exception ex)
        {
            App.WriteLog($"OperitImporter.ImportAsync -> {ex}");
            result.ErrorMessage = $"导入失败：{ex.Message}";
        }

        return result;
    }

    /// <summary>
    /// 解析目标角色
    /// </summary>
    private CharacterData? ResolveTargetCharacter(string? characterId)
    {
        if (!string.IsNullOrEmpty(characterId) && _engine.Roster.TryGetValue(characterId, out var ch))
            return ch;

        if (_engine.ActiveCharacter is not null)
            return _engine.ActiveCharacter;

        // 如果没有激活角色，返回第一个角色
        return _engine.Roster.Values.FirstOrDefault();
    }

    /// <summary>
    /// 保存记忆到角色
    /// </summary>
    private async Task SaveMemoriesAsync(string characterId, string chatTitle, List<ChatMessage> messages, ImportMode mode)
    {
        try
        {
            var store = new StorageProvider();

            // 加载现有记忆
            var existingMemories = await store.Load<List<CharacterMemory>>($"memories_{characterId}") ?? new();

            if (mode == ImportMode.Overwrite)
            {
                existingMemories.Clear();
            }

            // 添加新记忆
            var newMemory = new CharacterMemory
            {
                Id = Guid.NewGuid().ToString("N")[..8],
                ChatTitle = chatTitle,
                Messages = messages,
                ImportedAt = DateTime.UtcNow,
                MessageCount = messages.Count
            };

            existingMemories.Add(newMemory);

            // 保存
            await store.Save($"memories_{characterId}", existingMemories);
        }
        catch (Exception ex)
        {
            App.WriteLog($"OperitImporter.SaveMemories -> {ex}");
            throw;
        }
    }

    /// <summary>
    /// 清理内容（去除 Markdown 格式等）
    /// </summary>
    private static string CleanContent(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";

        // 去除 LaTeX 格式（简化处理）
        var cleaned = content
            .Replace("\\n", "\n")
            .Replace("\\t", "\t")
            .Replace("\\\\", "\\");

        return cleaned.Trim();
    }

    /// <summary>
    /// 转换时间戳（毫秒）为本地时间
    /// </summary>
    private static DateTime TimestampToLocalDateTime(long timestampMs)
    {
        if (timestampMs <= 0) return DateTime.UtcNow;
        return DateTimeOffset.FromUnixTimeMilliseconds(timestampMs).UtcDateTime;
    }

    public enum ImportMode
    {
        Append,    // 追加到现有记忆
        Overwrite  // 覆盖现有记忆
    }

    public sealed class ValidationResult
    {
        public bool Valid { get; set; }
        public string? ErrorMessage { get; set; }
        public int ChatCount { get; set; }
        public int TotalMessages { get; set; }
        public List<string>? ChatTitles { get; set; }
        public string? AiRoleName { get; set; }
    }

    public sealed class ImportResult
    {
        public bool Success { get; set; }
        public string? CharacterId { get; set; }
        public string? CharacterName { get; set; }
        public string? ErrorMessage { get; set; }
        public int ImportedMessages { get; set; }
    }
}

/// <summary>
/// 角色记忆存储单元
/// </summary>
public sealed class CharacterMemory
{
    public string Id { get; set; } = Guid.NewGuid().ToString("N")[..8];
    public string ChatTitle { get; set; } = "";
    public List<ChatMessage> Messages { get; set; } = new();
    public DateTime ImportedAt { get; set; } = DateTime.UtcNow;
    public int MessageCount { get; set; }
}
