    <Compile Include="../../Services/Import/ChatLogDigest.cs" Link="ChatLogDigest.cs" />
    <Compile Include="../../Helpers/AffectionScale.cs" Link="AffectionScale.cs" />
  </ItemGroup>
</Project>
