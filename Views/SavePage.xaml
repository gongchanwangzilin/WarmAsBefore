<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.SavePage"
             x:Name="Page"

             Title=""
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0">
        <!-- Header：顶栏不是卡，与内容区同一块地，下面一条发丝线就够了 -->
        <Border Background="{DynamicResource WBarBrush}" StrokeThickness="0"
                Padding="{DynamicResource WPadWell}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="&lt; 返回" Style="{StaticResource BtnText}"
                        Padding="0"
                        Command="{Binding GoBackCommand}" />
                <Label Grid.Column="1" Text="存档管理" Style="{StaticResource TxtTitle}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>
        <BoxView Grid.Row="1" Style="{StaticResource HSep}" />

        <!-- Save slots：一个存档 = 一行，所有行装在同一张 CardGroup 里 -->
        <Border Grid.Row="2" Style="{StaticResource CardGroup}" Margin="{DynamicResource WPadCard}">
            <CollectionView ItemsSource="{Binding Slots}" BackgroundColor="Transparent">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6"
                                         Padding="{DynamicResource WPadCard}">
                        <Label Text="暂无存档" Style="{StaticResource TxtSubhead}"
                               HorizontalOptions="Center" />
                        <Label Text="回到标题点击「创建新欢」开始新的一局吧" Style="{StaticResource TxtMuted}"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SaveSlotItem">
                        <VerticalStackLayout Spacing="0">
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"
                                      RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <!-- 头像：凹一档的井就够了。原来那颗 44px 圆片自带一圈描边和一团
                                         左上落影，是拟物时代剩下的「凸起」说法，跟这套语言反着。 -->
                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                            Background="{DynamicResource WWellBrush}" StrokeThickness="0"
                                            WidthRequest="44" HeightRequest="44" VerticalOptions="Center"
                                            StrokeShape="{DynamicResource WRadiusWell}">
                                        <Label Text="{Binding CharacterName, Converter={StaticResource CharInitials}}"
                                               Style="{StaticResource TxtRowTitle}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Label}" Style="{StaticResource TxtRowTitle}" />
                                        <Label Style="{StaticResource TxtRowDesc}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding CharacterName}" FontAttributes="Bold" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding Scene}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding SavedAt, StringFormat='{0:MM/dd HH:mm}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>

                                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Text="读取"
                                            Style="{StaticResource BtnNeumorphSm}" WidthRequest="72"
                                            VerticalOptions="Center"
                                            Command="{Binding Path=BindingContext.LoadSlotCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding Id}" />

                                    <!-- 次要动作是文字级的，压在说明下面：三个小钮并排会把一行撑成两块 -->
                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="1"
                                                           Spacing="4">
                                        <Button Text="重命名" Style="{StaticResource BtnTextSm}"
                                                TextColor="{DynamicResource MutedFg}"
                                                Command="{Binding Path=BindingContext.RenameSlotCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding Id}" />
                                        <Button Text="导出" Style="{StaticResource BtnTextSm}"
                                                TextColor="{DynamicResource MutedFg}"
                                                Command="{Binding Path=BindingContext.ExportSlotCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding Id}" />
                                        <Button Text="权限" Style="{StaticResource BtnTextSm}"
                                                TextColor="{DynamicResource MutedFg}"
                                                Command="{Binding Path=BindingContext.OpenRulesCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding Id}" />
                                        <Button Text="删除" Style="{StaticResource BtnTextSm}"
                                                TextColor="{DynamicResource DangerInk}"
                                                Command="{Binding Path=BindingContext.DeleteSlotCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding Id}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                            <!-- 行首有头像，线从文字起：跨过圆片会把圆片读成「上一行的底」 -->
                            <BoxView Style="{StaticResource HSepInset}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Bottom bar: import / backup / novel-test -->
        <VerticalStackLayout Grid.Row="3" Spacing="6" Margin="{DynamicResource WPadCard}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="导入存档" Style="{StaticResource BtnNeumorph}"
                        Command="{Binding ImportSaveCommand}" />
                <Button Grid.Column="1" Text="备份全部" Style="{StaticResource BtnNeumorph}"
                        Command="{Binding BackupAllCommand}" />
            </Grid>
            <Button Text="导入小说（测试）" Style="{StaticResource BtnText}"
                    TextColor="{DynamicResource MutedFg}"
                    IsVisible="{Binding NovelTesting}"
                    Command="{Binding ImportNovelCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
