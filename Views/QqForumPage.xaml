<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:i18n="clr-namespace:WarmAsBefore.Services"
             x:Class="WarmAsBefore.Views.QqForumPage"
             x:Name="Page"
             x:DataType="vm:QqForumViewModel"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource QqPageBg}">

    <!--
      QQ 壳 · 论坛：话题面，纯本地数据（种子帖写死、自己发的帖子落盘 storage），不走 AI。
      Qq* 青蓝皮（WeChatBrand.xaml），与微信壳完全分开。
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0">

        <!-- 顶栏 -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
              BackgroundColor="{StaticResource QqHeader}" Padding="14,14">
            <Button Text="&lt;" Style="{StaticResource BtnText}" TextColor="{StaticResource QqInk}"
                    FontSize="20" Padding="0" WidthRequest="30"
                    Command="{Binding BackCommand}" />
            <Label Grid.Column="1" Text="{Binding [Forum_Title], Source={x:Static i18n:LocalizationService.Current}}"
                   TextColor="{StaticResource QqInk}" FontSize="18"
                   FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" />
            <BoxView Grid.Column="2" WidthRequest="30" Color="Transparent" InputTransparent="True" />
        </Grid>
        <BoxView HeightRequest="1" Color="{StaticResource QqSep}" />

        <!-- 话题 chips -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8" Padding="14,10,14,6">
            <BindableLayout.ItemsSource>
                <Binding Path="Topics" />
            </BindableLayout.ItemsSource>
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource QqInputBg}" StrokeThickness="0"
                            Padding="12,6" Margin="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectTopicCommand}"
                                CommandParameter="{Binding Id}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding Icon}" FontSize="13" />
                            <Label Text="{Binding Title}" FontSize="13" TextColor="{StaticResource QqInk}" />
                        </HorizontalStackLayout>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource QqAccentSoft}" />
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>
        <BoxView Grid.Row="2" HeightRequest="1" Color="{StaticResource QqSep}" VerticalOptions="Start" />

        <!-- 帖子流：置顶种子帖 + 自己发的帖 -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Posts}">
            <CollectionView.EmptyView>
                <Label Text="{Binding [Forum_Empty], Source={x:Static i18n:LocalizationService.Current}}"
                       TextColor="{StaticResource QqFaint}" FontSize="13"
                       VerticalOptions="Center" HorizontalOptions="Center" Padding="32" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource QqRow}" StrokeThickness="0"
                            Padding="12,10" Margin="14,0,14,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Author}" FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource QqInk}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMe}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource QqAccent}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Column="1" Text="{Binding Time}" FontSize="11"
                                       TextColor="{StaticResource QqFaint}" VerticalOptions="Center" />
                            </Grid>
                            <Label Grid.Row="1" Text="{Binding Text}" FontSize="14"
                                   TextColor="{StaticResource QqInk}" LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 发帖条：纯本地 -->
        <Border Grid.Row="3" BackgroundColor="{StaticResource QqPageBg}" Padding="10,8" StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <BoxView HeightRequest="1" Color="{StaticResource QqSep}" VerticalOptions="Start" HorizontalOptions="Fill" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border BackgroundColor="{StaticResource QqInputBg}" StrokeThickness="0" Padding="12,4">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <Editor x:Name="ForumEditor"
                            Text="{Binding InputText}"
                            Placeholder="{Binding [Forum_Placeholder], Source={x:Static i18n:LocalizationService.Current}}"
                            BackgroundColor="Transparent" TextColor="{StaticResource QqInk}"
                            PlaceholderColor="{StaticResource QqFaint}" FontSize="14"
                            Completed="OnEditorCompleted"
                            VerticalOptions="Center" />
                </Border>
                <Button Grid.Column="1"
                        Text="{Binding [Forum_Post], Source={x:Static i18n:LocalizationService.Current}}"
                        BackgroundColor="{StaticResource QqAccent}" TextColor="{StaticResource QqAccentInk}"
                        FontSize="13" FontAttributes="Bold"
                        CornerRadius="18" HeightRequest="40" WidthRequest="56" Padding="0"
                        Command="{Binding PostCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
