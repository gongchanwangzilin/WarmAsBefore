<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.SceneCalibrationPage"
             x:Name="CalRoot"
             x:DataType="vm:SceneCalibrationViewModel"
             Title="背景标定"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== 工具条：同一块地的一条 bar，不是一块深色板 =====
             原来底是 WarmDark（最深那档墨），字只能借 OffWhite50/Cream200 这些「面」来用，
             切到深色世界时面与面几乎同色，整排说明直接读不出来。 -->
        <Border Grid.Row="0" Background="{DynamicResource WBarBrush}" StrokeThickness="0"
                Padding="{DynamicResource WPadWell}">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="8">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding SceneName, StringFormat='标定背景：{0}'}"
                               Style="{StaticResource TxtTitle}" />
                        <Label Text="{Binding ImageInfo}" TextColor="{DynamicResource MutedFg}"
                               FontSize="{DynamicResource WSizeCaption}" />
                        <Label Text="{Binding StatusText}" TextColor="{DynamicResource SurfaceFg}"
                               FontSize="{DynamicResource WSizeCaption}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="取消" Style="{StaticResource BtnGhostSm}"
                            VerticalOptions="Center" Clicked="OnCancelClicked" />
                </Grid>

                <!-- 落脚点类型 -->
                <Grid ColumnDefinitions="Auto,*,*,*,Auto" ColumnSpacing="8">
                    <Label Text="落脚点" Style="{StaticResource TxtMuted}"
                           VerticalOptions="Center" WidthRequest="60" />
                    <Button Grid.Column="1" Text="{Binding PointChipLabel}" Style="{StaticResource BtnNeumorphSm}"
                            Command="{Binding SetLandingCommand}" CommandParameter="point" />
                    <Button Grid.Column="2" Text="{Binding FullChipLabel}" Style="{StaticResource BtnNeumorphSm}"
                            Command="{Binding SetLandingCommand}" CommandParameter="full" />
                    <Button Grid.Column="3" Text="{Binding LinearChipLabel}" Style="{StaticResource BtnNeumorphSm}"
                            Command="{Binding SetLandingCommand}" CommandParameter="linear" />
                </Grid>

                <!-- 缩放标定方式 -->
                <Grid ColumnDefinitions="Auto,*,*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="缩放" Style="{StaticResource TxtMuted}"
                           VerticalOptions="Center" WidthRequest="60" />
                    <Button Grid.Column="1" Text="{Binding DualLineChipLabel}" Style="{StaticResource BtnNeumorphSm}"
                            Command="{Binding SetScaleMethodCommand}" CommandParameter="dualLine" />
                    <Button Grid.Column="2" Text="{Binding SphereChipLabel}" Style="{StaticResource BtnNeumorphSm}"
                            Command="{Binding SetScaleMethodCommand}" CommandParameter="spheres" />
                    <Button Grid.Column="3" Text="⇄ 翻转第二条线" Style="{StaticResource BtnNeumorphSm}"
                            Command="{Binding FlipSecondScaleLineCommand}" />
                    <Button Grid.Column="4" Text="↻ 适应窗口" Style="{StaticResource BtnNeumorphSm}"
                            Command="{Binding FitViewCommand}" />
                </Grid>

                <!-- 画落脚线与画缩放线都要用线时才需要手动切目标，否则自动定 -->
                <Grid ColumnDefinitions="Auto,*,*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowTargetSwitch}">
                    <Label Text="当前操作" Style="{StaticResource TxtMuted}"
                           VerticalOptions="Center" WidthRequest="60" />
                    <Button Grid.Column="1" Text="{Binding TargetLandingLabel}" Style="{StaticResource BtnNeumorphSm}"
                            Command="{Binding SetTargetCommand}" CommandParameter="landing" />
                    <Button Grid.Column="2" Text="{Binding TargetScaleLabel}" Style="{StaticResource BtnNeumorphSm}"
                            Command="{Binding SetTargetCommand}" CommandParameter="scale" />
                </Grid>

                <Label Text="拖空白=新建 · 拖顶点/球心=移动 · 拖球缘=改半径 · 双击=删除（线身双击=插折点） · 右键=撤销 · 滚轮/双指=缩放 · 选「平移」后可拖动画面"
                       Style="{StaticResource TxtMuted}" />
            </VerticalStackLayout>
        </Border>

        <!-- ===== 画布 ===== -->
        <GraphicsView Grid.Row="1" x:Name="CalCanvas"
                      StartInteraction="OnCanvasStart"
                      DragInteraction="OnCanvasDrag"
                      EndInteraction="OnCanvasEnd"
                      SizeChanged="OnCanvasSizeChanged"
                      BackgroundColor="Black" />

        <!-- ===== 底部：强制输出 + 完成（CardSolid 把缝发到画刷上；BorderLine 是 Color，喂不了 Border.Stroke） ===== -->
        <Border Grid.Row="2" Style="{StaticResource CardSolid}" Margin="12,8,12,12">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding SummaryText}" Style="{StaticResource TxtBodySm}" />
                <Label Text="{Binding MissingText}" IsVisible="{Binding HasMissing}"
                       Style="{StaticResource TxtBodySm}" TextColor="{DynamicResource DangerInk}" />
                <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                    <Button Text="清空重标" Style="{StaticResource BtnGhostSm}"
                            HeightRequest="36" Command="{Binding ClearAllCommand}" />
                    <Button Text="✓ 完成标定" Style="{StaticResource BtnPrimarySm}"
                            HeightRequest="36"
                            IsEnabled="{Binding CanComplete}" Clicked="OnCompleteClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
