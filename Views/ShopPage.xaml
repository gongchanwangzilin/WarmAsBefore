<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:model="clr-namespace:WarmAsBefore.Models"
             x:Class="WarmAsBefore.Views.ShopPage"

             Title=""
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="0">

        <!-- Header：眉栏跟页面底同一块地，靠下面那条发丝线与内容分开，不靠描边 -->
        <VerticalStackLayout Spacing="0">
            <Border Background="{DynamicResource WBarBrush}" StrokeThickness="0" Padding="{DynamicResource WPadRow}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                    <Button Text="&lt; 返回" Style="{StaticResource BtnText}"
                            FontSize="{DynamicResource WSizeCaption}" Padding="8,0"
                            Command="{Binding GoBackCommand}" />
                    <Button Grid.Column="1" Text="🫀 身体状态" Style="{StaticResource BtnText}"
                            FontSize="{DynamicResource WSizeCaption}" Padding="8,0"
                            Command="{Binding OpenBodyStatusCommand}" />
                    <Label Grid.Column="2" Text="美了么"
                           Style="{StaticResource TxtTitle}"
                           VerticalOptions="Center" />
                    <Border Grid.Column="3"
                            Background="{DynamicResource WWellBrush}"
                            StrokeThickness="0" Padding="10,0" HeightRequest="24"
                            VerticalOptions="Center" StrokeShape="{DynamicResource WRadiusPill}">
                        <Label Text="{Binding WalletLabel}" Style="{StaticResource TxtRowTitle}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>
            <BoxView Style="{StaticResource HSep}" />
        </VerticalStackLayout>

        <!-- 战绩条 + buff 标记条：同一个店的两条实时状态，因此并成一栏、中间一条发丝线。
             这里不用 SettingRow（那是 52 高的表单行），状态条压到井距一档才不会读成两行设置。 -->
        <Border Grid.Row="1" Background="{DynamicResource WBarBrush}" Padding="0" StrokeThickness="0">
            <VerticalStackLayout Spacing="0">
                <Border Padding="{DynamicResource WPadWell}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding RecordLabel}" Style="{StaticResource TxtBodySm}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="胜局 +30 亲密币 · 败局 +10" Style="{StaticResource TxtMuted}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
                <VerticalStackLayout Spacing="0"
                                     IsVisible="{Binding BuffsLabel, Converter={StaticResource StringNotEmpty}}">
                    <BoxView Style="{StaticResource HSep}" />
                    <Border Padding="{DynamicResource WPadWell}">
                        <!-- buff 是当前生效的提示，用信号墨而不是面 -->
                        <Label Text="{Binding BuffsLabel}" Style="{StaticResource TxtMuted}"
                               TextColor="{DynamicResource AccentWarmFg}"
                               LineBreakMode="TailTruncation" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- 内容区：固定头部 + CollectionView 占满剩余高度（虚拟化：只渲染可见项） -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" Padding="{DynamicResource WPadCard}">

            <!-- 顶部工具区：AI 生成 + 同步 + 搜索 + 分类 -->
            <VerticalStackLayout Grid.Row="0" Spacing="{DynamicResource WGapSection}">

                <!-- AI 实时生成 -->
                <Border Style="{StaticResource CardGroup}">
                    <VerticalStackLayout Spacing="0">
                        <Border Style="{StaticResource SettingRow}">
                            <Label Text="AI 选品 · 想要啥说啥，实时上新" Style="{StaticResource TxtRowTitle}" />
                        </Border>
                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Entry Text="{Binding AiPrompt}"
                                       Placeholder="例：小雨喜欢的草莓味饮品、生日蛋糕…"
                                       FontSize="{DynamicResource WSizeCaption}"
                                       BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                       PlaceholderColor="{DynamicResource MutedFg}" VerticalOptions="Center" />
                                <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                    <ActivityIndicator IsRunning="{Binding Busy}"
                                                       IsVisible="{Binding Busy}"
                                                       WidthRequest="18" HeightRequest="18"
                                                       Color="{DynamicResource PrimaryAction}"
                                                       VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="生成" Style="{StaticResource BtnNeumorphic}"
                                            HeightRequest="34" Padding="14,0" FontSize="{DynamicResource WSizeCaption}"
                                            IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"
                                            Command="{Binding AiGenerateCommand}" />
                                </Grid>
                            </Grid>
                        </Border>
                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Label Text="{Binding AiStatus}" Style="{StaticResource TxtRowDesc}"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- GitHub 仓库同步 -->
                <Border Style="{StaticResource CardGroup}">
                    <VerticalStackLayout Spacing="0">
                        <Border Style="{StaticResource SettingRow}">
                            <Label Text="GitHub 仓库同步 · 仓库内 shop/catalog.json 会自动上架"
                                   Style="{StaticResource TxtRowTitle}" />
                        </Border>
                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Entry Text="{Binding SyncRepo}"
                                       Placeholder="owner/repo，如 my-username/my-shop"
                                       FontSize="{DynamicResource WSizeCaption}"
                                       BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                       PlaceholderColor="{DynamicResource MutedFg}" VerticalOptions="Center" />
                                <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                    <!-- 点击同步立即转圈反馈，完成后消失 -->
                                    <ActivityIndicator IsRunning="{Binding IsSyncing}"
                                                       IsVisible="{Binding IsSyncing}"
                                                       WidthRequest="18" HeightRequest="18"
                                                       Color="{DynamicResource PrimaryAction}"
                                                       VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="同步" Style="{StaticResource BtnNeumorphic}"
                                            HeightRequest="34" Padding="14,0" FontSize="{DynamicResource WSizeCaption}"
                                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBool}}"
                                            Command="{Binding SyncGitHubCommand}" />
                                </Grid>
                            </Grid>
                        </Border>
                        <VerticalStackLayout Spacing="0"
                                             IsVisible="{Binding SyncStatus, Converter={StaticResource StringNotEmpty}}">
                            <BoxView Style="{StaticResource HSep}" />
                            <Border Style="{StaticResource SettingRow}">
                                <Label Text="{Binding SyncStatus}" Style="{StaticResource TxtRowDesc}"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 搜索 -->
                <Border Style="{StaticResource CardGroup}">
                    <Border Style="{StaticResource SettingRow}">
                        <Entry Text="{Binding SearchText}" Placeholder="🔍 搜索商品…"
                               FontSize="{DynamicResource WSizeSmall}"
                               BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                               PlaceholderColor="{DynamicResource MutedFg}" VerticalOptions="Center" />
                    </Border>
                </Border>

                <!-- 分类横滑 -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8"
                                            BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShopCategoryTag">
                                <Border Style="{StaticResource TagChip}"
                                        BackgroundColor="{Binding IsSelected, Converter={StaticResource SelectedBg}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type vm:ShopViewModel}}}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Name}" Style="{StaticResource TxtCaption}"
                                           FontAttributes="{Binding IsSelected, Converter={StaticResource BoolFontBold}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- 提示消息 -->
                <Label Text="{Binding ResultMessage}"
                       Style="{StaticResource TxtMuted}"
                       TextColor="{DynamicResource AccentWarmFg}"
                       IsVisible="{Binding ResultMessage, Converter={StaticResource StringNotEmpty}}" />
            </VerticalStackLayout>

            <!-- 商品列表：一条商品是一行，整张列表装进一张卡（原来一件商品一张浮卡，
                 卡距比行内距还大，读起来是一摞牌子而不是一份清单）。
                 缩略图在行首，因此分界线用缩进版：线跨过图会把图读成「上一行的底」。 -->
            <Border Grid.Row="1" Style="{StaticResource CardGroup}">
                <CollectionView ItemsSource="{Binding Items}"
                                RemainingItemsThreshold="12"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                                SelectionMode="None"
                                VerticalScrollBarVisibility="Default">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="0">
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0" Background="{DynamicResource WWellBrush}"
                                                StrokeThickness="0"
                                                WidthRequest="50" HeightRequest="50"
                                                StrokeShape="{DynamicResource WRadiusWell}"
                                                VerticalOptions="Center">
                                            <Grid>
                                                <!-- 菜品图片（GitHub 同步下载到本地后显示；无图时 Emoji 兜底） -->
                                                <Image Source="{Binding ImagePath}" Aspect="AspectFill"
                                                       IsVisible="{Binding HasImage}" />
                                                <Label Text="{Binding Emoji}" FontSize="{DynamicResource WSizeSubhead}"
                                                       HorizontalOptions="Center" VerticalOptions="Center"
                                                       IsVisible="{Binding HasImage, Converter={StaticResource InverseBool}}" />
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource TxtRowTitle}" />
                                            <Label Text="{Binding Desc}"
                                                   Style="{StaticResource TxtRowDesc}"
                                                   LineBreakMode="WordWrap" MaxLines="2" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Category}"
                                                       Style="{StaticResource TxtMuted}" />
                                                <Label Text="{Binding Merchant, StringFormat='🏪 {0}'}"
                                                       Style="{StaticResource TxtMuted}"
                                                       TextColor="{DynamicResource AccentWarmFg}" />
                                                <Label Text="{Binding Owned, StringFormat='已购 {0} 件'}"
                                                       Style="{StaticResource TxtMuted}"
                                                       TextColor="{DynamicResource AccentWarmFg}"
                                                       IsVisible="{Binding Owned, Converter={StaticResource GreaterThanZero}}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding Price, StringFormat='{0} 币'}"
                                                   Style="{StaticResource TxtRowTitle}" HorizontalOptions="End" />
                                            <Button Text="{Binding IsTicket, Converter={StaticResource TicketLabel}}"
                                                    Style="{StaticResource BtnNeumorphic}"
                                                    HeightRequest="30" Padding="10,0" FontSize="{DynamicResource WSizeCaption}"
                                                    Command="{Binding Path=BindingContext.BuyCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                    CommandParameter="{Binding .}" />
                                            <!-- 送礼 / 使用（始终可见，无库存时点击有提示） -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                                <Button Grid.Column="0" Text="🎁送礼" Style="{StaticResource BtnNeumorphic}"
                                                        HeightRequest="26" Padding="4,0" FontSize="{DynamicResource WSizeCaption}"
                                                        Command="{Binding Path=BindingContext.GiftCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Grid.Column="1" Text="✨使用" Style="{StaticResource BtnNeumorphic}"
                                                        HeightRequest="26" Padding="4,0" FontSize="{DynamicResource WSizeCaption}"
                                                        Command="{Binding Path=BindingContext.UseCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                                <BoxView Style="{StaticResource HSepInset}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- 后台补货转圈（完整目录生成期间显示，列表仍可先浏览种子商品） -->
            <VerticalStackLayout Grid.Row="1" Spacing="6"
                                 IsVisible="{Binding IsSyncing}"
                                 VerticalOptions="Center" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsSyncing}"
                                   WidthRequest="28" HeightRequest="28"
                                   Color="{DynamicResource PrimaryAction}" />
                <Label Text="正在上架更多商品…"
                       Style="{StaticResource TxtMuted}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- 身体状态覆盖层（查看小雨身体/状态总览） -->
        <Grid Grid.RowSpan="3"
              BackgroundColor="{DynamicResource OverlayDim}"
              IsVisible="{Binding ShowBodyStatus}">
            <Border Style="{StaticResource CardDialog}"
                    WidthRequest="320" VerticalOptions="Center" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🫀 小雨的身体状态"
                           Style="{StaticResource TxtTitle}"
                           HorizontalOptions="Center" />
                    <Border Background="{DynamicResource WWellBrush}" StrokeThickness="0"
                            Padding="{DynamicResource WPadWell}"
                            StrokeShape="{DynamicResource WRadiusWell}">
                        <Label Text="{Binding BodyStatusText}"
                               Style="{StaticResource TxtBody}"
                               LineBreakMode="WordWrap" />
                    </Border>
                    <Button Text="关闭" Style="{StaticResource BtnNeumorphic}"
                            HeightRequest="36" FontSize="{DynamicResource WSizeBody}"
                            Command="{Binding CloseBodyStatusCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
