<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.SubProfilePage"
             Title="主设定 × 副设定"
             Background="{DynamicResource PageBgBrush}">

    <ScrollView Padding="{DynamicResource WPadCard}">
        <!-- 组与组之间只留一档「组距」，卡自己不再叠 Margin：
             原来一张卡套一个字段，卡间距比行内还大，读不出「这是同一件事的几条」。 -->
        <VerticalStackLayout Spacing="{DynamicResource WGapSection}" MaximumWidthRequest="860">

            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Title}" Style="{StaticResource TxtDisplay}" LineBreakMode="WordWrap" />
                <Label Text="左边是主设定（角色库规定，运行时不改）；右边是副设定（随经历漂移的当下之我）。"
                       Style="{StaticResource TxtRowDesc}" LineBreakMode="WordWrap" />
                <Label Text="{Binding DriftSummary}" Style="{StaticResource TxtBodySm}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <!-- 左右对比：两张分行卡并排，每栏一组行。左标题（+说明）、右取值/状态，垂直居中。 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource WGapSection}">
                <Border Grid.Column="0" Style="{StaticResource CardGroup}">
                    <VerticalStackLayout Spacing="0">
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="主设定（内核）" Style="{StaticResource TxtRowTitle}" />
                            </Grid>
                        </Border>
                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="性格" Style="{StaticResource TxtRowTitle}" />
                                    <Label Text="{Binding MainPersonality}" Style="{StaticResource TxtRowDesc}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="背景" Style="{StaticResource TxtRowTitle}" />
                                    <Label Text="{Binding MainDescription}" Style="{StaticResource TxtRowDesc}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardGroup}">
                    <VerticalStackLayout Spacing="0">
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="副设定（当下之我）" Style="{StaticResource TxtRowTitle}" />
                            </Grid>
                        </Border>
                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="性格" Style="{StaticResource TxtRowTitle}" />
                                    <Label Text="{Binding SubPersonality}" Style="{StaticResource TxtRowDesc}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <!-- 差异标记是一行的「值」，排在右、用信号墨：
                                     它说的是「这一条被经历动过」，正是要一眼扫到的那件事。 -->
                                <Label Grid.Column="1" Text="{Binding PersonalityDiffNote}"
                                       Style="{StaticResource TxtSignal}" HorizontalOptions="End"
                                       VerticalOptions="Center" HorizontalTextAlignment="End"
                                       LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>
                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="背景" Style="{StaticResource TxtRowTitle}" />
                                    <Label Text="{Binding SubDescription}" Style="{StaticResource TxtRowDesc}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding DescriptionDiffNote}"
                                       Style="{StaticResource TxtSignal}" HorizontalOptions="End"
                                       VerticalOptions="Center" HorizontalTextAlignment="End"
                                       LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>
                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="此刻心境" Style="{StaticResource TxtRowTitle}" />
                                <Label Grid.Column="1" Text="{Binding Tone}" Style="{StaticResource TxtBodySm}"
                                       HorizontalOptions="End" VerticalOptions="Center"
                                       HorizontalTextAlignment="End" LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- 心事：一组两行（正文 + 一句来源说明），不再是一整张带标题的浮档卡 -->
            <Border Style="{StaticResource CardGroup}">
                <VerticalStackLayout Spacing="0">
                    <Border Style="{StaticResource SettingRow}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="近期心事（TA 自己放在心上的事）"
                                   Style="{StaticResource TxtRowTitle}" />
                        </Grid>
                    </Border>
                    <BoxView Style="{StaticResource HSep}" />
                    <Border Style="{StaticResource SettingRow}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding NotesText}" Style="{StaticResource TxtBody}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="心事由每次折叠出的记忆要点累积而来，最多保留 8 条、留影 12 份。"
                                       Style="{StaticResource TxtRowDesc}" LineBreakMode="WordWrap"
                                       IsVisible="{Binding HasNotes}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- 漂移留影：一条留影 = 一张卡里的一行。标题也留在卡内，跟这张页其余几张对齐。 -->
            <Border Style="{StaticResource CardGroup}" IsVisible="{Binding HasHistory}">
                <VerticalStackLayout Spacing="0">
                    <Border Style="{StaticResource SettingRow}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="漂移留影（TA 是怎么一步步变成这样的）"
                                   Style="{StaticResource TxtRowTitle}" LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>
                    <BoxView Style="{StaticResource HSep}" />
                    <CollectionView ItemsSource="{Binding History}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SubProfileViewModel+DriftItem">
                                <VerticalStackLayout Spacing="0">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Reason}" Style="{StaticResource TxtRowTitle}"
                                                       LineBreakMode="WordWrap" />
                                                <Label Text="{Binding Tone}" Style="{StaticResource TxtRowDesc}"
                                                       LineBreakMode="WordWrap" />
                                                <Label Text="{Binding Notes}" Style="{StaticResource TxtRowDesc}"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <!-- 时间是这一行的「值」：排右、弱一档，扫列表时先读到原因 -->
                                            <Label Grid.Column="1" Text="{Binding Time}"
                                                   Style="{StaticResource TxtCaption}"
                                                   HorizontalOptions="End" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                    <BoxView Style="{StaticResource HSep}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="刷新" Style="{StaticResource BtnGhostSm}" Command="{Binding RefreshCommand}" />
                <!-- 回正会清空心境、心事与留影（点下去有确认框），所以它是危险档：
                     字用 DangerInk、缝用 RedSoft，不铺一块实心红。 -->
                <Button Text="副设定回正" Style="{StaticResource BtnDangerSm}" Command="{Binding ResetCommand}" />
            </HorizontalStackLayout>

            <Label Text="在设置里打开「让模型参与副设定改写」后，TA 会每 12 轮对话重新表述一次「自己现在的样子」（默认关闭，因为要花钱）。"
                   Style="{StaticResource TxtCaption}" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
