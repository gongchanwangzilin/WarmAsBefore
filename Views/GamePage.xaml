<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.GamePage"
             x:DataType="vm:GameViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- ========== Header ========== -->
        <!-- 顶栏与底部控制条用同一块 bar 面：玻璃档那圈描边在浅底上会被读成一条不属于地面的框 -->
        <Border Background="{DynamicResource WBarBrush}" StrokeThickness="0" Padding="8,6,12,6">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                <Button Text="&lt; 返回" Style="{StaticResource BtnText}"
                        FontSize="13" Padding="8,0"
                        Command="{Binding GoBackCommand}" />
                <Label Grid.Column="1" Text="{Binding GameTitle}"
                       Style="{StaticResource TxtSubhead}"
                       VerticalOptions="Center" />
                <Label Grid.Column="2" Text="小雨"
                       Style="{StaticResource TxtCaption}"
                       VerticalOptions="Center" />
                <!-- 热度块是一块饱和填充，字只能取最深那档墨（写死 White 在浅底世界会糊成一团） -->
                <Border Grid.Column="3"
                        BackgroundColor="{Binding Affection, Converter={StaticResource AffectionTint}}"
                        StrokeThickness="0"
                        WidthRequest="32" HeightRequest="20"
                        VerticalOptions="Center"
                        StrokeShape="{DynamicResource WRadiusWell}">
                    <Label Text="{Binding Affection, StringFormat='{0}'}"
                           TextColor="{DynamicResource WarmDark}" FontSize="{DynamicResource WSizeCaption}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ========== Board (left) + Chat (right) ========== -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Padding="0">

            <!-- Board Area -->
            <ScrollView Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center"
                        Padding="8,0,0,0">
                <VerticalStackLayout>
                    <Label Text="{Binding BoardDisplay}"
                           Style="{StaticResource TxtCaption}"
                           HorizontalOptions="Center" Margin="0,0,0,6" />
                    <GraphicsView x:Name="BoardView"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  StartInteraction="OnBoardTouched" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- Chat Area -->
            <Border Grid.Column="1" Style="{StaticResource CardFrost}"
                    Padding="8" Margin="0,8,8,8">
                <Grid RowDefinitions="*,Auto" RowSpacing="6">
                    <!-- 消息列表：CollectionView 虚拟化，新消息自动滚到底部 -->
                    <CollectionView x:Name="ChatList" Grid.Row="0"
                                    ItemsSource="{Binding Messages}"
                                    SelectionMode="None"
                                    VerticalScrollBarVisibility="Default">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatBubble">
                                <!-- 气泡：颜色归令牌（BubbleMine/BubbleTheirs 由风格世界算出来，换档时跟随），
                                     VM 只回答「这句是谁说的」。旧写法在 VM 里写死 hex，切世界后气泡还停在旧色。
                                     形状与内距也归令牌：角用井档、内距用 WPadWell，气泡和面板才不会各说各话。 -->
                                <Grid>
                                    <Border IsVisible="{Binding ShowBubbleMine}"
                                            BackgroundColor="{DynamicResource BubbleMine}"
                                            StrokeThickness="0"
                                            Padding="{DynamicResource WPadWell}"
                                            HorizontalOptions="End"
                                            MaximumWidthRequest="260"
                                            StrokeShape="{DynamicResource WRadiusWell}">
                                        <Label Text="{Binding Text}"
                                               Style="{StaticResource TxtBodySm}"
                                               TextColor="{DynamicResource SurfaceFg}"
                                               LineBreakMode="WordWrap" />
                                    </Border>
                                    <Border IsVisible="{Binding ShowBubbleTheirs}"
                                            BackgroundColor="{DynamicResource BubbleTheirs}"
                                            StrokeThickness="0"
                                            Padding="{DynamicResource WPadWell}"
                                            HorizontalOptions="Start"
                                            MaximumWidthRequest="260"
                                            StrokeShape="{DynamicResource WRadiusWell}">
                                        <Label Text="{Binding Text}"
                                               Style="{StaticResource TxtBodySm}"
                                               TextColor="{DynamicResource SurfaceFg}"
                                               LineBreakMode="WordWrap" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- 聊天输入框 -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6"
                          IsVisible="{Binding InGame}">
                        <!-- 输入框是「凹」的那一档：井底 + 上沿一道线。浮档（CardNeumorph）会给它一团落影，
                             读起来像一颗能按下去的按钮，而它其实是承接文字的地方。 -->
                        <Border Style="{StaticResource CardNeumorphInset}" Padding="10,0">
                            <Entry x:Name="ChatEntry"
                                   Text="{Binding ChatInput}"
                                   Placeholder="和小雨说点什么…"
                                   FontSize="{DynamicResource WSizeSmall}"
                                   BackgroundColor="Transparent"
                                   TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}"
                                   ReturnCommand="{Binding SendChatCommand}" />
                        </Border>
                        <Button Grid.Column="1" Text="发送" Style="{StaticResource BtnPrimary}"
                                HeightRequest="36" Padding="14,0" FontSize="12"
                                Command="{Binding SendChatCommand}" />
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <!-- ========== Control Bar ========== -->
        <Border Grid.Row="2"
                Background="{DynamicResource WBarBrush}"
                Padding="8,6,8,10"
                IsVisible="{Binding InGame}">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Button Text="嘲讽" Style="{StaticResource BtnNeumorphic}"
                            HeightRequest="34" Padding="14,0" FontSize="12"
                            Command="{Binding TauntCommand}" />
                    <!-- DangerTint 是淡色「面」，当文字色在浅底上几乎看不见；投降这种「说出来但别喊」的
                         动作要的是 DangerInk 那档墨。 -->
                    <Button Text="投降" Style="{StaticResource BtnText}"
                            TextColor="{DynamicResource DangerInk}"
                            HeightRequest="34" Padding="14,0" FontSize="12"
                            Command="{Binding ConcedeCommand}" />
                    <Button Text="朗读" Style="{StaticResource BtnNeumorphic}"
                            HeightRequest="34" Padding="14,0" FontSize="12"
                            Command="{Binding SpeakLastCommand}" />
                    <Button Text="语音" Style="{StaticResource BtnText}"
                            BackgroundColor="{DynamicResource Cream200}"
                            CornerRadius="{DynamicResource WRadiusButton}"
                            HeightRequest="34" WidthRequest="44" FontSize="11" Padding="0"
                            Command="{Binding VoiceInputCommand}"
                            IsEnabled="{Binding IsListening, Converter={StaticResource InverseBool}}" />
                </HorizontalStackLayout>

                <!-- 围棋：点目结算 -->
                <HorizontalStackLayout IsVisible="{Binding IsGo}"
                                       HorizontalOptions="Center" Spacing="8">
                    <Button Text="⚪ 点目结算" Style="{StaticResource BtnNeumorphic}"
                            HeightRequest="34" Padding="16,0" FontSize="12"
                            Command="{Binding SettleGoCommand}" />
                    <Border Background="{DynamicResource WWellBrush}"
                            StrokeThickness="0"
                            HeightRequest="34" Padding="10,0"
                            VerticalOptions="Center"
                            StrokeShape="{DynamicResource WRadiusWell}">
                        <Label Text="{Binding BoardDisplay}" Style="{StaticResource TxtCaption}"
                               VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>

                <!-- 飞行棋：掷骰子 -->
                <HorizontalStackLayout IsVisible="{Binding IsLudo}"
                                       HorizontalOptions="Center" Spacing="8">
                    <Button Text="🎲 掷骰子" Style="{StaticResource BtnNeumorphic}"
                            HeightRequest="34" Padding="16,0" FontSize="12"
                            Command="{Binding RollLudoCommand}" />
                    <Border Background="{DynamicResource WWellBrush}"
                            StrokeThickness="0"
                            HeightRequest="34" Padding="10,0"
                            VerticalOptions="Center"
                            StrokeShape="{DynamicResource WRadiusWell}">
                        <Label Text="{Binding BoardDisplay}" Style="{StaticResource TxtCaption}"
                               VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>

                <!-- 贪吃蛇：方向键 -->
                <Grid IsVisible="{Binding IsSnake}"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="6" HorizontalOptions="Center">
                    <Button Grid.Column="1" Text="↑" Style="{StaticResource BtnNeumorphic}"
                            HeightRequest="34" WidthRequest="40" FontSize="14" Padding="0"
                            Command="{Binding SnakeUpCommand}" />
                    <Button Grid.Column="3" Text="←" Style="{StaticResource BtnNeumorphic}"
                            HeightRequest="34" WidthRequest="40" FontSize="14" Padding="0"
                            Command="{Binding SnakeLeftCommand}" />
                    <Button Grid.Column="4" Text="→" Style="{StaticResource BtnNeumorphic}"
                            HeightRequest="34" WidthRequest="40" FontSize="14" Padding="0"
                            Command="{Binding SnakeRightCommand}" />
                    <Button Grid.Column="6" Text="↓" Style="{StaticResource BtnNeumorphic}"
                            HeightRequest="34" WidthRequest="40" FontSize="14" Padding="0"
                            Command="{Binding SnakeDownCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>