                                       PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                            <Grid ColumnDefinitions="110,*"><Label Text="API 密钥" VerticalOptions="Center" FontSize="13" />
                                <Entry Grid.Column="1" Text="{Binding VoiceApiKey}" IsPassword="True" Placeholder="sk-…"
