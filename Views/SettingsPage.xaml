                                <Label Text="服务类型" Style="{StaticResource TxtBodySm}" />
                                <Label Text="OpenAI 兼容走网络 API；GPT-SoVITS 可连本地或局域网服务" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                                <Picker Grid.Column="1" Title="服务类型" WidthRequest="150"
