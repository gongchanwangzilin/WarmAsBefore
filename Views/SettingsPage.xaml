                                       PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                            <Grid ColumnDefinitions="110,*"><Label Text="TTS 音色" VerticalOptions="Center" FontSize="13" />
                                <Entry Grid.Column="1" Text="{Binding VoiceName}" Placeholder="alloy / echo / nova / shimmer"
                                       BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                       PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                            <Grid ColumnDefinitions="110,*"><Label Text="STT 模型" VerticalOptions="Center" FontSize="13" />
                                <Entry Grid.Column="1" Text="{Binding VoiceSttModel}" Placeholder="whisper-1"
                                       BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                       PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                            <!-- GPT-SoVITS 扩展参数（仅服务类型选了 sovits 时显示） -->
                            <Grid ColumnDefinitions="110,*" IsVisible="{Binding VoiceModeDisplay, Converter={StaticResource IsSovitsMode}}">
                                <Label Text="说话人编号" VerticalOptions="Center" FontSize="13" />
                                <Entry Grid.Column="1" Text="{Binding VoiceExtra}" Placeholder="0=默认角色"
                                       BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                       PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" Keyboard="Numeric" /></Grid>
                            <Button Text="测试连接" Command="{Binding TestVoiceConnectionCommand}"
                                    BackgroundColor="{DynamicResource SurfaceBg}" TextColor="{DynamicResource MutedFg}"
                                    FontSize="12" Padding="12,0" HeightRequest="36" CornerRadius="10"
                                    HorizontalOptions="Start" WidthRequest="100" />
