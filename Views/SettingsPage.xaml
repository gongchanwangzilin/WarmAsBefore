<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:mcp="clr-namespace:WarmAsBefore.Modules.Mcp"
             xmlns:sbx="clr-namespace:WarmAsBefore.Modules.Sandbox"
             xmlns:services="clr-namespace:WarmAsBefore.Services"
             xmlns:i18n="clr-namespace:WarmAsBefore.Services"
             x:Class="WarmAsBefore.Views.SettingsPage"
             Title="{Binding [Settings_Title], Source={x:Static i18n:LocalizationService.Current}}"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

        <ContentPage.Resources>
        <!-- 24 张卡片按分类分成 4 组模板，逐组实例化：
             一次性建完实测要约 2.6 秒（页面会僵一下），分批做则页面约 0.5 秒即可用，
             其余内容在消息循环间隙陆续补齐。 -->
        <DataTemplate x:Key="SettingsCards1">
            <VerticalStackLayout Spacing="16">
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Volume}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_Volume], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="80,*">
                            <Label Text="{Binding [Settings_Bgm], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" />
                            <Slider Grid.Column="1" Value="{Binding BgmLevel}" Minimum="0" Maximum="1" />
                        </Grid>
                        <Grid ColumnDefinitions="80,*">
                            <Label Text="{Binding [Settings_Sfx], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" />
                            <Slider Grid.Column="1" Value="{Binding SfxLevel}" Minimum="0" Maximum="1" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardNeumorph}"
IsVisible="{Binding Filter.Glass}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_GlassFx], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtSubhead}" />
                        <!-- 性能：阴影是每个元素一个合成层，卡片多的页面（设置页有 24 张卡）会明显变慢 -->
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="轻量模式（关阴影，低配更流畅）" Style="{StaticResource TxtBodySm}" />
                            <Label Text="关闭后卡片不再有投影，观感朴素一些。阴影在 WinUI 上是每个元素一个合成层，卡片多或显卡弱时更划算；本机（独立显卡）实测差异在噪声范围内。" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding LightMode}" /></Grid>
                        <!-- 透明度 = 总闸：放最上面，0 即视为关闭玻璃 -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="玻璃透明度" Style="{StaticResource TxtBodySm}" />
                                <Label Text="0 = 表面不透明，等同于关闭玻璃；1 = 最通透" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding GlassTranslucency}"
                                    WidthRequest="120" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="玻璃已关闭（透明度为 0）：表面为不透明材质，下方选项不生效。"
                               IsVisible="{Binding GlassInactive}"
                               Style="{StaticResource TxtCaption}" TextColor="{DynamicResource AccentWarm}" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_Frost], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_FrostHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding FrostOn}" IsEnabled="{Binding GlassActive}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_Glass], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_GlassHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <!-- 不再 IsEnabled="{Binding CanGlass}"（CanGlass => FrostOn）：
                                 该开关在磨砂未开时是禁用的，点它当然没反应。
                                 而 OnGlassOnChanged 本就会自动带上磨砂，禁用纯属多余。 -->
                            <Switch Grid.Column="1" IsToggled="{Binding GlassOn}" IsEnabled="{Binding GlassActive}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="液态鼓起" Style="{StaticResource TxtBodySm}" />
                            <Label Text="最强的折射与浮起感；配合下方「液态高度」调节厚度" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding LiquidOn}" IsEnabled="{Binding GlassActive}" /></Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="磨砂程度" Style="{StaticResource TxtBodySm}" />
                                <Label Text="0 = 清玻璃 · 1 = 厚磨砂（奶白雾气浓度）" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding GlassFrost}"
                                    IsEnabled="{Binding GlassActive}" WidthRequest="120" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="液态高度" Style="{StaticResource TxtBodySm}" />
                                <Label Text="0 = 贴在页面上 · 1 = 明显浮起（投影深度 + 上沿高光）" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding GlassHeight}"
                                    IsEnabled="{Binding GlassActive}" WidthRequest="120" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="光源" Style="{StaticResource TxtSubhead}" />
                        <Label Text="决定高光落在哪条边、影子投往哪边；光越高越柔。"
                               Style="{StaticResource TxtCaption}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="光源 · 水平" Style="{StaticResource TxtBodySm}" />
                                <Label Text="-1 = 光从左边来 · 1 = 从右边来" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding GlassLightX}"
                                    IsEnabled="{Binding GlassActive}" WidthRequest="120" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="光源 · 垂直" Style="{StaticResource TxtBodySm}" />
                                <Label Text="-1 = 光从上方来 · 1 = 从下方来" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding GlassLightY}"
                                    IsEnabled="{Binding GlassActive}" WidthRequest="120" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="光源 · 高度" Style="{StaticResource TxtBodySm}" />
                                <Label Text="0 = 贴着表面（锐利）· 1 = 高高在上（柔和、影子散）" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding GlassLightZ}"
                                    IsEnabled="{Binding GlassActive}" WidthRequest="120" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="光宽" Style="{StaticResource TxtBodySm}" />
                                <Label Text="0 = 一道锐利反光 · 1 = 整片漫射" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding GlassLightWidth}"
                                    IsEnabled="{Binding GlassActive}" WidthRequest="120" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="减弱透明降级（无障碍）" Style="{StaticResource TxtBodySm}" />
                            <Label Text="开启后玻璃切不透明磨砂层，保证正文 4.5:1 对比" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding GlassReducedTransparency}" /></Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 背景：玻璃要有东西可透，否则再通透也看不出是玻璃 -->
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Background}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="背景（决定玻璃能透出什么）" Style="{StaticResource TxtSubhead}" />
                        <Label Text="半透明只是前提 —— 背后得有内容才看得见。纯色背景下无论怎么调，玻璃都像一块实心板。"
                               Style="{StaticResource TxtCaption}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="背景模式" Style="{StaticResource TxtBodySm}" />
                                <Label Text="窗口透视会让整个窗口背景透明，直接看穿到桌面"
                                       Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" WidthRequest="190" FontSize="13"
                                    ItemsSource="{Binding BackgroundModeChoices}"
                                    SelectedItem="{Binding BackgroundModeDisplay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding BackgroundImageVisible}">
                            <VerticalStackLayout>
                                <Label Text="背景图片" Style="{StaticResource TxtBodySm}" />
                                <Label Text="{Binding BackgroundImageLabel}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Button Grid.Column="1" Text="选择图片" Style="{StaticResource BtnGhost}"
                                    FontSize="13" Padding="14,6"
                                    Command="{Binding PickBackgroundImageCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 工具安全（沙箱信任名单） -->
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Sandbox}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="工具安全 · 沙箱信任名单" Style="{StaticResource TxtSubhead}" />
                        <Label Text="{Binding SandboxHint}" Style="{StaticResource TxtCaption}" />
                        <CollectionView ItemsSource="{Binding TrustedTools}" HeightRequest="100">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="sbx:TrustEntry">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding ToolName}" Style="{StaticResource TxtBodySm}" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="移除" Style="{StaticResource BtnText}"
                                                FontSize="12" Padding="8,2"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RemoveTrustedToolCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button Text="＋ 信任一个工具目录" Style="{StaticResource BtnGhost}" FontSize="13"
                                Command="{Binding TrustToolDirCommand}" />
                        <Label Text="默认外部工具无法读取模型数据（API Key / 对话历史）；加入信任后放行。"
                               Style="{StaticResource TxtCaption}" />
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderLine}" Margin="0,4" />
                        <Label Text="完整性检查" Style="{StaticResource TxtBodySm}" />
                        <Label Text="核对该有的工具是否齐全、描述与参数 schema 是否完整、聊天可用工具集能否正常构建。"
                               Style="{StaticResource TxtCaption}" />
                        <Button Text="🔍 检查工具完整性" Style="{StaticResource BtnGhost}" FontSize="13"
                                Command="{Binding VerifyToolsCommand}" />
                        <Label Text="{Binding ToolIntegrityText}" Style="{StaticResource TxtCaption}"
                               IsVisible="{Binding ToolIntegrityText, Converter={StaticResource IsNotNull}}"
                               TextColor="{Binding ToolIntegrityHealthy, Converter={StaticResource BoolGreenRed}}" />
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderLine}" Margin="0,4" />
                        <Label Text="表情包库" Style="{StaticResource TxtBodySm}" />
                        <Label Text="导入的表情可以在对话里发送；写上描述，AI 也能按场合挑表情发。"
                               Style="{StaticResource TxtCaption}" />
                        <Button Text="＋ 导入表情" Style="{StaticResource BtnGhost}" FontSize="13"
                                Command="{Binding ImportStickerCommand}" />
                        <Label Text="{Binding StickerStatus}" Style="{StaticResource TxtCaption}" />
                        <CollectionView ItemsSource="{Binding Stickers}" SelectionMode="None" MaximumHeightRequest="240">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:StickerRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Padding="0,4">
                                        <Image Source="{Binding Path}" Aspect="AspectFit" HeightRequest="40" WidthRequest="40" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource TxtBodySm}" />
                                            <Label Text="{Binding DescLabel}" Style="{StaticResource TxtCaption}"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="识别" Style="{StaticResource BtnText}" FontSize="12" Padding="8,2"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=AutoDescribeStickerCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="3" Text="描述" Style="{StaticResource BtnText}" FontSize="12" Padding="8,2"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=EditStickerDescCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="4" Text="删除" Style="{StaticResource BtnText}" FontSize="12" Padding="8,2"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RemoveStickerCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Interface}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_Interface], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_Theme], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_ThemeHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="{Binding [Settings_Theme], Source={x:Static i18n:LocalizationService.Current}}" WidthRequest="130"
                                    ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding ThemeDisplay}"
                                    FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_MenuRight], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_MenuRightHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding MenuRight}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_Language], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_LanguageHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="{Binding [Settings_Language], Source={x:Static i18n:LocalizationService.Current}}" WidthRequest="120"
                                    ItemsSource="{Binding Langs}" SelectedItem="{Binding LangDisplay}"
                                    FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_AutoSave], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_AutoSaveHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding AutoSave}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="多角色聊天显示" Style="{StaticResource TxtBodySm}" />
                            <Label Text="气泡式：消息直接成对话气泡流（适合多角色同场）；剧本式：底部对话面板 + 立绘" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="多角色聊天显示" WidthRequest="110"
                                    ItemsSource="{Binding ChatStyleChoices}" SelectedItem="{Binding ChatStyleDisplay}"
                                    FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="允许 AI 沉默" Style="{StaticResource TxtBodySm}" />
                            <Label Text="开启后角色可以选择不回复（什么都不输出），系统会自动停止该回合，而不是每次提问都强行给出答复" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding AllowSilence}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsMobile}"><VerticalStackLayout>
                            <Label Text="屏幕方向" Style="{StaticResource TxtBodySm}" />
                            <Label Text="移动端专用：自动=默认竖屏，手机/平板都竖屏；也可手动锁横屏（电脑版布局）或竖屏。切换后 3 秒内未确认会自动变回来再让你确认一次" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="屏幕方向" WidthRequest="130"
                                    ItemsSource="{Binding ScreenOrientationChoices}"
                                    SelectedItem="{Binding ScreenOrientationDisplay}"
                                    FontSize="13" /></Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 小游戏 AI 难度 -->
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Minigame}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="小游戏 AI 聪明度" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="AI 难度" Style="{StaticResource TxtBodySm}" />
                                <Label Text="简单=随机放水，普通=贪吃，困难=前瞻防反" Style="{StaticResource TxtCaption}" />
                            </VerticalStackLayout>
                            <Picker Grid.Column="1" Title="AI 难度" WidthRequest="130" FontSize="12"
                                    ItemsSource="{Binding GameDifficultyChoices}"
                                    SelectedItem="{Binding GameDifficultyDisplay}"
                                    IsEnabled="{Binding AiAutoDifficulty, Converter={StaticResource InverseBool}}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="AI 自动调节" Style="{StaticResource TxtBodySm}" />
                                <Label Text="由 AI 按你的对局表现智能升降难度" Style="{StaticResource TxtCaption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding AiAutoDifficulty}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 云端棋力脑 -->
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="SettingsCards2">
            <VerticalStackLayout Spacing="16">
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Chess}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="云端棋力脑（可选）" Style="{StaticResource TxtSubhead}" />
                        <Label Text="默认使用内置本地棋力，不依赖网络。填写 OpenAI 兼容下棋 API 后可让 AI 更强。" Style="{StaticResource TxtCaption}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="启用云端棋力" Style="{StaticResource TxtBodySm}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ChessApiEnabled}" />
                        </Grid>
                        <Grid ColumnDefinitions="80,*">
                            <Label Text="API 地址" Style="{StaticResource TxtBodySm}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding ChessApiUrl}" Placeholder="https://api.openai.com/v1/chat/completions"
                                   FontSize="12" />
                        </Grid>
                        <Grid ColumnDefinitions="80,*">
                            <Label Text="API Key" Style="{StaticResource TxtBodySm}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding ChessApiKey}" Placeholder="sk-…" IsPassword="True" FontSize="12" />
                        </Grid>
                        <Grid ColumnDefinitions="80,*">
                            <Label Text="模型" Style="{StaticResource TxtBodySm}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding ChessApiModel}" Placeholder="gpt-4o-mini" FontSize="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.TextSfx}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_TextSfx], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="80,*"><Label Text="{Binding [Settings_TextSpeed], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" />
                            <Slider Grid.Column="1" Value="{Binding TextSpeed}" Minimum="0.5" Maximum="2" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_KeySfx], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_KeySfxHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="{Binding [Settings_KeySfx], Source={x:Static i18n:LocalizationService.Current}}" WidthRequest="120"
                                    ItemsSource="{Binding KeySfxChoices}" SelectedItem="{Binding KeySfx}"
                                    FontSize="13" /></Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardNeumorph}"
IsVisible="{Binding Filter.Ai}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_AiTitle], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtSubhead}" />
                        <!-- #13 API 预设：选服务自动填端点 -->
                        <Grid ColumnDefinitions="110,*"><Label Text="API 预设" VerticalOptions="Center" FontSize="13" />
                            <Picker Grid.Column="1" Title="选一个服务" ItemsSource="{Binding AiPresetChoices}"
                                    SelectedItem="{Binding AiPreset}" FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_AiUrl], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding AiUrl}" Placeholder="https://api.openai.com/v1/chat/completions"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_AiKey], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding AiKey}" IsPassword="True" Placeholder="sk-…"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="110,*,Auto" VerticalOptions="Center">
                            <Label Text="{Binding [Settings_AiModel], Source={x:Static i18n:LocalizationService.Current}}" FontSize="13" />
                            <Picker Grid.Column="1" ItemsSource="{Binding AiModelChoices}"
                                    SelectedItem="{Binding AiModel}"
                                    FontSize="13" HeightRequest="36"
                                    IsEnabled="{Binding IsLoadingModels, Converter={StaticResource InverseBool}}" />
                            <Button Grid.Column="2" Text="检测"
                                    BackgroundColor="{DynamicResource SurfaceBg}" TextColor="{DynamicResource MutedFg}"
                                    FontSize="11" Padding="10,0" HeightRequest="36" CornerRadius="10"
                                    Command="{Binding FetchModelsCommand}"
                                    IsEnabled="{Binding IsLoadingModels, Converter={StaticResource InverseBool}}" />
                        </Grid>
                        <Label Text="{Binding ModelListStatus}" Style="{StaticResource TxtCaption}"
                               TextColor="{DynamicResource MutedFg}" FontSize="11"
                               IsVisible="{Binding ModelListStatus, Converter={StaticResource StringNotEmpty}}" />
                        <Grid ColumnDefinitions="80,*"><Label Text="{Binding [Settings_Temperature], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" />
                            <Slider Grid.Column="1" Value="{Binding AiTemperature}" Minimum="0" Maximum="1" /></Grid>
                        <Grid ColumnDefinitions="80,*"><Label Text="{Binding [Settings_MaxToken], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" />
                            <Slider Grid.Column="1" Value="{Binding AiMaxTokens}" Minimum="100" Maximum="2000" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_DeepThink], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_DeepThinkHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding DeepThink}" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_DeepModel], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding DeepModel}" Placeholder="{Binding [Settings_DeepModelPlaceholder], Source={x:Static i18n:LocalizationService.Current}}"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <!-- #13 识图模型：独立配置，可用于表情包自动描述等看图任务 -->
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderLine}" Margin="0,4" />
                        <Label Text="识图模型（可选）" Style="{StaticResource TxtBodySm}" />
                        <Label Text="独立配置一个支持看图的模型；配好后「表情包库」里可以一键让 AI 写描述。"
                               Style="{StaticResource TxtCaption}" />
                        <Grid ColumnDefinitions="110,*"><Label Text="识图端点" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding VisionUrl}" Placeholder="https://…/v1/chat/completions"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="识图 Key" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding VisionKey}" IsPassword="True" Placeholder="sk-…"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="识图模型" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding VisionModel}" Placeholder="gpt-4o-mini / qwen-vl-plus / glm-4v …"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <!-- 多端点轮换（供应商 × AI × 密钥）：保存多条端点，密钥/端点轮流用，保证对话不间断 -->
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderLine}" Margin="0,4" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="多端点轮换（供应商 / AI / 密钥）" Style="{StaticResource TxtBodySm}" />
                            <Label Text="保存多条端点（一条 = 供应商 + 某款 AI + 多枚密钥）。开启后密钥与端点自动轮流使用；某条失灵就换下一条，保证对话不间断。"
                                   Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding AiRotationEnabled}" /></Grid>
                        <!-- 请求超时：慢模型/长思考端点可在每条端点里单独覆写 -->
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="请求超时（秒）" Style="{StaticResource TxtBodySm}" />
                            <Label Text="全局默认；某条端点需要更久时，在下面那条端点的「超时」里单独填" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" WidthRequest="90" ItemsSource="{Binding TimeoutChoices}"
                                    SelectedItem="{Binding AiTimeoutSeconds}" FontSize="13" /></Grid>
                        <!-- 厂商列表：一家厂商 = 端点 + 密钥 + 多款模型。
                             同一家厂商加模型不必重复填端点密钥（用户反馈：原来是按「一条 = 厂商+模型+密钥」重复填）。 -->
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding AiProviders}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AiProviderRow">
                                    <Border BackgroundColor="{DynamicResource SurfaceBg}" Stroke="{DynamicResource BorderLine}"
                                            StrokeThickness="0.8" Padding="10,8" Margin="0,4">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                                    <Button Text="↑" Style="{StaticResource BtnText}" FontSize="12" Padding="6,0"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=MoveProviderUpCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    <Button Text="↓" Style="{StaticResource BtnText}" FontSize="12" Padding="6,0"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=MoveProviderDownCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                    <Label Text="{Binding Title}" Style="{StaticResource TxtBodySm}" FontAttributes="Bold"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Url}" Style="{StaticResource TxtCaption}" FontSize="10"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Summary}" Style="{StaticResource TxtCaption}" FontSize="10" />
                                                </VerticalStackLayout>
                                                <Switch Grid.Column="2" IsToggled="{Binding Enabled}" VerticalOptions="Center" />
                                                <Button Grid.Column="3" Text="删除" Style="{StaticResource BtnText}" FontSize="12" Padding="8,2"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RemoveProviderCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>

                                            <!-- 这家厂商的模型：点名字启停，✕ 删掉 -->
                                            <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Models}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AiModelRow">
                                                        <Border StrokeThickness="1" Padding="6,2"
                                                                Stroke="{DynamicResource BorderLine}"
                                                                BackgroundColor="{Binding Enabled, Converter={StaticResource SelectedBg}}">
                                                            <Border.StrokeShape><RoundRectangle CornerRadius="9" /></Border.StrokeShape>
                                                            <HorizontalStackLayout Spacing="4">
                                                                <Label Text="{Binding DisplayName}" FontSize="11"
                                                                       TextColor="{DynamicResource SurfaceFg}" VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=ToggleModelCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                                <Button Text="✕" Style="{StaticResource BtnText}" FontSize="10" Padding="2,0"
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RemoveModelFromProviderCommand}"
                                                                        CommandParameter="{Binding .}" />
                                                            </HorizontalStackLayout>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="8">
                                                <Button Text="＋模型" Style="{StaticResource BtnText}" FontSize="11" Padding="6,2"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=AddModelToProviderCommand}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Text="名称/端点" Style="{StaticResource BtnText}" FontSize="11" Padding="6,2"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=EditProviderBasicsCommand}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Text="密钥" Style="{StaticResource BtnText}" FontSize="11" Padding="6,2"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=EditProviderKeysCommand}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Text="超时" Style="{StaticResource BtnText}" FontSize="11" Padding="6,2"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=EditProviderTimeoutCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{Binding AiProviderStatus}" Style="{StaticResource TxtCaption}" />

                        <!-- 新增厂商：端点与密钥只填一次，模型可以往里继续加 -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry Grid.Column="0" Text="{Binding NewProviderName}" Placeholder="厂商名（如：硅基流动）"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding NewProviderModel}" Placeholder="首款模型（如：deepseek-chat）"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" />
                        </Grid>
                        <Entry Text="{Binding NewProviderUrl}" Placeholder="端点（https://…/v1/chat/completions）"
                               BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                               PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" Text="{Binding NewProviderKeys}" Placeholder="密钥（一行一枚，多枚轮流用）"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding NewProviderTimeout}" Placeholder="超时秒" WidthRequest="80"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="＋添加厂商" Style="{StaticResource BtnGhost}" FontSize="13"
                                    Command="{Binding AddProviderCommand}" />
                            <Button Grid.Column="1" Text="用当前配置预填" Style="{StaticResource BtnGhost}" FontSize="13"
                                    Command="{Binding FillProviderFromCurrentCommand}" />
                        </Grid>

                        <!-- 花费与省钱：真实用量 + 单价 → 两张表、两个排行榜、一张图 -->
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderLine}" Margin="0,4" />
                        <Label Text="花费与省钱" Style="{StaticResource TxtBodySm}" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="智能省钱" Style="{StaticResource TxtBodySm}" />
                            <Label Text="开启后折叠历史前先预测「现在总结 / 不总结」哪个更省，并识别编程办公场景改用轻总结；关闭则恢复「到上限就总结」。" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding SmartSavingEnabled}" /></Grid>
                        <Label Text="{Binding CostSummary}" Style="{StaticResource TxtBodySm}" />
                        <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="6">
                            <Entry Grid.Column="0" Text="{Binding NewPriceModel}" Placeholder="模型名"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="12" />
                            <Entry Grid.Column="1" Text="{Binding NewPriceInput}" Placeholder="输入价/百万"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="12" />
                            <Entry Grid.Column="2" Text="{Binding NewPriceOutput}" Placeholder="输出价/百万"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="12" />
                            <Button Grid.Column="3" Text="保存单价" Style="{StaticResource BtnText}" FontSize="12" Padding="8,2"
                                    Command="{Binding AddModelPriceCommand}" />
                        </Grid>
                        <Label Text="单价可以只填一侧（另一侧按 0 计），不必每个模型都填。" Style="{StaticResource TxtCaption}" />
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Button Text="刷新用量 / 花费" Style="{StaticResource BtnGhost}" FontSize="12"
                                    Command="{Binding RefreshCostCommand}" />
                            <Button Text="按当前上限试算" Style="{StaticResource BtnGhost}" FontSize="12"
                                    Command="{Binding TryAdviceCommand}" />
                        </HorizontalStackLayout>

                        <!-- 条形图 / 折线图：自绘，跟着主题色走 -->
                        <Border BackgroundColor="{DynamicResource InputBg}" Stroke="{DynamicResource BorderLine}"
                                StrokeThickness="1" Padding="6" HeightRequest="190">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <GraphicsView x:Name="CostChartView" HeightRequest="178" />
                        </Border>
                        <Label Text="{Binding CostChartCaption}" Style="{StaticResource TxtCaption}" />
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Button Text="{Binding CostChartModeLabel}" Style="{StaticResource BtnGhost}" FontSize="12"
                                    Command="{Binding ToggleChartModeCommand}" />
                            <Button Text="导出 CSV" Style="{StaticResource BtnGhost}" FontSize="12"
                                    Command="{Binding ExportCostCsvCommand}" />
                        </HorizontalStackLayout>

                        <!-- 钱与 token 分成两张表 + 两个排行榜（用户反馈：混在一张表里看不清） -->
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderLine}" Margin="0,2" />
                        <Label Text="价钱表（每百万 token）" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" />
                        <Label Text="{Binding PriceTable}" FontSize="11" FontFamily="Consolas"
                               TextColor="{DynamicResource MutedFg}" LineBreakMode="NoWrap" />
                        <Label Text="token 表" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" Margin="0,6,0,0" />
                        <Label Text="{Binding TokenTable}" FontSize="11" FontFamily="Consolas"
                               TextColor="{DynamicResource MutedFg}" LineBreakMode="NoWrap" />
                        <Label Text="花钱排行榜" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" Margin="0,6,0,0" />
                        <Label Text="{Binding CostRanking}" FontSize="11" FontFamily="Consolas"
                               TextColor="{DynamicResource MutedFg}" />
                        <Label Text="token 排行榜" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" Margin="0,6,0,0" />
                        <Label Text="{Binding TokenRanking}" FontSize="11" FontFamily="Consolas"
                               TextColor="{DynamicResource MutedFg}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 记忆与对话：检索、折叠、回想窗口、副设定与关系网（原来混在 AI 卡片里，分类不清晰） -->
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Memory}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="记忆与对话" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_MemoryTurns], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_MemoryTurnsHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="{Binding [Settings_TurnsTitle], Source={x:Static i18n:LocalizationService.Current}}" WidthRequest="110"
                                    ItemsSource="{Binding MemoryTurnsChoices}" SelectedItem="{Binding MemoryTurns}"
                                    FontSize="13" /></Grid>
                        <!-- 上下文 Token 上限：达到后强制把旧对话总结成第一人称记忆（不是机械压缩） -->
                        <Grid ColumnDefinitions="110,*"><Label Text="上下文上限" VerticalOptions="Center" FontSize="13" />
                            <Picker Grid.Column="1" Title="超过后强制总结" ItemsSource="{Binding ContextLimitChoices}"
                                    SelectedItem="{Binding ContextTokenLimitDisplay}" FontSize="13" /></Grid>
                        <Label Text="对话历史估算超过该 Token 数时，会像人回忆一样把旧对话总结成第一人称记忆；平时不动历史。"
                               Style="{StaticResource TxtCaption}" />
                        <!-- 人类记忆层：回想窗口与随机度（可按角色在角色库里覆写） -->
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="记忆回想窗口" Style="{StaticResource TxtBodySm}" />
                            <Label Text="默认只想起三天内的事为主，越久越模糊但不彻底消失；选「不限」能想起最早的记忆。" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="天数" WidthRequest="110"
                                    ItemsSource="{Binding MemoryWindowChoices}" SelectedItem="{Binding MemoryWindowDays}"
                                    FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="回忆的随机度" Style="{StaticResource TxtBodySm}" />
                            <Label Text="越大越像人：会跳着想、偶尔想不起来。0 = 严格按时间与重要性排序。" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Slider Grid.Column="1" WidthRequest="140" Minimum="0" Maximum="1"
                                    Value="{Binding MemoryRecallRandomness}" /></Grid>
                        <Label Text="需要个别角色记性好/记性差时，在角色库 →「参数覆写」里单独设置这两个值。"
                               Style="{StaticResource TxtCaption}" />
                        <!-- 副设定：由模型参与改写（默认关闭，因为要花钱） -->
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="让模型参与副设定改写" Style="{StaticResource TxtBodySm}" />
                            <Label Text="开启后每 12 轮对话，让模型重新表述一次「她现在的样子」（性格与处境）；主设定不动、随时可回正。默认关闭以免额外花钱。"
                                   Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding SubProfileAiRewrite}" /></Grid>
                        <!-- 词义关系网：模型辅助增边（默认关闭） -->
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="让模型辅助建立词义关系网" Style="{StaticResource TxtBodySm}" />
                            <Label Text="关联网默认只靠共现统计自动长（不花钱）；打开后每 20 轮让模型补 3 条关联，标为 AI 来源，人工纠错仍优先。"
                                   Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding SemanticAiAssist}" /></Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Notify}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_Voice], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_Tts], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_TtsHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding TtsEnabled}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="朗读引擎" Style="{StaticResource TxtBodySm}" />
                            <Label Text="system=系统自带语音，api=外部 TTS API" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="朗读引擎" WidthRequest="100"
                                    ItemsSource="{Binding VoiceEngineChoices}" SelectedItem="{Binding TtsEngine}"
                                    FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_Stt], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_SttHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding SttEnabled}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="识别引擎" Style="{StaticResource TxtBodySm}" />
                            <Label Text="system=系统自带，local=本地下载模型，api=外部 STT API" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="识别引擎" WidthRequest="100"
                                    ItemsSource="{Binding VoiceEngineChoices}" SelectedItem="{Binding SttEngine}"
                                    FontSize="13" /></Grid>
                        <!-- 本地识别模型：识别引擎选 local 时显示 -->
                        <VerticalStackLayout Spacing="10" IsVisible="{Binding SttEngine, Converter={StaticResource SttEngineIsLocal}}">
                            <Label Text="本地识别模型" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" />
                            <Picker Title="本地模型" ItemsSource="{Binding SttModelChoices}"
                                    SelectedItem="{Binding SttModelDisplay}" FontSize="13" />
                            <Label Text="{Binding SttModelStatus}" Style="{StaticResource TxtCaption}"
                                   TextColor="{DynamicResource MutedFg}" FontSize="11" />
                            <ProgressBar Progress="{Binding SttModelProgress}"
                                         IsVisible="{Binding IsDownloadingSttModel}"
                                         HeightRequest="4" />
                            <Grid ColumnDefinitions="*,*">
                                <Button Text="下载模型" Command="{Binding DownloadSttModelCommand}"
                                        BackgroundColor="{DynamicResource SurfaceBg}" TextColor="{DynamicResource MutedFg}"
                                        FontSize="12" Padding="12,0" HeightRequest="36" CornerRadius="10"
                                        IsEnabled="{Binding IsDownloadingSttModel, Converter={StaticResource InverseBool}}" />
                                <Button Grid.Column="1" Text="删除模型" Command="{Binding DeleteSttModelCommand}"
                                        BackgroundColor="{DynamicResource SurfaceBg}" TextColor="{DynamicResource MutedFg}"
                                        FontSize="12" Padding="12,0" HeightRequest="36" CornerRadius="10"
                                        Margin="8,0,0,0"
                                        IsEnabled="{Binding IsDownloadingSttModel, Converter={StaticResource InverseBool}}" />
                            </Grid>
                            <Label Text="local=离线识别（需先下载模型）；api=外部服务（电脑端录音 8 秒后识别）"
                                   Style="{StaticResource TxtCaption}" TextColor="{DynamicResource MutedFg}" FontSize="11" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="80,*"><Label Text="{Binding [Settings_TtsRate], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" />
                            <Slider Grid.Column="1" Value="{Binding TtsRate}" Minimum="0.5" Maximum="2" /></Grid>

                        <!-- 试听当前音色：输入文本，按当前设置（系统 TTS 或外部 API）合成并播放，双端可用 -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="试听当前音色" Style="{StaticResource TxtBodySm}" />
                            <Entry Text="{Binding PreviewVoiceText}" Placeholder="输入一段话试听，如：你好，我是温暖如初。"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="按当前设置合成试听：系统引擎走系统语音；API 引擎走外部服务"
                                       Style="{StaticResource TxtCaption}" TextColor="{DynamicResource MutedFg}" FontSize="11" />
                                <Button Grid.Column="1" Text="试听" Command="{Binding PreviewVoiceCommand}"
                                        BackgroundColor="{DynamicResource SurfaceBg}" TextColor="{DynamicResource MutedFg}"
                                        FontSize="12" Padding="14,0" HeightRequest="36" CornerRadius="10"
                                        WidthRequest="70" />
                            </Grid>
                            <Label Text="{Binding TestVoiceStatus}" Style="{StaticResource TxtCaption}"
                                   TextColor="{DynamicResource MutedFg}" FontSize="11"
                                   IsVisible="{Binding TestVoiceStatus, Converter={StaticResource StringNotEmpty}}" />
                        </VerticalStackLayout>

                        <!-- API 语音配置（朗读或识别选了 api 时显示） -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding NeedsVoiceApi}">
                            <Label Text="API 语音配置" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" Margin="0,6,0,0" />
