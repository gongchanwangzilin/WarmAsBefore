                                   TextColor="{DynamicResource MutedFg}" FontSize="11"
                                   IsVisible="{Binding TestVoiceStatus, Converter={StaticResource StringNotEmpty}}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Weather}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_NotifyTitle], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_Notify], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_NotifyHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_Greeting], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_GreetingHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding GreetingEnabled}" /></Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="SettingsCards3">
            <VerticalStackLayout Spacing="16">
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Desktop}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_WeatherLife], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_City], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding WeatherCity}" Placeholder="{Binding [Settings_CityPlaceholder], Source={x:Static i18n:LocalizationService.Current}}"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_Cycle], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_CycleHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="{Binding [Settings_Cycle], Source={x:Static i18n:LocalizationService.Current}}" WidthRequest="110"
                                    ItemsSource="{Binding CycleChoices}" SelectedItem="{Binding CycleLength}"
                                    FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_Period], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_PeriodHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="{Binding [Settings_Period], Source={x:Static i18n:LocalizationService.Current}}" WidthRequest="110"
                                    ItemsSource="{Binding PeriodChoices}" SelectedItem="{Binding PeriodLength}"
                                    FontSize="13" /></Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Official}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_Desktop], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_AlwaysOnTop], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_AlwaysOnTopHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding AlwaysOnTop}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="桌宠闲置时长" Style="{StaticResource TxtBodySm}" />
                            <Label Text="0 关闭；闲置满时长自动进入桌宠，重新操作时自动恢复" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="桌宠闲置时长" WidthRequest="110"
                                    ItemsSource="{Binding PetIdleChoices}" SelectedItem="{Binding PetIdleMinutes}"
                                    FontSize="13" /></Grid>
                        <!-- #E3 桌宠思考 -->
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="桌宠思考" Style="{StaticResource TxtBodySm}" />
                            <Label Text="关闭=不主动嘀咕；随机=按间隔掷骰子（约一半概率）；定时=按间隔必想一次。桌宠模式下单击立绘总能触发一次" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="桌宠思考" WidthRequest="110"
                                    ItemsSource="{Binding PetThinkModeChoices}" SelectedItem="{Binding PetThinkModeDisplay}"
                                    FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="思考间隔" Style="{StaticResource TxtBodySm}" />
                            <Label Text="随机 / 定时模式下每隔多久想一次（分钟）" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" Title="思考间隔" WidthRequest="110"
                                    ItemsSource="{Binding PetThinkIntervalChoices}" SelectedItem="{Binding PetThinkIntervalMinutes}"
                                    FontSize="13" /></Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Mcp}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_Official], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtSubhead}" />
                        <Label Text="{Binding [Settings_OfficialHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" />

                        <Label Text="{Binding [Settings_QqTitle], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" Margin="0,6,0,0" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_QqEnable], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_QqHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding QqBotEnabled}" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_AppId], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding QqAppId}" Placeholder="{Binding [Settings_BotAppId], Source={x:Static i18n:LocalizationService.Current}}"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_AppSecret], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding QqAppSecret}" IsPassword="True" Placeholder="{Binding [Settings_BotAppSecret], Source={x:Static i18n:LocalizationService.Current}}"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <!-- #16：QQ 机器人绑定陪聊角色（相当于选一个存档；不选则跟随当前角色） -->
                        <Grid ColumnDefinitions="110,*"><Label Text="陪聊角色" VerticalOptions="Center" FontSize="13" />
                            <Picker Grid.Column="1" Title="选一个角色（存档）" ItemsSource="{Binding QqBoundChoices}"
                                    SelectedItem="{Binding QqBoundCharacter}" FontSize="13" /></Grid>
                        <Label Text="接入 QQ 机器人前先选好用它陪聊的角色；没选则跟随当前游戏角色。" Style="{StaticResource TxtCaption}" />

                        <!-- 群聊与「用户本人」识别 -->
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="回复群聊消息" Style="{StaticResource TxtBodySm}" />
                            <Label Text="默认不理群里的消息（免得在群里刷屏）；打开后只回应 @ 到机器人的消息" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding QqReplyGroup}" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="我的 QQ openid" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding QqUserOpenId}" Placeholder="留空则认最近跟你私聊过的人"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="我的称呼" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding QqUserName}" Placeholder="角色这样称呼你（如：小林）"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <Label Text="填了 openid 就能认出「哪个是你」；之后角色可以主动给你手机发消息。" Style="{StaticResource TxtCaption}" />

                        <!-- 主动外发（角色拿起手机发消息） -->
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="允许角色主动发消息到我手机" Style="{StaticResource TxtBodySm}" />
                            <Label Text="存档里她「拿起手机发个消息」，就真的发到你的 QQ。默认关闭" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding QqProactiveEnabled}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="发送前需要我确认" Style="{StaticResource TxtBodySm}" />
                            <Label Text="开启后每条外发消息都先排队，主界面点「发出去」才真的发送（AI 不能未经同意往外发）" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding QqProactiveRequireConfirm}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="每小时上限" Style="{StaticResource TxtBodySm}" />
                            <Label Text="防止误触或被刷屏；超出后 AI 会被告知「先别打扰对方」" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" WidthRequest="90" ItemsSource="{Binding QqProactiveRateChoices}"
                                    SelectedItem="{Binding QqProactivePerHour}" FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="走哪个通道" Style="{StaticResource TxtBodySm}" />
                            <Label Text="QQ 与微信的身份是两套 openid；自动 = 谁在线且认识你就走谁" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Picker Grid.Column="1" WidthRequest="110" ItemsSource="{Binding OutboundChannelChoices}"
                                    SelectedItem="{Binding OutboundChannelDisplay}" FontSize="13" /></Grid>

                        <Label Text="{Binding [Settings_WechatTitle], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" Margin="0,10,0,0" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_WechatEnable], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_WechatHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding WechatEnabled}" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_AppId], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding WechatAppId}" Placeholder="{Binding [Settings_MpAppId], Source={x:Static i18n:LocalizationService.Current}}"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_AppSecret], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding WechatAppSecret}" IsPassword="True" Placeholder="{Binding [Settings_MpAppSecret], Source={x:Static i18n:LocalizationService.Current}}"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_Token], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding WechatToken}" Placeholder="{Binding [Settings_TokenPlaceholder], Source={x:Static i18n:LocalizationService.Current}}"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_Port], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding WechatPort}" Placeholder="{Binding [Settings_PortPlaceholder], Source={x:Static i18n:LocalizationService.Current}}" Keyboard="Numeric"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <VerticalStackLayout>
                                <Label Text="{Binding [Settings_ConnStatus], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                                <Label Text="{Binding StatusText}" Style="{StaticResource TxtCaption}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="{Binding [Settings_TestConn], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding TestConnectionCommand}" />
                        </Grid>
                        <Label Text="{Binding [Settings_OfficialNote], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" Opacity="0.75" />
                    </VerticalStackLayout>
                </Border>

                <!-- MCP 配置 -->
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Runtime}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_Mcp], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_McpEnable], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_McpHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding McpEnabled}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="自动确认" Style="{StaticResource TxtBodySm}" />
                            <Label Text="开启后脚本/AI 调用 MCP 工具无需逐次人工确认" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding McpAutoApprove}" /></Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource BorderLine}" Opacity="0.4" />

                        <!-- 已接入服务器列表 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="已接入服务器" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="＋ 新建" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding NewMcpServerCommand}" />
                        </Grid>
                        <!-- 用 BindableLayout 而不是 CollectionView：CollectionView 嵌在页面 ScrollView 里
                             时两边抢滚动手势，内层列表常常滚不动（用户实测反馈）。列表跟着页面一起滚最稳。 -->
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding McpServers}"
                                             IsVisible="{Binding McpServersLoading, Converter={StaticResource InverseBool}}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="mcp:McpServerItem">
                                    <Border BackgroundColor="{DynamicResource SurfaceBg}" Stroke="{DynamicResource BorderLine}"
                                            StrokeThickness="0.8" Padding="10,8" Margin="0,4">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer>
                                                <TapGestureRecognizer.Command>
                                                    <Binding Source="{RelativeSource AncestorType={x:Type vm:SettingsViewModel}}" Path="ShowMcpServerDetailsCommand" />
                                                </TapGestureRecognizer.Command>
                                                <TapGestureRecognizer.CommandParameter>
                                                    <Binding Path="." />
                                                </TapGestureRecognizer.CommandParameter>
                                            </TapGestureRecognizer>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" />
                                                <Label Text="{Binding Description}" Style="{StaticResource TxtCaption}"
                                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                                <Label Text="{Binding SizeLine}" Style="{StaticResource TxtCaption}"
                                                       FontSize="10" Opacity="0.7" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="简介/属性" Style="{StaticResource BtnText}" FontSize="11"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=ShowMcpServerDetailsCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="还没有接入的服务器。点「＋ 新建」登记一个，或用下方功能导入数据包"
                               Style="{StaticResource TxtCaption}" Padding="4,6"
                               IsVisible="{Binding McpServersLoading, Converter={StaticResource InverseBool}}" />
                        <VerticalStackLayout IsVisible="{Binding McpServersLoading}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                            <ActivityIndicator IsRunning="{Binding McpServersLoading}" IsVisible="{Binding McpServersLoading}" HeightRequest="32" WidthRequest="32" Color="{DynamicResource AccentWarm}" />
                            <Label Text="正在加载已接入服务器…" Style="{StaticResource TxtCaption}" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_McpUrl], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding McpNetworkUrl}" Placeholder="{Binding [Settings_McpUrlPlaceholder], Source={x:Static i18n:LocalizationService.Current}}"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>

                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_GitHub], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding McpGitHubRepo}" Placeholder="{Binding [Settings_GitHubPlaceholder], Source={x:Static i18n:LocalizationService.Current}}"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                        <Button Text="{Binding [Settings_ImportGithub], Source={x:Static i18n:LocalizationService.Current}}" Command="{Binding ImportMcpFromGitHubCommand}"
                                Style="{StaticResource BtnNeumorphSm}" />

                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_ZipImport], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding McpImportZipPath}" Placeholder="{Binding [Settings_ZipPlaceholder], Source={x:Static i18n:LocalizationService.Current}}"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" IsEnabled="False" /></Grid>
                        <Button Text="{Binding [Settings_ImportZip], Source={x:Static i18n:LocalizationService.Current}}" Command="{Binding ImportMcpZipCommand}"
                                Style="{StaticResource BtnNeumorphSm}" />

                        <Grid ColumnDefinitions="110,*"><Label Text="{Binding [Settings_FolderImport], Source={x:Static i18n:LocalizationService.Current}}" VerticalOptions="Center" FontSize="13" />
                            <Entry Grid.Column="1" Text="{Binding McpImportFolderPath}" Placeholder="{Binding [Settings_FolderPlaceholder], Source={x:Static i18n:LocalizationService.Current}}"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" IsEnabled="False" /></Grid>
                        <Button Text="{Binding [Settings_ImportFolder], Source={x:Static i18n:LocalizationService.Current}}" Command="{Binding ImportMcpFolderCommand}"
                                Style="{StaticResource BtnNeumorphSm}"
                                IsVisible="{OnIdiom Phone=False, Desktop=True, Tablet=False}" />
                        <ProgressBar Progress="{Binding ImportProgress}" IsVisible="{Binding IsImporting}" />
                        <Label Text="{Binding ImportStatus}" Style="{StaticResource TxtCaption}"
                               IsVisible="{Binding IsImporting}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 工具模式运行时（Java / Python） -->
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Data}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="工具模式运行时（Java / Python）" Style="{StaticResource TxtSubhead}" />
                        <Label Text="外部工具使用统一的 JSON-RPC 协议，由 Java / Python 解释器执行。策略：先检测本机 → 手动指定路径 → 必要时自动下载便携运行时。"
                               Style="{StaticResource TxtCaption}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Python" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" />
                                <Label Text="{Binding PythonStatus}" Style="{StaticResource TxtCaption}" FontSize="11"
                                       IsVisible="{Binding RuntimeOsSupported}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="检测" Style="{StaticResource BtnNeumorphSm}"
                                    IsEnabled="{Binding IsRuntimeBusy, Converter={StaticResource InverseBool}}"
                                    Command="{Binding DetectRuntimesCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Java" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" />
                                <Label Text="{Binding JavaStatus}" Style="{StaticResource TxtCaption}" FontSize="11"
                                       IsVisible="{Binding RuntimeOsSupported}" />
                                <Label Text="外部工具仅桌面端可用" Style="{StaticResource TxtCaption}" FontSize="11"
                                       IsVisible="{Binding RuntimeOsSupported, Converter={StaticResource InverseBool}}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="检测" Style="{StaticResource BtnNeumorphSm}"
                                    IsEnabled="{Binding IsRuntimeBusy, Converter={StaticResource InverseBool}}"
                                    Command="{Binding DetectRuntimesCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                              IsVisible="{Binding RuntimeOsSupported}">
                            <Button Text="⬇️ 下载 Python 便携版" Style="{StaticResource BtnNeumorphSm}" FontSize="11"
                                    IsEnabled="{Binding IsRuntimeBusy, Converter={StaticResource InverseBool}}"
                                    Command="{Binding DownloadPythonCommand}" />
                            <Button Grid.Column="1" Text="⬇️ 下载 Java 便携版" Style="{StaticResource BtnNeumorphSm}" FontSize="11"
                                    IsEnabled="{Binding IsRuntimeBusy, Converter={StaticResource InverseBool}}"
                                    Command="{Binding DownloadJavaCommand}" />
                        </Grid>

                        <!-- Android Linux 沙箱（proot）安装向导 -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding SandboxAvailable}">
                            <Label Text="手机插件沙箱（Linux proot，无需 root）"
                                   Style="{StaticResource TxtBodySm}" FontAttributes="Bold" />
                            <Label Text="在 App 内运行 Linux 用户态沙箱，把 Python / Java 解释器装进沙箱，宿主投射 tools 目录，复用 JSON-RPC 工具协议。约 80MB，仅首次安装。"
                                   Style="{StaticResource TxtCaption}" FontSize="11" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Button Text="📦 安装沙箱运行时（Python + Java，约 80MB）" Style="{StaticResource BtnNeumorphSm}" FontSize="11"
                                        IsEnabled="{Binding IsRuntimeBusy, Converter={StaticResource InverseBool}}"
                                        Command="{Binding InstallSandboxRuntimeCommand}" />
                                <Button Grid.Column="1" Text="卸载" Style="{StaticResource BtnText}" FontSize="11"
                                        IsEnabled="{Binding IsRuntimeBusy, Converter={StaticResource InverseBool}}"
                                        Command="{Binding RemoveSandboxRuntimeCommand}" />
                            </Grid>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{DynamicResource BorderLine}" Opacity="0.4" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding RuntimeOsSupported}">
                            <Label Text="{Binding PythonManualPath, StringFormat='Python 路径：{0}'}" Style="{StaticResource TxtCaption}" FontSize="11"
                                   VerticalOptions="Center" LineBreakMode="TailTruncation" />
                            <Button Grid.Column="1" Text="设置路径" Style="{StaticResource BtnText}" FontSize="11"
                                    Command="{Binding SetPythonPathCommand}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding RuntimeOsSupported}">
                            <Label Text="{Binding JavaManualPath, StringFormat='Java 路径：{0}'}" Style="{StaticResource TxtCaption}" FontSize="11"
                                   VerticalOptions="Center" LineBreakMode="TailTruncation" />
                            <Button Grid.Column="1" Text="设置路径" Style="{StaticResource BtnText}" FontSize="11"
                                    Command="{Binding SetJavaPathCommand}" />
                        </Grid>

                        <ActivityIndicator IsRunning="{Binding IsRuntimeBusy}" IsVisible="{Binding IsRuntimeBusy}"
                                           HorizontalOptions="Center" Color="{DynamicResource AccentWarm}" />
                        <Label Text="{Binding RuntimeBusyText}" Style="{StaticResource TxtCaption}"
                               IsVisible="{Binding RuntimeBusyText, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 数据管理 -->
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Update}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="数据管理" Style="{StaticResource TxtSubhead}" />
                        <Label Text="导出 / 导入整个应用数据（立绘、存档、角色、背景等）。
默认不含 API 密钥与机器人密钥，可在下方勾选。"
                               Style="{StaticResource TxtCaption}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Text="导出数据包" Style="{StaticResource BtnPrimary}" FontSize="13"
                                    Padding="14,6" Command="{Binding ExportDataCommand}"
                                    IsEnabled="{Binding IsDataBusy, Converter={StaticResource InverseBool}}" />
                            <Button Grid.Column="1" Text="导入数据包" Style="{StaticResource BtnGhost}" FontSize="13"
                                    Padding="14,6" Command="{Binding ImportDataCommand}"
                                    IsEnabled="{Binding IsDataBusy, Converter={StaticResource InverseBool}}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="包含 API 密钥与机器人密钥" Style="{StaticResource TxtCaption}" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding IncludeSecrets}" VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar IsVisible="{Binding ExportStatus, Converter={StaticResource StringNotEmpty}}"
                                     Progress="{Binding ExportProgress}" HeightRequest="4" />
                        <Label Text="{Binding ExportStatus}" Style="{StaticResource TxtCaption}"
                               IsVisible="{Binding ExportStatus, Converter={StaticResource StringNotEmpty}}"
                               LineBreakMode="WordWrap" />
                        <ProgressBar IsVisible="{Binding DataImportStatus, Converter={StaticResource StringNotEmpty}}"
                                     Progress="{Binding DataImportProgress}" HeightRequest="4" />
                        <Label Text="{Binding DataImportStatus}" Style="{StaticResource TxtCaption}"
                               IsVisible="{Binding DataImportStatus, Converter={StaticResource StringNotEmpty}}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="SettingsCards4">
            <VerticalStackLayout Spacing="16">
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Experimental}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="自动更新" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="测试计划（Beta 渠道）" Style="{StaticResource TxtBodySm}" />
                            <Label Text="开启后 *-beta 测试版 tag 也会提示更新" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding BetaChannel}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Text="检查更新" Style="{StaticResource BtnPrimary}" FontSize="13"
                                    Padding="14,6" Command="{Binding CheckUpdateCommand}"
                                    IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBool}}" />
                            <Button Grid.Column="1" Text="下载" Style="{StaticResource BtnGhost}" FontSize="13"
                                    Padding="14,6" Command="{Binding DownloadUpdateCommand}"
                                    IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBool}}" />
                        </Grid>
                        <Label Text="{Binding UpdateStatus}" Style="{StaticResource TxtCaption}"
                               LineBreakMode="WordWrap" IsVisible="{Binding UpdateStatus, Converter={StaticResource StringNotEmpty}}" />
                        <Label Text="{Binding LatestUpdateVersion, StringFormat='发现版本：{0}'}" Style="{StaticResource TxtCaption}"
                               IsVisible="{Binding LatestUpdateVersion, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Materials}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_Experimental], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_ComplexPlot], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_ComplexPlotHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding ComplexPlot}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="{Binding [Settings_NovelTesting], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" />
                            <Label Text="{Binding [Settings_NovelTestingHint], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding NovelTesting}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding [Settings_ShowAffection], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtBodySm}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ShowAffection}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="好感等级提升动画" Style="{StaticResource TxtBodySm}" />
                            <Label Text="每累计 500 好感积分升 1 级（共10级），跨越等级时全屏播放爱心动画" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding AffectionLevelUp}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="启用战斗系统" Style="{StaticResource TxtBodySm}" />
                            <Label Text="关闭后战斗功能整体停用：AI 无法发起战斗，战斗相关工具不再提供给 AI" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding BattleEnabled}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="允许 AI 主动发起战斗" Style="{StaticResource TxtBodySm}" />
                            <Label Text="关闭后只有你手动进入战斗页才能开战，AI 不能把局面强行拖入战斗" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding BattleAiCanStart}" IsEnabled="{Binding BattleEnabled}" /></Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderLine}" Margin="0,4" />
                        <Label Text="天气事件（打雷 / 下雨）" Style="{StaticResource TxtBodySm}" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="启用打雷事件" Style="{StaticResource TxtBodySm}" />
                            <Label Text="雨天/极阴天随机打雷：屏幕白一下再慢慢恢复，可配雷声与帧动画" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding LightningEnabled}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="打雷概率（基准，0-1）" Style="{StaticResource TxtBodySm}" />
                            <Label Text="打雷天自动×4，雨天为基准值，极阴天×0.3。数值越大越容易打雷" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Entry Grid.Column="1" Text="{Binding LightningProbability}" Keyboard="Numeric" WidthRequest="72" IsEnabled="{Binding LightningEnabled}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="启用下雨事件" Style="{StaticResource TxtBodySm}" />
                            <Label Text="天气为雨天时随机触发雨声/雨视觉" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding RainEventEnabled}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="下雨概率（0-1）" Style="{StaticResource TxtBodySm}" /></VerticalStackLayout>
                            <Entry Grid.Column="1" Text="{Binding RainProbability}" Keyboard="Numeric" WidthRequest="72" IsEnabled="{Binding RainEventEnabled}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="雷声文件路径" Style="{StaticResource TxtBodySm}" /></VerticalStackLayout>
                            <Entry Grid.Column="1" Text="{Binding LightningSfxPath}" WidthRequest="180" IsEnabled="{Binding LightningEnabled}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="雨声文件路径" Style="{StaticResource TxtBodySm}" /></VerticalStackLayout>
                            <Entry Grid.Column="1" Text="{Binding RainSfxPath}" WidthRequest="180" IsEnabled="{Binding RainEventEnabled}" /></Grid>
                        <VerticalStackLayout>
                            <Label Text="打雷帧图（每行一个路径，可留空）" Style="{StaticResource TxtBodySm}" />
                            <Label Text="按次序切换；只有一张则闪一下；留空则默认白一下再慢慢恢复" Style="{StaticResource TxtCaption}" />
                            <Editor Text="{Binding LightningFramesText}" HeightRequest="64" IsEnabled="{Binding LightningEnabled}" AutoSize="Disabled" /></VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="下雨帧图（每行一个路径，可留空）" Style="{StaticResource TxtBodySm}" />
                            <Label Text="循环切换；留空则不显示雨视觉（只有雨声）" Style="{StaticResource TxtCaption}" />
                            <Editor Text="{Binding RainFramesText}" HeightRequest="64" IsEnabled="{Binding RainEventEnabled}" AutoSize="Disabled" /></VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="特效帧切换间隔（毫秒）" Style="{StaticResource TxtBodySm}" />
                            <Label Text="打雷白闪时长 / 帧图切换频率，建议 80-300" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Entry Grid.Column="1" Text="{Binding WeatherEffectFrameMs}" Keyboard="Numeric" WidthRequest="72" /></Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderLine}" Margin="0,4" />
                        <Label Text="行进扩展（AI 出行 / 跟随）" Style="{StaticResource TxtBodySm}" />
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="AI 可单独出行（不带我）" Style="{StaticResource TxtBodySm}" />
                            <Label Text="开启后 AI 发【移动:】只移动 AI 自己，我的视角留在原地；关闭则维持旧行为（AI 走到哪我跟到哪）" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding AiTravelAlone}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout>
                            <Label Text="允许我「跟上」" Style="{StaticResource TxtBodySm}" />
                            <Label Text="AI 单独走远后，主界面出现「跟上」按钮；点一下即可跟过去" Style="{StaticResource TxtCaption}" /></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding AllowFollowAi}" IsEnabled="{Binding AiTravelAlone}" /></Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding [Settings_AutoSaveNote], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtMuted}"
                       HorizontalOptions="Center" FontSize="12" Margin="0,6,0,0" />

                <!-- 素材库 -->
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Skills}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="素材库（背景 · 音乐）" Style="{StaticResource TxtSubhead}" HorizontalOptions="Center" />
                        <Label Text="导入 / 管理背景图与音乐，并把音乐设为左键音、右键音、按键音或背景音轮播"
                               Style="{StaticResource TxtCaption}" HorizontalOptions="Center" />
                        <Button Text="🎨 进入素材库" Style="{StaticResource BtnNeumorphSm}"
                                HeightRequest="44" Command="{Binding OpenMaterialsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 能力包（Skills） -->
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Sponsor}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="能力包（Skills）" Style="{StaticResource TxtSubhead}" HorizontalOptions="Center" />
                        <Label Text="{Binding SkillsSummary}" Style="{StaticResource TxtCaption}" HorizontalOptions="Center" />
                        <Label Text="一个能力包 = 一个目录，可含 SKILL.md（写给 AI 的说明书，按需加载）和 tool.json（可执行入口，复用 Python/Java 运行时）。装上后 AI 会先读说明书再动手。"
                               Style="{StaticResource TxtCaption}" HorizontalOptions="Center" />
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Button Text="导入 zip / 目录" Style="{StaticResource BtnNeumorphSm}"
                                    HeightRequest="40" Command="{Binding ImportSkillCommand}" />
                            <Button Text="管理" Style="{StaticResource BtnNeumorphSm}"
                                    HeightRequest="40" Command="{Binding ManageSkillsCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 赞助作者 -->
                <Border Style="{StaticResource CardNeumorph}"
                        IsVisible="{Binding Filter.Developer}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="支持作者 ❤️" Style="{StaticResource TxtSubhead}" HorizontalOptions="Center" />
                        <Label Text="如果您喜欢这个项目，欢迎赞助作者支持 continued development" Style="{StaticResource TxtCaption}" HorizontalOptions="Center" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Text="☕ 爱发电赞助" BackgroundColor="{DynamicResource AccentWarm}" TextColor="{DynamicResource AccentWarmFg}"
                                    FontSize="13" HeightRequest="44" CornerRadius="12"
                                    Command="{Binding OpenSponsorCommand}" />
                            <Button Grid.Column="1" Text="📺 B站主页" BackgroundColor="{DynamicResource SurfaceBg}" TextColor="{DynamicResource SurfaceFg}"
                                    BorderColor="{DynamicResource BorderLine}" BorderWidth="1"
                                    FontSize="13" HeightRequest="44" CornerRadius="12"
                                    Command="{Binding OpenBilibiliCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 开发者展示模式（隐藏入口：滚到设置最底部后连续点按 114514 次解锁，无输入框） -->
                <Border Style="{StaticResource CardNeumorph}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="开发者展示模式" Style="{StaticResource TxtSubhead}" HorizontalOptions="Center" />
                        <Label Text="隐藏模式：为创作者提供的展示案编辑 / 播放功能（含多立绘支持）"
                               Style="{StaticResource TxtCaption}" HorizontalOptions="Center" />

                        <Label Text="已解锁：可编辑 / 播放展示案"
                               Style="{StaticResource TxtCaption}" HorizontalOptions="Center"
                               TextColor="{DynamicResource AccentWarm}"
                               IsVisible="{Binding ShowcaseUnlocked}" />
                        <Button Text="🎬 开发者展示（编辑 / 播放）" Style="{StaticResource BtnNeumorphSm}"
                                BackgroundColor="{DynamicResource AccentWarm}" TextColor="{DynamicResource AccentWarmFg}"
                                FontAttributes="Bold"
                                IsVisible="{Binding ShowcaseUnlocked}"
                                Command="{Binding OpenShowcaseCommand}" />

                        <Label Text="滚到设置最底部后，连续点按“连击解锁”按钮 114514 次可开启"
                               Style="{StaticResource TxtCaption}" HorizontalOptions="Center"
                               IsVisible="{Binding ShowcaseUnlocked, Converter={StaticResource InverseBool}}" />
                        <Button Text="🔒 连击解锁"
                                Style="{StaticResource BtnNeumorphSm}"
                                IsVisible="{Binding ShowcaseUnlocked, Converter={StaticResource InverseBool}}"
                                Command="{Binding SecretTapCommand}" />
                        <Label Text="{Binding SecretTapCount, StringFormat='已点按 {0} 次'}"
                               Style="{StaticResource TxtCaption}" HorizontalOptions="Center"
                               IsVisible="{Binding ShowcaseUnlocked, Converter={StaticResource InverseBool}}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="↩ 返回" Style="{StaticResource BtnNeumorphSm}" HorizontalOptions="Center"
                        WidthRequest="180" Command="{Binding GoBackCommand}" />

                <Label Text="{Binding [Settings_AutoSaveNote], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtMuted}"
                       HorizontalOptions="Center" FontSize="12" Margin="0,6,0,0" />

            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

<Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Header -->
        <Border Background="{DynamicResource GlassBarBg}" Stroke="{DynamicResource GlassBarStroke}" Padding="16,12,16,12"
                StrokeThickness="{DynamicResource GlassBarStrokeThickness}">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="{Binding [Common_Back], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource BtnText}"
                        FontSize="14" Padding="0"
                        Command="{Binding GoBackCommand}" />
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="titlelogo.png" WidthRequest="30" HeightRequest="30" Aspect="AspectFill"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding [Settings_Title], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtTitle}"
                           VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- 页面级 loading 遮罩：盖在内容行（*）上，首帧渲染前隐藏内容避免布局未就绪的卡顿观感。
             独占 Grid.Row=1 的 * 行（高度稳定，不随内容变化），避免 Auto 行反复 Measure。 -->
        <Border Grid.Row="1" BackgroundColor="{DynamicResource PageBg}" IsVisible="{Binding PageLoading}"
                HorizontalOptions="Fill" VerticalOptions="Fill">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding PageLoading}" IsVisible="{Binding PageLoading}"
                                   HeightRequest="40" WidthRequest="40" Color="{DynamicResource AccentWarm}" />
                <Label Text="正在加载设置…" Style="{StaticResource TxtCaption}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" Padding="24,16,24,24" Scrolled="OnScrollViewScrolled">
                    <!-- 宽度由代码按窗口自适应（x:Name 见 code-behind）：原来固定 640，
                         宽屏上左右留一大片空白，卡片看着又窄又短。 -->
                    <VerticalStackLayout x:Name="SettingsBody" Spacing="16" MaximumWidthRequest="640"
                                 HorizontalOptions="Center">
                <!-- 设置搜索：设置项太多、找不到是常态，按关键词把不相关的分类收起 -->
                <Border Style="{StaticResource CardNeumorph}" Padding="12,10">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" Text="{Binding SettingsSearchText}" Placeholder="搜设置（如：记忆 / 模型 / 语音 / 群聊）"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" ClearButtonVisibility="WhileEditing" />
                            <Button Grid.Column="1" Text="清空" Style="{StaticResource BtnText}" FontSize="12"
                                    Command="{Binding ClearSettingsSearchCommand}" />
                        </Grid>
                        <Label Text="{Binding Filter.MatchCount, StringFormat='找到 {0} 个相关分类'}" Style="{StaticResource TxtCaption}"
                               IsVisible="{Binding Filter.IsSearching}" />
                        <Label Text="{Binding Filter.EmptyHint}" Style="{StaticResource TxtCaption}"
                               TextColor="{DynamicResource AccentWarm}" />
                    </VerticalStackLayout>
                </Border>
                <!-- 卡片宿主：分组模板在首帧后逐组建到这里（见 SettingsPage.xaml.cs） -->
                <VerticalStackLayout x:Name="CardsHost" Spacing="16" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
