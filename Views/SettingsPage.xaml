                                       PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" /></Grid>
                            <Grid ColumnDefinitions="110,*"><Label Text="TTS 模型" VerticalOptions="Center" FontSize="13" />
                                <Entry Grid.Column="1" Text="{Binding VoiceTtsModel}" Placeholder="tts-1"
