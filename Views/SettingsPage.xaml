<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:i18n="clr-namespace:WarmAsBefore.Services"
             x:Class="WarmAsBefore.Views.SettingsPage"
             Title="{Binding [Settings_Title], Source={x:Static i18n:LocalizationService.Current}}"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Header -->
        <Border Background="{DynamicResource GlassBarBg}" Stroke="{DynamicResource GlassBarStroke}" Padding="16,12,16,12"
                StrokeThickness="{DynamicResource GlassBarStrokeThickness}">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="{Binding [Common_Back], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource BtnText}"
                        FontSize="14" Padding="0"
                        Command="{Binding GoBackCommand}" />
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="titlelogo.png" WidthRequest="30" HeightRequest="30" Aspect="AspectFill"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding [Settings_Title], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtTitle}"
                           VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="24,16,24,24">
            <VerticalStackLayout x:Name="SettingsBody" HorizontalOptions="Fill" Spacing="14"
                                 >

                <!-- 搜索：设置项多，先搜再点比一页页翻快 -->
                <Border Style="{StaticResource CardNeumorph}" Padding="12,10">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" Text="{Binding SettingsSearchText}" Placeholder="搜设置（如：记忆 / 模型 / 语音 / 群聊）"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" ClearButtonVisibility="WhileEditing" />
                            <Button Grid.Column="1" Text="清空" Style="{StaticResource BtnText}" FontSize="12"
                                    Command="{Binding ClearSettingsSearchCommand}" />
                        </Grid>
                        <Label Text="{Binding Filter.MatchCount, StringFormat='匹配到 {0} 个设置项（进子页后只显示这些）'}" Style="{StaticResource TxtCaption}"
                               IsVisible="{Binding Filter.IsSearching}" />
                        <Label Text="{Binding Filter.EmptyHint}" Style="{StaticResource TxtCaption}"
                               TextColor="{DynamicResource AccentWarmFg}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="选择一个分类进入" Style="{StaticResource TxtCaption}" Margin="2,0,0,0" />

                <!-- 分类条目：每行 = 图标 + 名称 + 当前值摘要，点一下进子页 -->
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding SectionRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsViewModel+SettingsSectionRow">
                            <Border Style="{StaticResource CardNeumorph}" Padding="16,12"
                                    IsVisible="{Binding Visible}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" />
                                        <Label Text="{Binding Summary}" Style="{StaticResource TxtCaption}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="›" FontSize="22" VerticalOptions="Center"
                                           TextColor="{DynamicResource MutedFg}" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=OpenSectionCommand}"
                                        CommandParameter="{Binding Key}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
