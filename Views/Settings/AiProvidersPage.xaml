<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.AiProvidersPage"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">
    <Grid RowDefinitions="Auto,*" Padding="18,10,18,14" RowSpacing="10">

        <!-- 顶栏 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Button Grid.Column="0" Text="←" Style="{StaticResource BtnText}" Padding="10,2"
                    Clicked="OnBack" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="AI 厂商管理" FontSize="18" FontAttributes="Bold"
                       TextColor="{DynamicResource SurfaceFg}" />
                <Label Text="一家厂商 = 一个端点 + 一组密钥 + 多款模型；顺序即优先级，失灵自动换下一家。"
                       Style="{StaticResource TxtCaption}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="模型管理 →" Style="{StaticResource BtnGhost}"
                    Padding="10,4" Clicked="OnOpenModels" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10">

                <!-- 厂商列表 -->
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Providers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AiProviderRow">
                            <Border BackgroundColor="{DynamicResource SurfaceBg}"
                                    Stroke="{DynamicResource WSepBrush}" StrokeThickness="0.8"
                                    Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{DynamicResource SurfaceFg}" />
                                            <Label Text="{Binding Url}" Style="{StaticResource TxtCaption}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Summary}" Style="{StaticResource TxtCaption}" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1" IsToggled="{Binding Enabled}"
                                                Toggled="OnProviderToggled" VerticalOptions="Center" />
                                    </Grid>
                                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start">
                                        <Button Text="名称/端点" Style="{StaticResource BtnText}" Margin="0,0,8,0"
                                                Clicked="OnEditBasics" />
                                        <Button Text="密钥" Style="{StaticResource BtnText}" Margin="0,0,8,0"
                                                Clicked="OnEditKeys" />
                                        <Button Text="超时" Style="{StaticResource BtnText}" Margin="0,0,8,0"
                                                Clicked="OnEditTimeout" />
                                        <Button Text="上移" Style="{StaticResource BtnText}" Margin="0,0,8,0"
                                                Clicked="OnMoveUp" />
                                        <Button Text="下移" Style="{StaticResource BtnText}" Margin="0,0,8,0"
                                                Clicked="OnMoveDown" />
                                        <Button Text="删除" Style="{StaticResource BtnText}"
                                                Clicked="OnDeleteProvider" />
                                    </FlexLayout>
                                    <Label Text="{Binding ModelsHint}" Style="{StaticResource TxtCaption}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- 新增 -->
                <Border BackgroundColor="{DynamicResource SurfaceBg}"
                        Stroke="{DynamicResource WSepBrush}" StrokeThickness="0.8" Padding="12,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="新增厂商" Style="{StaticResource TxtBodySm}" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry Grid.Column="0" x:Name="NewName" Placeholder="厂商名（如：硅基流动）"
                                   BackgroundColor="{DynamicResource InputBg}"
                                   TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" />
                            <Entry Grid.Column="1" x:Name="NewModel" Placeholder="首款模型（如：deepseek-chat）"
                                   BackgroundColor="{DynamicResource InputBg}"
                                   TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" />
                        </Grid>
                        <Entry x:Name="NewUrl" Placeholder="端点（https://…/v1/chat/completions）"
                               BackgroundColor="{DynamicResource InputBg}"
                               TextColor="{DynamicResource SurfaceFg}"
                               PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" />
                        <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                            <Entry Grid.Column="0" x:Name="NewKeys" Placeholder="密钥（一行一枚，可多枚轮流用）"
                                   BackgroundColor="{DynamicResource InputBg}"
                                   TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" />
                            <Entry Grid.Column="1" x:Name="NewTimeout" Placeholder="超时秒" Keyboard="Numeric"
                                   BackgroundColor="{DynamicResource InputBg}"
                                   TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" />
                        </Grid>
                        <Button Text="＋ 添加厂商" Style="{StaticResource BtnGhost}" Clicked="OnAddProvider" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="StatusLabel" Style="{StaticResource TxtCaption}" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
