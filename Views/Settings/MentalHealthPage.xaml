<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.MentalHealthPage"
             x:Name="Page"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,*">
        <Border Background="{DynamicResource GlassBarBg}" Stroke="{DynamicResource GlassBarStroke}"
                StrokeThickness="{DynamicResource GlassBarStrokeThickness}" Padding="16,12">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource WSpaceLoose}">
                <Button Text="&lt; 返回" Style="{StaticResource BtnText}" Padding="0"
                        Command="{Binding BackCommand}" />
                <Label Grid.Column="1" Text="心理状况" Style="{StaticResource TxtTitle}" VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="24,16,24,28">
            <VerticalStackLayout Spacing="{DynamicResource WSpaceLoose}" MaximumWidthRequest="900" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="{DynamicResource WSpaceTight}">
                    <Label MaxLines="1" LineBreakMode="TailTruncation" Text="{Binding CharacterLabel, StringFormat='{0} · 心理状况'}" Style="{StaticResource TxtTitle}" />
                    <Label Text="这不是诊断，也不会把病名写进对话：只决定 TA 怎么感受、怎么应对。安慰与陪伴会提高稳定度；时间几乎不起作用。涉及自伤、自杀、伤人的条目有硬边界——可以写痛苦与冲动，不写方法、不美化，始终引向现实求助。"
                           Style="{StaticResource TxtCaption}" LineBreakMode="WordWrap" />
                    <Label MaxLines="1" LineBreakMode="TailTruncation" Text="{Binding Status}" Style="{StaticResource TxtCaption}"
                           TextColor="{DynamicResource AccentWarmFg}" />
                </VerticalStackLayout>

                <!-- 安全感：与好感同刻度的独立数值，事件驱动；小模型只在两个时机介入 -->
                <Border Style="{StaticResource CardSolid}">
                    <VerticalStackLayout Spacing="{DynamicResource WSpaceRegular}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="安全感" Style="{StaticResource TxtSubhead}" MaxLines="1" LineBreakMode="TailTruncation" />
                            <Label MaxLines="1" LineBreakMode="TailTruncation" Text="{Binding SecurityText}" Style="{StaticResource TxtCaption}"
                                   TextColor="{DynamicResource AccentWarmFg}" />
                        </VerticalStackLayout>
                        <Label Text="被安慰、被倾听会往上走；被忽视、被拒绝触碰、看到你对别人亲密、被辱骂会往下掉；独处过久缓慢下降，一直有人陪缓慢回升。每类事件各有冷却与每日上限，连刷不会连涨。"
                               Style="{StaticResource TxtCaption}" LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource WSpaceRegular}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="小模型整理" Style="{StaticResource TxtBody}" MaxLines="1" LineBreakMode="TailTruncation" />
                                <Label Text="只在「一串事件归纳成一段经历」和「连续同向漂移的复核」时调用，它给的数值一律经系统夹取。关掉就只剩系统规则。模型沿用大脑预判里配的小模型。"
                                       Style="{StaticResource TxtCaption}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding SecurityAiEnabled}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 当前生效的状况 -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Active}" Spacing="{DynamicResource WSpaceRegular}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardSolid}">
                                <VerticalStackLayout Spacing="{DynamicResource WSpaceRegular}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}" Style="{StaticResource TxtSubhead}" MaxLines="1" LineBreakMode="TailTruncation" />
                                            <Label MaxLines="1" LineBreakMode="TailTruncation" Text="{Binding Category, StringFormat='{0} · 目录条目'}" Style="{StaticResource TxtCaption}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="{DynamicResource BeigeAccent50}"
                                                StrokeThickness="0" Padding="10,4" VerticalOptions="Start">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                            <Label MaxLines="1" LineBreakMode="TailTruncation" Text="{Binding SeverityText}" FontSize="12"
                                                   TextColor="{DynamicResource WarmDark}" />
                                        </Border>
                                    </Grid>
                                    <Label MaxLines="1" LineBreakMode="TailTruncation" Text="{Binding StabilityText}" Style="{StaticResource TxtCaption}" />
                                    <Label MaxLines="3" LineBreakMode="WordWrap" Text="{Binding Note}" Style="{StaticResource TxtCaption}" IsVisible="{Binding Note, Converter={StaticResource StringNotEmpty}}" />
                                    <Label Text="这条有安全边界：不提供做法、不美化，只做陪伴与转向求助。"
                                           Style="{StaticResource TxtCaption}" TextColor="{DynamicResource AccentWarmFg}"
                                           IsVisible="{Binding Safety}" />
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource WSpaceTight}">
                                        <Button Text="轻" Style="{StaticResource BtnNeumorphSm}" Padding="12,4"
                                                Command="{Binding BindingContext.SetMildCommand, Source={x:Reference Page}}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="中" Style="{StaticResource BtnNeumorphSm}" Padding="12,4"
                                                Command="{Binding BindingContext.SetModerateCommand, Source={x:Reference Page}}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="2" Text="重" Style="{StaticResource BtnNeumorphSm}" Padding="12,4"
                                                Command="{Binding BindingContext.SetSevereCommand, Source={x:Reference Page}}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="4" Text="移除" Style="{StaticResource BtnGhost}"
                                                Command="{Binding BindingContext.RemoveCommand, Source={x:Reference Page}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- 添加一条 -->
                <Border Style="{StaticResource CardSolid}">
                    <VerticalStackLayout Spacing="{DynamicResource WSpaceRegular}">
                        <Label Text="添加一条" Style="{StaticResource TxtSubhead}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource WSpaceRegular}">
                            <Picker Title="选择心理状况（116 条）" ItemsSource="{Binding CatalogNames}"
                                    SelectedItem="{Binding NewCondition}" FontSize="13" />
                            <Picker Grid.Column="1" WidthRequest="100" ItemsSource="{Binding SeverityChoices}"
                                    SelectedItem="{Binding NewSeverity}" FontSize="13" />
                        </Grid>
                        <Entry Placeholder="备注：触发点 / 来源 / 想被怎么对待（可留空）" Text="{Binding NewNote}"
                               BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                               PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" />
                        <Button Text="加到当前角色" Style="{StaticResource BtnPrimary}"
                                Padding="16,7" HorizontalOptions="Start" Command="{Binding AddCommand}" />
                        <Label Text="目录按类别分：情绪、焦虑、创伤、强迫、进食、睡眠、精神病性、人格、神经发育、神经、躯体、冲动、特质与安全类。轻度不等于没事，重度也不等于随时失控——严重度决定的是波动幅度与恢复速度。"
                               Style="{StaticResource TxtCaption}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
