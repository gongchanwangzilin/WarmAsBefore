<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:motion="clr-namespace:WarmAsBefore.Helpers" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:i18n="clr-namespace:WarmAsBefore.Services"
             x:Class="WarmAsBefore.Views.SettingsPage"
             Title="{Binding [Settings_Title], Source={x:Static i18n:LocalizationService.Current}}"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <!--
      分类页。结构对标桌面系统设置窗：一整块中性地面，眉栏不再是「另一种材质贴上去的条」，
      只有一根发丝线把它和正文分开；分类项不是一张张牌子，而是**一张卡里的一组行**。
      两级的壳（分类页 → 子页）保持不动，那是先前定下来的导航方式。
    -->
    <Grid RowDefinitions="Auto,1,*">
        <Grid Grid.Row="0" Padding="24,16,24,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Text="{Binding [Common_Back], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource BtnText}"
                    FontSize="14" Padding="0" VerticalOptions="Center"
                    Command="{Binding GoBackCommand}" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Image Source="titlelogo.png" WidthRequest="28" HeightRequest="28" Aspect="AspectFill"
                       VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding [Settings_Title], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtTitle}"
                       VerticalOptions="Center" />
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource WRule}" HeightRequest="1" StrokeThickness="0" />

        <ScrollView Grid.Row="2" Padding="24,18,24,24">
            <VerticalStackLayout x:Name="SettingsBody" HorizontalOptions="Fill" Spacing="16">

                <!-- 搜索：设置项多，先搜再点比一页页翻快。它是工具条不是内容，所以自己一张卡。 -->
                <Border Style="{StaticResource CardSolid}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" Text="{Binding SettingsSearchText}" Placeholder="搜设置（如：记忆 / 模型 / 语音 / 群聊）"
                               BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                               PlaceholderColor="{DynamicResource MutedFg}" FontSize="13" ClearButtonVisibility="WhileEditing" />
                        <Button Grid.Column="1" Text="清空" Style="{StaticResource BtnText}" FontSize="12"
                                VerticalOptions="Center"
                                Command="{Binding ClearSettingsSearchCommand}" />
                    </Grid>
                </Border>

                <!-- 匹配计数与空结果提示：挂在卡外，避免搜索时卡片高度反复跳。 -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Filter.MatchCount, StringFormat='匹配到 {0} 个设置项（进子页后只显示这些）'}" Style="{StaticResource TxtCaption}"
                           IsVisible="{Binding Filter.IsSearching}" />
                    <Label Text="{Binding Filter.EmptyHint}" Style="{StaticResource TxtCaption}"
                           TextColor="{DynamicResource AccentWarmFg}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2" Margin="2,8,0,0">
                    <Label Text="// CATALOG" Style="{StaticResource Eyebrow}" />
                    <Label Text="选择一个分类进入" Style="{StaticResource TxtCaption}" />
                </VerticalStackLayout>

                <!-- 分类图块：两列**按行成对**铺（窄屏单列，见代码）。之前左右各一个堆叠列，
                     两列内容高度不同 → 行与行永远对不齐，文字像从边框里漏出来。现在一行一 Grid，
                     左右同高（卡高固定 92），整张网格是齐的。Tile 由代码建、IsVisible 绑行 Visible，
                     搜索过滤照旧生效。 -->
                <VerticalStackLayout x:Name="TilesHost" Spacing="12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
