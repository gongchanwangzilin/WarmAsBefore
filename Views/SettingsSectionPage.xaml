                        <Grid ColumnDefinitions="96,*" Padding="0,13">
                            <Label Text="密钥" VerticalOptions="Center" FontSize="13" />
                            <Entry Text="{Binding BrainAiKey}" IsPassword="True" Placeholder="留空则沿用上面的 AI 密钥（只存本地，不进云存档）"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13"
                                   IsEnabled="{Binding BrainAiAssistEnabled}" /></Grid>
                        <BoxView Style="{StaticResource HSepBleed}" />
                        <Grid ColumnDefinitions="96,*" Padding="0,13">
                            <Label Text="模型" VerticalOptions="Center" FontSize="13" />
                            <Entry Text="{Binding BrainAiModel}" Placeholder="一个便宜/免费的模型名"
                                   BackgroundColor="{DynamicResource InputBg}" TextColor="{DynamicResource SurfaceFg}"
                                   PlaceholderColor="{DynamicResource MutedFg}" FontSize="13"
                                   IsEnabled="{Binding BrainAiAssistEnabled}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,13" IsEnabled="{Binding BrainAiAssistEnabled}">
                            <Label Text="{Binding BrainAiEveryTurns, StringFormat='每 {0} 轮补一次'}" FontSize="13" VerticalOptions="Center" />
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                <Slider WidthRequest="140" Minimum="2" Maximum="30" Value="{Binding BrainAiEveryTurns}" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

<Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Header -->
        <Border Background="{DynamicResource GlassBarBg}" Stroke="{DynamicResource GlassBarStroke}" Padding="16,12,16,12"
                StrokeThickness="{DynamicResource GlassBarStrokeThickness}">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="{Binding [Common_Back], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource BtnText}"
                        FontSize="14" Padding="0"
                        Command="{Binding GoBackCommand}" />
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="titlelogo.png" WidthRequest="30" HeightRequest="30" Aspect="AspectFill"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding [Settings_Title], Source={x:Static i18n:LocalizationService.Current}}" Style="{StaticResource TxtTitle}"
                           VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Border>

        

        <ScrollView Grid.Row="1" Padding="24,16,24,24">
            <VerticalStackLayout x:Name="SectionBody" HorizontalOptions="Fill" Spacing="16"
                                 >
                <!-- 分类标题与说明：进来先知道这一页是干什么的 -->
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="SectionTitleLabel" Style="{StaticResource TxtTitle}" />
                    <Label x:Name="SectionDescLabel" Style="{StaticResource TxtCaption}" />
                </VerticalStackLayout>

                <!-- 卡片宿主：按分类从模板实例化（见 SettingsSectionPage.xaml.cs） -->
                <VerticalStackLayout x:Name="CardsHost" Spacing="16" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
