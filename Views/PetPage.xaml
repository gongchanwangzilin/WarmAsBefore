<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:i18n="clr-namespace:WarmAsBefore.Services"
             x:Class="WarmAsBefore.Views.PetPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Transparent">

    <Grid Padding="0">
        <!-- 回复气泡（顶部）：桌宠对话时显示 AI 回复 / 思考中… -->
        <Border x:Name="ReplyBubble" BackgroundColor="#CC4A3D2C" StrokeThickness="0"
                Padding="10,6" HorizontalOptions="Fill" VerticalOptions="Start"
                Margin="10,36,10,0" IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
            <Label x:Name="ReplyLabel" TextColor="White" FontSize="12"
                   LineBreakMode="WordWrap" MaxLines="4" />
        </Border>

        <!-- 返回按钮 -->
        <Button Text="← 返回" 
                TextColor="{DynamicResource SurfaceFg}"
                BackgroundColor="{DynamicResource SurfaceBg}"
                FontSize="13" Padding="12,0" CornerRadius="16" HeightRequest="32"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="12,8,0,0"
                Clicked="OnBack" />

        <!-- 立绘区域：双击回主窗口（输入行与气泡不挂手势，避免抢焦点） -->
        <Grid VerticalOptions="Fill" Margin="0,50,0,70">
            <Grid.GestureRecognizers>
                <!-- 单击=思考（自言自语嘀咕一句）；双击=回主窗口。单击在 code-behind 里延迟判定，避免被双击抢走。 -->
                <TapGestureRecognizer Tapped="OnSingleTapped" NumberOfTapsRequired="1" />
                <TapGestureRecognizer Tapped="OnDoubleTapped" NumberOfTapsRequired="2" />
            </Grid.GestureRecognizers>

            <!-- 立绘（PNG 自带透明通道）；#E4：可捏合缩放 / 拖动移动 -->
            <Image x:Name="SpriteImage" Aspect="AspectFit"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   Margin="6,0,6,30">
                <Image.GestureRecognizers>
                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                </Image.GestureRecognizers>
            </Image>
            <!-- 名字角标 -->
            <Border BackgroundColor="#7A4A3D2C" StrokeThickness="0"
                    Padding="14,5" HorizontalOptions="Center" VerticalOptions="End"
                    Margin="0,0,0,6">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Label x:Name="NameLabel" TextColor="White" FontSize="12" />
            </Border>
        </Grid>

        <!-- 带说明文字的提示条 -->
        <Border BackgroundColor="#5A4A3D2C" StrokeThickness="0"
                Padding="10,4" HorizontalOptions="Center" VerticalOptions="Start"
                Margin="0,4,0,0">
            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
            <Label Text="双击返回主界面" TextColor="#CCFFFFFF" FontSize="10" />
        </Border>

        <!-- 底部对话输入行：桌宠模式下直接和她说说话 -->
        <Border BackgroundColor="#CC4A3D2C" StrokeThickness="0"
                Padding="8,6" HorizontalOptions="Fill" VerticalOptions="End"
                Margin="8,0,8,8">
            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Entry x:Name="InputEntry" TextColor="White" PlaceholderColor="#AAFFFFFF"
                       Placeholder="和她说点什么…" BackgroundColor="#22FFFFFF"
                       FontSize="12" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="发送" FontSize="12" TextColor="White"
                        BackgroundColor="#33FFFFFF" CornerRadius="10"
                        Padding="12,4" Clicked="OnSend" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>