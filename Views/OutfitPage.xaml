<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.OutfitPage"
             x:DataType="vm:OutfitViewModel"
             Title="换装"
             Background="{DynamicResource PageBgBrush}">

    <!--
      占位页：装扮视图模型目前没有任何内容，所以这里只做「并进这套语言」的事，
      不给它发明内容（那需要新的文案与新绑定，都不在这次的范围里）。
      眉栏与内容区是同一块地，靠下面一条发丝线分界；地面/线/内距全部跟世界走。
    -->
    <Grid RowDefinitions="Auto,Auto,*" Padding="0">
        <Border Background="{DynamicResource WBarBrush}" StrokeThickness="0"
                Padding="{DynamicResource WPadWell}">
            <Label Text="换装" Style="{StaticResource TxtTitle}" VerticalOptions="Center" />
        </Border>
        <BoxView Grid.Row="1" Color="{DynamicResource WRule}" HeightRequest="1" HorizontalOptions="Fill" />
    </Grid>
</ContentPage>
