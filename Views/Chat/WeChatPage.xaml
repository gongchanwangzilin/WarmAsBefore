<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:motion="clr-namespace:WarmAsBefore.Helpers" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:mdl="clr-namespace:WarmAsBefore.Models"
             xmlns:i18n="clr-namespace:WarmAsBefore.Services"
             xmlns:views="clr-namespace:WarmAsBefore.Views.Chat"
             xmlns:dev="clr-namespace:WarmAsBefore.Services.Dev"
             x:Class="WarmAsBefore.Views.WeChatPage"
             x:Name="Page"

             Shell.NavBarIsVisible="False"
             Background="{StaticResource WcChatBg}">

    <!--
      微信壳 · 单聊会话（移动端观感，白 + 蓝）。
      灰色会话底（WcChatBg）上浮「我=浅蓝气泡 / 对方=白气泡」；顶栏浅灰、发丝线分界。
      品牌色一律 Wc*（WeChatBrand.xaml），静态、不随风格世界与明暗档走。
      所有命令/绑定保持原样，只换皮。
    -->
<Grid RowDefinitions="56,*" Padding="0">
        <Grid.ColumnDefinitions>
            <!-- 全屏对话时两栏真的收成 0 宽，右栏才铺满整窗。 -->
            <ColumnDefinition Width="{Binding RailWidth}" />
            <ColumnDefinition Width="{Binding ListWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- 左栏：QQ 桌面版那根窄竖栏（头像 + 各入口）。全屏对话时让位。 -->
        <Border Grid.Column="0" Grid.RowSpan="2" BackgroundColor="{StaticResource WcHeader}" StrokeThickness="0"
                Padding="0,14" IsVisible="{Binding IsFullScreen, Converter={StaticResource InverseBool}}">
          <Grid>
            <VerticalStackLayout Spacing="20" HorizontalOptions="Center" VerticalOptions="Start">
                <Grid WidthRequest="38" HeightRequest="38">
                    <BoxView WidthRequest="38" HeightRequest="38" CornerRadius="19"
                             Color="{StaticResource WcAccent}" />
                    <Label Text="初" TextColor="{StaticResource WcPageBg}" FontSize="16"
                           FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
                <VerticalStackLayout Spacing="20" Margin="0,6,0,0">
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="18" TextColor="{StaticResource WcSub}" HorizontalOptions="Center" />
                        <Label Text="{Binding UnreadTotalLabel}" TextColor="{StaticResource WcSub}"
                               FontSize="10" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="18" TextColor="{StaticResource WcSub}" HorizontalOptions="Center" />
                        <Label Text="好友" TextColor="{StaticResource WcSub}" FontSize="10"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="18" TextColor="{StaticResource WcSub}" HorizontalOptions="Center" />
                        <Label Text="收藏" TextColor="{StaticResource WcSub}" FontSize="10"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="&#xE76E;" FontFamily="Segoe MDL2 Assets" FontSize="18" TextColor="{StaticResource WcSub}" HorizontalOptions="Center" />
                        <Label Text="表情" TextColor="{StaticResource WcSub}" FontSize="10"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <Label Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" TextColor="{StaticResource WcSub}" HorizontalOptions="Center" />
                        <Label Text="设置" TextColor="{StaticResource WcSub}" FontSize="10"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <!-- dev 压测条：只有带 worst 启动参数时才占地方，竖排塞进 64 宽的竖栏 -->
            <dev:WorstCaseBar Vertical="True" Margin="0,0,0,2" />
          </Grid>
        </Border>

            <!-- 与右栏头部同高（56）：两条分隔线落在同一条基线上，不会一高一低。 -->
            <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6"
              Padding="10,0" BackgroundColor="{StaticResource WcHeader}">
                <Border BackgroundColor="{StaticResource WcHeader}" StrokeThickness="1"
                        Stroke="{StaticResource WcSep}" Padding="10,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <!-- StyleId 交给 EntryHandler：这个框外面已经有自己的圆角边框，
                         Windows 再叠一层原生 TextBox 边框就成了「双框」，很扎眼。 -->
                    <Entry StyleId="WabPlainInput" Text="{Binding ContactSearch}" Placeholder="搜索"
                           PlaceholderColor="{StaticResource WcFaint}"
                           TextColor="{StaticResource WcInk}" BackgroundColor="Transparent"
                           Margin="0" FontSize="13" HeightRequest="30" />
                </Border>
                <Button Grid.Column="1" Text="＋" Style="{StaticResource BtnText}"
                        TextColor="{StaticResource WcSub}" FontSize="17" WidthRequest="30" Padding="0"
                        Command="{Binding RefreshContactsCommand}" />
                <!-- 分隔线画在这一格自己的底边：两栏头部都是 56px，两条线自然同高。 -->
                <BoxView Grid.ColumnSpan="2" VerticalOptions="End" HeightRequest="1"
                         Color="{StaticResource WcSep}" />
            </Grid>

        <!-- 中栏：会话列表（搜索 + 新建 + 每行：头像 / 名字 / 最后一条 / 时间 / 未读红点） -->
        <Grid Grid.Column="1" Grid.Row="1" RowDefinitions="*" BackgroundColor="{StaticResource WcPageBg}"
              IsVisible="{Binding IsFullScreen, Converter={StaticResource InverseBool}}">

            <CollectionView Grid.Row="0" ItemsSource="{Binding ContactList}"
                            SelectionMode="None" BackgroundColor="Transparent" Margin="0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="10" Padding="24">
                        <Image Source="ic_chat.png" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" />
                        <Label Text="{Binding Source={x:Reference Page}, Path=BindingContext.ContactsEmptyHint}"
                               TextColor="{StaticResource WcSub}"
                               FontSize="15" HorizontalOptions="Center" />
                        <Label Text="存档里的角色都会出现在这里，随时能给你发消息"
                               TextColor="{StaticResource WcFaint}" FontSize="12"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WeChatContactItem">
                        <VerticalStackLayout motion:HoverFeel.Enabled="True" motion:PressFeel.Enabled="True" Spacing="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="10,9"
                                  BackgroundColor="{StaticResource WcRow}">
                                <Grid Grid.Column="0" WidthRequest="40" HeightRequest="40">
                                    <BoxView WidthRequest="40" HeightRequest="40" CornerRadius="20"
                                             Color="{StaticResource WcAvatar}" InputTransparent="True" />
                                    <Image Source="{Binding Avatar}" Aspect="AspectFill"
                                           WidthRequest="40" HeightRequest="40" IsVisible="{Binding HasAvatar}" />
                                    <Label Text="{Binding Initial}" TextColor="{StaticResource WcInk}"
                                           FontSize="15" FontAttributes="Bold"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           IsVisible="{Binding HasAvatar, Converter={StaticResource InverseBool}}" />
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" TextColor="{StaticResource WcInk}"
                                           FontSize="14" LineBreakMode="TailTruncation" MaxLines="1"
                                           ToolTipProperties.Text="{Binding Name}" />
                                    <Label Text="{Binding LastMessage}" TextColor="{StaticResource WcSub}"
                                           FontSize="12" LineBreakMode="TailTruncation" MaxLines="1" />
                                </VerticalStackLayout>
                                <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="4"
                                      VerticalOptions="Center" HorizontalOptions="End">
                                    <Label Text="{Binding TimeLabel}" TextColor="{StaticResource WcFaint}"
                                           FontSize="11" HorizontalOptions="End" />
                                    <!-- 只有未读/已读两态，没有计数：画一个红点，不编一个数字出来。 -->
                                    <Border Grid.Row="1" IsVisible="{Binding Unread}"
                                            BackgroundColor="{StaticResource WcAccent}" WidthRequest="8" HeightRequest="8"
                                            StrokeThickness="0" Padding="0" HorizontalOptions="End"
                                            StrokeShape="RoundRectangle 4" />
                                </Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenContactCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource WcSep}" Margin="60,0,0,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Header: 返回 + 头像 + 名字 + 「微信」徽标 -->
        <Border Grid.Column="2" Grid.Row="0" BackgroundColor="{StaticResource WcHeaderChat}" StrokeThickness="0"
                Padding="12,0,14,0" >
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto"
                  ColumnSpacing="10" RowSpacing="1">
                <Button Grid.RowSpan="2" Text="&lt;" Style="{StaticResource BtnText}" TextColor="{StaticResource WcInk}"
                        FontSize="18" Padding="0" WidthRequest="26" VerticalOptions="Center"
                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.BackCommand}" />
                <Grid Grid.RowSpan="2" Grid.Column="1" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <BoxView WidthRequest="36" HeightRequest="36" CornerRadius="18"
                             Color="{StaticResource WcAvatar}" InputTransparent="True" />
                    <Image Source="{Binding PartnerAvatar}" Aspect="AspectFill"
                           IsVisible="{Binding HasPartnerAvatar}"
                           HorizontalOptions="Fill" VerticalOptions="Fill" />
                    <Label Text="{Binding PartnerInitial}"
                           TextColor="{StaticResource WcInk}" FontSize="15"
                           HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"
                           IsVisible="{Binding HasPartnerAvatar, Converter={StaticResource InverseBool}}" MaxLines="1" LineBreakMode="TailTruncation" />
                </Grid>
                <!-- 名字与副标题各占一行：原来塞进同一个 VerticalStackLayout，两行字紧贴在一起就是「上侧重合」。 -->
                <Label Grid.Row="0" Grid.Column="2" Text="{Binding PartnerName}"
                       TextColor="{StaticResource WcInk}" FontSize="15" FontAttributes="Bold"
                       LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="End"
                       ToolTipProperties.Text="{Binding PartnerName}" />
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding ModeLabel}"
                       TextColor="{StaticResource WcSub}" FontSize="11"
                       LineBreakMode="TailTruncation" MaxLines="1" Margin="0,2,0,0" VerticalOptions="Start" />
                <HorizontalStackLayout Grid.RowSpan="2" Grid.Column="3" Spacing="6" VerticalOptions="Center">
                    <!-- F22：全屏对话按钮（进入/退出同一个键，随时可返回） -->
                    <Button Text="全屏" Style="{StaticResource BtnText}" TextColor="{StaticResource WcAccent}"
                            FontSize="12" Padding="8,4" CornerRadius="12"
                            BackgroundColor="{StaticResource WcAccentSoft}"
                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleFullScreenCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFullScreen}" Value="True">
                                <Setter Property="Text" Value="返回" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Border BackgroundColor="{StaticResource WcAccentSoft}"
                            StrokeThickness="0" Padding="10,4" VerticalOptions="Center"
                            IsVisible="{Binding IsFullScreen, Converter={StaticResource InverseBool}}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Label Text="微信" FontSize="11" TextColor="{StaticResource WcAccent}" />
                    </Border>
                </HorizontalStackLayout>
                <BoxView Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="4"
                         VerticalOptions="End" HeightRequest="1" Color="{StaticResource WcSep}" />
            </Grid>
        </Border>

        <!-- 右栏：聊天区（原来占整页，现在收进第三列） -->
        <Grid Grid.Column="2" Grid.Row="1" RowDefinitions="*,Auto,Auto,Auto">

        <!-- 会话：文字 / 图片(表情包) / 视频内联 / 文件卡片 四态。我=浅蓝右，对方=白左 -->
        <CollectionView Grid.Row="0" ItemsSource="{Binding Messages}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        BackgroundColor="Transparent" Margin="10,8,10,4">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="24">
                    <Label Text="还没有聊过" TextColor="{StaticResource WcSub}" FontSize="14"
                           HorizontalOptions="Center" />
                    <Label Text="说点什么，她会在下面回你" TextColor="{StaticResource WcFaint}" FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="mdl:ChatItem">
                    <Grid Padding="0,3">
                        <!-- 我发的（右侧，浅蓝气泡） -->
                        <Border IsVisible="{Binding IsUser}"
                                BackgroundColor="{StaticResource WcMine}"
                                StrokeThickness="0" Padding="10,8"
                                HorizontalOptions="End" MaximumWidthRequest="300">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14,14,4,14" /></Border.StrokeShape>
                            <Grid>
                                <Label Text="{Binding BubbleText}" TextColor="{StaticResource WcMineInk}"
                                       FontSize="14" LineBreakMode="WordWrap" IsVisible="{Binding IsText}" />
                                <Image Source="{Binding ImageSource}" Aspect="AspectFit"
                                       WidthRequest="150" HeightRequest="150"
                                       IsVisible="{Binding HasImage}" />
                                <toolkit:MediaElement Source="{Binding VideoPath}"
                                       IsVisible="{Binding IsVideo}"
                                       WidthRequest="240" HeightRequest="160"
                                       ShouldAutoPlay="False" ShouldShowPlaybackControls="True"
                                       BackgroundColor="Black" />
                                <Border motion:HoverFeel.Enabled="True" motion:PressFeel.Enabled="True" IsVisible="{Binding IsFile}"
                                        BackgroundColor="{StaticResource WcTheirs}"
                                        StrokeThickness="1" Stroke="{StaticResource WcSep}"
                                        Padding="10,8">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="{Binding FileName}" TextColor="{StaticResource WcInk}"
                                           FontSize="12" LineBreakMode="TailTruncation" MaxLines="2" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenFileCommand}"
                                            CommandParameter="{Binding FileName}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 对方发的（左侧，白气泡） -->
                        <HorizontalStackLayout IsVisible="{Binding IsUser, Converter={StaticResource InverseBool}}"
                                               Spacing="8">
                            <Border BackgroundColor="{StaticResource WcTheirs}"
                                    StrokeThickness="0" Padding="10,8"
                                    HorizontalOptions="Start" MaximumWidthRequest="300">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14,14,14,4" /></Border.StrokeShape>
                                <Grid>
                                    <Label Text="{Binding BubbleText}" TextColor="{StaticResource WcTheirsInk}"
                                           FontSize="14" LineBreakMode="WordWrap" IsVisible="{Binding IsText}" />
                                    <Image Source="{Binding ImageSource}" Aspect="AspectFit"
                                           WidthRequest="150" HeightRequest="150"
                                           IsVisible="{Binding HasImage}" />
                                    <toolkit:MediaElement Source="{Binding VideoPath}"
                                           IsVisible="{Binding IsVideo}"
                                           WidthRequest="240" HeightRequest="160"
                                           ShouldAutoPlay="False" ShouldShowPlaybackControls="True"
                                           BackgroundColor="Black" />
                                    <Border motion:HoverFeel.Enabled="True" motion:PressFeel.Enabled="True" IsVisible="{Binding IsFile}"
                                            BackgroundColor="{StaticResource WcTheirs}"
                                            StrokeThickness="1" Stroke="{StaticResource WcSep}"
                                            Padding="10,8">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                        <Label Text="{Binding FileName}" TextColor="{StaticResource WcInk}"
                                               FontSize="12" LineBreakMode="TailTruncation" MaxLines="2" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenFileCommand}"
                                                CommandParameter="{Binding FileName}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>

                        <!-- 工具调用卡片：居中、可点开看详情（F22，仅「显示工具调用」时入流） -->
                        <Border IsVisible="{Binding IsToolVisible}"
                                BackgroundColor="{StaticResource WcAccentSoft}"
                                StrokeThickness="0" Padding="10,8"
                                HorizontalOptions="Center" MaximumWidthRequest="320">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="4" motion:HoverFeel.Enabled="True" motion:PressFeel.Enabled="True">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalOptions="Center" />
                                    <Label Text="{Binding ToolSummary}" TextColor="{StaticResource WcAccent}"
                                           FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Text="{Binding ToolExpanded, Converter={StaticResource BoolToAsterisk}}"
                                           TextColor="{StaticResource WcAccent}" FontSize="11" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding ToolDetails}" TextColor="{StaticResource WcTheirsInk}"
                                       FontSize="11" LineBreakMode="WordWrap" IsVisible="{Binding IsToolDetailVisible}" />
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleToolDetailsCommand}"
                                        CommandParameter="{Binding .}" />
                                </HorizontalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 正在输入提示 -->
        <Border Grid.Row="1" IsVisible="{Binding IsTyping}"
                BackgroundColor="Transparent" StrokeThickness="0"
                Padding="16,2,0,2">
            <HorizontalStackLayout Spacing="6">
                <Border BackgroundColor="{StaticResource WcTheirs}"
                        StrokeThickness="1" Stroke="{StaticResource WcSep}"
                        Padding="10,6">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Label Text="{Binding TypingLabel}" TextColor="{StaticResource WcSub}"
                           FontSize="12" />
                </Border>
            </HorizontalStackLayout>
        </Border>

        <!-- 表情面板：用户导入的表情库 -->
        <Border Grid.Row="2" IsVisible="{Binding IsStickerPanelVisible}"
                BackgroundColor="{StaticResource WcPageBg}" StrokeThickness="0"
                Padding="10,8">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <BoxView HeightRequest="1" Color="{StaticResource WcSep}" VerticalOptions="Start" HorizontalOptions="Fill" />
            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="我的表情包" TextColor="{StaticResource WcSub}" FontSize="12"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="导入表情" FontSize="12"
                            BackgroundColor="{StaticResource WcAccentSoft}" TextColor="{StaticResource WcAccent}"
                            CornerRadius="10" Padding="10,4"
                            Command="{Binding ImportStickerCommand}" />
                </Grid>
                <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <BindableLayout.ItemsSource>
                            <Binding Path="Stickers" />
                        </BindableLayout.ItemsSource>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Image motion:HoverFeel.Enabled="True" motion:PressFeel.Enabled="True" Source="{Binding}" WidthRequest="52" HeightRequest="52"
                                       Aspect="AspectFit">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.SendStickerCommand}"
                                            CommandParameter="{Binding}" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
                <Label Grid.Row="1" Text="还没有表情，点「导入表情」添加（图片/动图/视频/任意文件均可）"
                       TextColor="{StaticResource WcFaint}" FontSize="12"
                       IsVisible="{Binding HasStickers, Converter={StaticResource InverseBool}}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- 输入条：思考档位（思考条 + 快速按钮） + 语音 + 礼物 + 多行输入 + 表情 + 文件 + 发送（蓝） -->
        <Border Grid.Row="3" BackgroundColor="{StaticResource WcPageBg}"
                Padding="8,8,8,10" StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="4">
                <BoxView HeightRequest="1" Color="{StaticResource WcSep}" VerticalOptions="Start" HorizontalOptions="Fill" />
                <views:ThinkBarView x:Name="ThinkBar" />
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                    <Button Grid.Column="0" Text="语音"
                            Style="{StaticResource BtnText}" TextColor="{StaticResource WcSub}"
                            FontSize="11" HeightRequest="38" WidthRequest="38" Padding="0"
                            Command="{Binding VoiceInputCommand}" />
                    <Button Grid.Column="1" Text="礼物"
                            Style="{StaticResource BtnText}" TextColor="{StaticResource WcSub}"
                            FontSize="11" HeightRequest="38" WidthRequest="38" Padding="0"
                            Command="{Binding ToggleGiftPanelCommand}" />
                    <Border Grid.Column="2" BackgroundColor="{StaticResource WcInputBg}" StrokeThickness="0" Padding="12,4">
                        <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                        <Editor x:Name="TextEditor" Placeholder="输入…" Text="{Binding InputText}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource WcInk}"
                                PlaceholderColor="{StaticResource WcFaint}"
                                FontSize="14"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="32" MaximumHeightRequest="96"
                                Completed="OnEditorCompleted"
                                VerticalOptions="Center" />
                    </Border>
                    <Button Grid.Column="3" Text="&#xE76E;" FontFamily="Segoe MDL2 Assets"
                            BackgroundColor="Transparent"
                            FontSize="18" Padding="6"
                            HeightRequest="40" WidthRequest="40"
                            Command="{Binding ToggleStickerPanelCommand}" />
                    <Button Grid.Column="4" Text="&#xE723;" FontFamily="Segoe MDL2 Assets"
                            BackgroundColor="Transparent"
                            FontSize="16" Padding="6"
                            HeightRequest="40" WidthRequest="40"
                            Command="{Binding PickFileCommand}" />
                    <Button Grid.Column="5" Text="发送"
                            BackgroundColor="{StaticResource WcAccent}" TextColor="{StaticResource WcAccentInk}"
                            FontSize="13" FontAttributes="Bold"
                            CornerRadius="18" HeightRequest="40" WidthRequest="56" Padding="0"
                            Command="{Binding SendCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- 送礼 / 使用面板 -->
        <Grid Grid.RowSpan="5" IsVisible="{Binding IsGiftPanelVisible}"
              BackgroundColor="{DynamicResource OverlayDim}">
            <Border BackgroundColor="{StaticResource WcPageBg}" StrokeThickness="0"
                    Padding="0" Margin="30" VerticalOptions="Center"
                    MaximumWidthRequest="400">
                <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource ShadowDim}" Offset="0,4" Radius="16" Opacity="0.5" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="18,16" RowSpacing="12">
                    <Label Text="礼物箱 " TextColor="{StaticResource WcInk}" FontSize="16"
                           FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="点一下送出心意，对方会收下并回应" TextColor="{StaticResource WcSub}" FontSize="12"
                           HorizontalOptions="Center" />

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text=" 送礼" FontSize="13" HeightRequest="36" CornerRadius="10" Padding="0"
                                BackgroundColor="{StaticResource WcAccent}" TextColor="{StaticResource WcAccentInk}"
                                Command="{Binding ToggleGiftModeCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsGiftMode}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource WcInputBg}" />
                                    <Setter Property="TextColor" Value="{StaticResource WcSub}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="使用" FontSize="13" HeightRequest="36" CornerRadius="10" Padding="0"
                                BackgroundColor="{StaticResource WcInputBg}" TextColor="{StaticResource WcSub}"
                                Command="{Binding ToggleGiftModeCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsGiftMode}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource WcAccent}" />
                                    <Setter Property="TextColor" Value="{StaticResource WcAccentInk}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <ScrollView Grid.Row="3" MaximumHeightRequest="300" IsVisible="{Binding HasGiftItems}">
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding GiftItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,8">
                                            <Border BackgroundColor="{StaticResource WcInputBg}" StrokeThickness="0"
                                                    WidthRequest="40" HeightRequest="40" Padding="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                                <Label Text="{Binding Emoji}" FontSize="20"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Name}" TextColor="{StaticResource WcInk}"
                                                       FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Desc}" TextColor="{StaticResource WcSub}" FontSize="11"
                                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End"
                                                                 VerticalOptions="Center" Spacing="6">
                                                <Border BackgroundColor="{StaticResource WcInputBg}" StrokeThickness="0"
                                                        Padding="9,2" HorizontalOptions="End">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                    <Label Text="{Binding Owned, StringFormat='×{0}'}"
                                                           TextColor="{StaticResource WcSub}" FontSize="10" />
                                                </Border>
                                                <Button Text="送礼" FontSize="11" HeightRequest="28" Padding="12,0" CornerRadius="10"
                                                        BackgroundColor="{StaticResource WcAccent}" TextColor="{StaticResource WcAccentInk}"
                                                        IsVisible="{Binding Path=BindingContext.IsGiftMode, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        Command="{Binding Path=BindingContext.GiftItemCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Text="使用" FontSize="11" HeightRequest="28" Padding="12,0" CornerRadius="10"
                                                        BackgroundColor="{StaticResource WcAccentSoft}" TextColor="{StaticResource WcAccent}"
                                                        IsVisible="{Binding Path=BindingContext.IsGiftMode, Source={RelativeSource AncestorType={x:Type ContentPage}}, Converter={StaticResource InverseBool}}"
                                                        Command="{Binding Path=BindingContext.UseItemCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource WcSep}" Margin="4,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <VerticalStackLayout Grid.Row="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                                         IsVisible="{Binding HasGiftItems, Converter={StaticResource InverseBool}}">
                        <Image Source="ic_gift.png" WidthRequest="34" HeightRequest="34" HorizontalOptions="Center" />
                        <Label Text="还没有已购商品，先去商店逛逛吧～" TextColor="{StaticResource WcSub}" FontSize="12" />
                    </VerticalStackLayout>

                    <Button Grid.Row="4" Text="关闭" FontSize="13" HeightRequest="40" CornerRadius="12"
                            BackgroundColor="Transparent" TextColor="{StaticResource WcSub}"
                            Command="{Binding ToggleGiftPanelCommand}" />
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</ContentPage>
