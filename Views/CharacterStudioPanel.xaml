                                               Style="{StaticResource TxtCaption}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="{Binding MainLabel}"
                                            Style="{StaticResource BtnGhostSm}"
                                            Command="{Binding ToggleMainCommand}" />
                                </Grid>

                                <BoxView Style="{StaticResource HSep}" />

                                <VerticalStackLayout Spacing="8">
                                    <Label Text="复制一个 TA" Style="{StaticResource PaneTitle}" />
