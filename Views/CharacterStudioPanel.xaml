                                                        <DataTemplate x:DataType="vm:StudioArtCell">
                                                            <Border Style="{StaticResource ArtCell}"
                                                                    WidthRequest="76" HeightRequest="86"
                                                                    Margin="0,0,6,6">
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer
                                                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.PickCellCommand}"
                                                                        CommandParameter="{Binding .}" />
                                                                </Border.GestureRecognizers>
                                                                <Grid>
                                                                    <BoxView WidthRequest="68" HeightRequest="78"
                                                                             Color="{DynamicResource WellBg}"
                                                                             IsVisible="{Binding HasImage, Converter={StaticResource InverseBool}}" />
                                                                    <Image Source="{Binding Image}" Aspect="AspectFill"
                                                                           HeightRequest="78" IsVisible="{Binding HasImage}" />
                                                                    <Label Text="{Binding CornerLabel}" FontSize="11"
                                                                           TextColor="{DynamicResource MutedFg}"
                                                                           HorizontalOptions="End" VerticalOptions="Start" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </FlexLayout>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <BoxView Style="{StaticResource HSep}" />

                                <VerticalStackLayout Spacing="8">
                                    <Label Text="生成这一格" Style="{StaticResource PaneTitle}" />
                                    <Editor Style="{StaticResource FieldMulti}" HeightRequest="64"
                                            Text="{Binding ArtPrompt}"
                                            Placeholder="例：白色针织衫配浅色长裙，站在午后窗边，微微笑" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Button Text="画立绘" Style="{StaticResource BtnPrimarySm}"
                                                IsEnabled="{Binding CanGenerateArt}"
                                                Command="{Binding GenerateArtCommand}" />
                                        <ActivityIndicator Grid.Column="1" IsRunning="{Binding Busy}"
                                                           IsVisible="{Binding Busy}" HorizontalOptions="Start" />
                                    </Grid>
                                    <Label Text="{Binding ArtHint}" Style="{StaticResource TxtCaption}"
                                           LineHeight="1.3" />
                                </VerticalStackLayout>

                                <FlexLayout Direction="Row" Wrap="Wrap">
                                    <Button Text="导入素材包（zip）" Style="{StaticResource BtnGhostSm}"
                                            Margin="0,0,6,6" Command="{Binding ImportArtZipCommand}" />
                                    <Button Text="换头像" Style="{StaticResource BtnGhostSm}"
                                            Command="{Binding PickAvatarCommand}" />
                                </FlexLayout>
                            </VerticalStackLayout>

                            <!-- ══ 记忆 ══════════════════════════════════════ -->
                            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsTabMem}">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                        <Label Text="04" Style="{StaticResource SectionNo}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label Text="// MEMORY" Style="{StaticResource Eyebrow}" />
                                            <Label Text="TA 记得什么" Style="{StaticResource PaneTitle}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <BoxView Style="{StaticResource HSep}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Layers}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StudioLayerRow">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,5">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label Text="{Binding Name}" Style="{StaticResource TxtBodySm}" />
                                                    <Label Text="{Binding Detail}" Style="{StaticResource TxtCaption}"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding Count}"
                                                       Style="{StaticResource TxtCaption}" VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <BoxView Style="{StaticResource HSep}" />

                                <VerticalStackLayout Spacing="8">
                                    <Label Text="这份记忆归谁" Style="{StaticResource PaneTitle}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="所有存档共用一份记忆" Style="{StaticResource TxtBodySm}" />
