<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:dev="clr-namespace:WarmAsBefore.Services.Dev"
             xmlns:ctl="clr-namespace:WarmAsBefore.Controls"
             x:Class="WarmAsBefore.Views.SaveTreePage"
             x:Name="Page"
             Title=""
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <!-- 顶栏：返回 + 标题 + 根档选择 + 去这个存档。根档选择就是「这是哪一局的树」，
             所以它必须和标题同一行、随时能换，而不是藏进菜单。 -->
        <Border Grid.Row="0" Background="{DynamicResource WBarBrush}" StrokeThickness="0"
                Padding="{DynamicResource WPadWell}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Button Text="&lt; 返回" Style="{StaticResource BtnText}"
                        Padding="0" VerticalOptions="Center"
                        Command="{Binding BackCommand}" />
                <Label Grid.Column="1" Text="分支树" Style="{StaticResource TxtTitle}"
                       VerticalOptions="Center" />
                <!-- 每份初始存档一棵树：这里选树根，切换时重算布局 -->
                <Picker Grid.Column="2" Title="选择起始存档"
                        ItemsSource="{Binding Roots}"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedRoot}"
                        WidthRequest="170" VerticalOptions="Center"
                        FontSize="12"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource SurfaceFg}"
                        TitleColor="{DynamicResource MutedFg}"
                        ToolTipProperties.Text="每份初始存档一棵树，选一个看它的分支" />
                <Button Grid.Column="3" Text="去这个存档" Style="{StaticResource BtnNeumorphSm}"
                        WidthRequest="104" VerticalOptions="Center"
                        IsEnabled="{Binding CanOpenSlot}"
                        Command="{Binding OpenSlotCommand}" />
                <!-- 压测档徽标：与全站同一个组件，压测档没开时宽高为 0 -->
                <ctl:WorstCaseBadge Grid.Column="3" HorizontalOptions="End" VerticalOptions="Center" />
            </Grid>
        </Border>
        <BoxView Grid.Row="1" Style="{StaticResource HSep}" />

        <!-- 画布：GraphicsView 由 code-behind 注入 Drawable。
             宽高都按内容撑（列数 × 列距 / 泳道数 × 行高），外层 ScrollView 双向可滚 ——
             泳道一多、存档一长，横向拖动就能看到完整的一棵树。 -->
        <Border Grid.Row="2" Style="{StaticResource CardSolid}" Padding="4"
                Margin="{DynamicResource WPadCard}"
                HorizontalOptions="Fill" MaximumWidthRequest="{DynamicResource WCardWidth}">
            <Grid RowDefinitions="*,Auto" RowSpacing="4">
                <ScrollView x:Name="CanvasScroll" Orientation="Both"
                            HorizontalScrollBarVisibility="Default"
                            VerticalScrollBarVisibility="Default">
                    <GraphicsView x:Name="TreeCanvas"
                                  EndInteraction="OnCanvasEnd"
                                  BackgroundColor="Transparent" />
                </ScrollView>
                <Label Grid.Row="1" Style="{StaticResource TxtCaption}" MaxLines="2"
                       Text="{Binding StatusText}" />
            </Grid>
        </Border>

        <!-- dev 压测条：带 worst 启动参数时才出现 -->
        <dev:WorstCaseBar Grid.Row="3" />
    </Grid>
</ContentPage>
