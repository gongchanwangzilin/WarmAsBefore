<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:dev="clr-namespace:WarmAsBefore.Services.Dev"
             x:Class="WarmAsBefore.Views.SaveTreePage"
             x:Name="Page"
             Title=""
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <!-- 顶栏：< 返回 + 标题，沿用存档页的 BtnText / TxtTitle，不加任何新样式 -->
        <Border Grid.Row="0" Background="{DynamicResource WBarBrush}" StrokeThickness="0"
                Padding="{DynamicResource WPadWell}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="&lt; 返回" Style="{StaticResource BtnText}"
                        Padding="0" VerticalOptions="Center"
                        Command="{Binding BackCommand}" />
                <Label Grid.Column="1" Text="分支树" Style="{StaticResource TxtTitle}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>
        <BoxView Grid.Row="1" Style="{StaticResource HSep}" />

        <!-- 画布：GraphicsView 由 code-behind 注入 Drawable；Empty 态由 Drawable 自己画提示 -->
        <Border Grid.Row="2" Style="{StaticResource CardSolid}" Padding="4"
                Margin="{DynamicResource WPadCard}"
                HorizontalOptions="Fill" MaximumWidthRequest="{DynamicResource WCardWidth}">
            <Grid RowDefinitions="*,Auto" RowSpacing="4">
                <!-- 画布按泳道数撑高（code-behind 用 Drawable.ContentHeight 设 HeightRequest），
                     节点多于可视区时靠这一层滚动到达 —— 固定高度会把第 6 条以下的分支整个切掉。 -->
                <ScrollView Orientation="Vertical" VerticalScrollBarVisibility="Default">
                    <GraphicsView x:Name="TreeCanvas"
                                  EndInteraction="OnCanvasEnd"
                                  MinimumHeightRequest="260"
                                  BackgroundColor="Transparent" />
                </ScrollView>
                <Label Grid.Row="1" Text="横向为时间（左旧右新），纵向为分支泳道；点节点看详情"
                       Style="{StaticResource TxtCaption}" MaxLines="2" />
            </Grid>
        </Border>

        <!-- 详情条：选中前整条隐藏，显隐只写 IsVisible -->
        <Border Grid.Row="3" IsVisible="{Binding HasSelection}" Style="{StaticResource CardSolid}"
                Padding="{DynamicResource WPadCard}" Margin="{DynamicResource WPadCard}"
                HorizontalOptions="Fill" MaximumWidthRequest="{DynamicResource WCardWidth}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <!-- 卡片里只放得下 8 个字，全名必须在这里读得到：详情条给两行 -->
                    <Label Text="{Binding Selected.Title}" Style="{StaticResource TxtSubhead}"
                           MaxLines="2" LineBreakMode="TailTruncation" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="2">
                        <Label Grid.Row="0" Grid.Column="0" Text="分支" Style="{StaticResource TxtCaption}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Selected.BranchText}"
                               Style="{StaticResource TxtRowDesc}" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label Grid.Row="1" Grid.Column="0" Text="角色" Style="{StaticResource TxtCaption}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Selected.CharacterText}"
                               Style="{StaticResource TxtRowDesc}" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label Grid.Row="2" Grid.Column="0" Text="保存" Style="{StaticResource TxtCaption}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Selected.SavedAtText}"
                               Style="{StaticResource TxtRowDesc}" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label Grid.Row="3" Grid.Column="0" Text="父档" Style="{StaticResource TxtCaption}" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Selected.ParentText}"
                               Style="{StaticResource TxtRowDesc}" MaxLines="1" LineBreakMode="TailTruncation" />
                    </Grid>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="去这个存档" Style="{StaticResource BtnNeumorphSm}"
                        WidthRequest="108" VerticalOptions="Center"
                        Command="{Binding OpenSlotCommand}" />
            </Grid>
        </Border>
        <!-- dev 压测条：带 worst 启动参数时才出现 -->
        <dev:WorstCaseBar Grid.Row="2" />
    </Grid>
</ContentPage>
