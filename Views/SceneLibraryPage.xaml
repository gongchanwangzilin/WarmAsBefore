<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:models="clr-namespace:WarmAsBefore.Models"
             x:Class="WarmAsBefore.Views.SceneLibraryPage"
             x:Name="Page"
             x:DataType="vm:SceneLibraryViewModel"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Background="{DynamicResource GlassBarBg}" Stroke="{DynamicResource GlassBarStroke}" Padding="16,12" StrokeThickness="{DynamicResource GlassBarStrokeThickness}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="&lt; 返回" Style="{StaticResource BtnText}" FontSize="14" Padding="0"
                        Command="{Binding BackCommand}" />
                <Label Grid.Column="1" Text="场景库" Style="{StaticResource TxtTitle}" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="＋ 新建" Style="{StaticResource BtnPrimary}"
                        FontSize="13" Padding="14,6" Command="{Binding AddEntryCommand}" />
            </Grid>
        </Border>

        <!-- 主区：条目列表 + 选中详情 -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto">

            <ScrollView Grid.Row="0">
                <CollectionView ItemsSource="{Binding Entries}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedEntry}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SceneLibraryEntry">
                            <Border BackgroundColor="{DynamicResource SurfaceBg}" Padding="16,12" Margin="16,8,16,8"
                                    Stroke="{DynamicResource LineColor}" StrokeThickness="1">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Grid RowDefinitions="Auto,Auto">
                                    <Label Grid.Row="0" Text="{Binding Name}" Style="{StaticResource TxtTitle}" />
                                    <Label Grid.Row="1" Style="{StaticResource TxtMuted}" Margin="0,4,0,0"
                                           Text="{Binding MapSceneRef, StringFormat='地图引用：{0}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>

            <!-- 选中条目操作区 -->
            <Border Grid.Row="1" Background="{DynamicResource GlassBarBg}" Stroke="{DynamicResource GlassBarStroke}" Padding="16,12"
                    IsVisible="{Binding CanEdit}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <StackLayout Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Text="重命名" Style="{StaticResource BtnGhost}" FontSize="13" Padding="14,6"
                                Command="{Binding RenameEntryCommand}" />
                        <Button Text="引用地图场景" Style="{StaticResource BtnGhost}" FontSize="13" Padding="14,6"
                                Command="{Binding LinkMapSceneCommand}" />
                        <Button Text="变换规则" Style="{StaticResource BtnGhost}" FontSize="13" Padding="14,6"
                                Command="{Binding EditRulesCommand}" />
                    </StackLayout>
                    <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Text="＋ 加模式" Style="{StaticResource BtnGhost}" FontSize="13" Padding="14,6"
                                Command="{Binding AddModeCommand}" />
                        <Button Text="删除条目" Style="{StaticResource BtnDanger}" FontSize="13" Padding="14,6"
                                Command="{Binding RemoveEntryCommand}" />
                    </StackLayout>

                    <!-- 模式列表：可选中，下面的按钮作用于选中项 -->
                    <CollectionView Grid.Row="2" ItemsSource="{Binding SelectedModes}" Margin="0,12,0,0"
                                    HeightRequest="132"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedModeRow}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SceneModeRow">
                                <VerticalStackLayout Margin="0,0,0,8">
                                    <Label Text="{Binding Name}" Style="{StaticResource TxtBody}" />
                                    <Label Text="{Binding Detail}" Style="{StaticResource TxtMuted}" FontSize="11" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <StackLayout Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Text="模式名" Style="{StaticResource BtnGhost}" FontSize="12" Padding="12,5"
                                IsEnabled="{Binding CanEditMode}"
                                Command="{Binding EditModeNameCommand}"
                                CommandParameter="{Binding SelectedModeRow}" />
                        <Button Text="背景" Style="{StaticResource BtnGhost}" FontSize="12" Padding="12,5"
                                IsEnabled="{Binding CanEditMode}"
                                Command="{Binding EditModeBgCommand}"
                                CommandParameter="{Binding SelectedModeRow}" />
                        <Button Text="BGM" Style="{StaticResource BtnGhost}" FontSize="12" Padding="12,5"
                                IsEnabled="{Binding CanEditMode}"
                                Command="{Binding EditModeBgmCommand}"
                                CommandParameter="{Binding SelectedModeRow}" />
                    </StackLayout>
                    <StackLayout Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Text="灯光" Style="{StaticResource BtnGhost}" FontSize="12" Padding="12,5"
                                IsEnabled="{Binding CanEditMode}"
                                Command="{Binding EditModeLightingCommand}"
                                CommandParameter="{Binding SelectedModeRow}" />
                        <Button Text="时间区间" Style="{StaticResource BtnGhost}" FontSize="12" Padding="12,5"
                                IsEnabled="{Binding CanEditMode}"
                                Command="{Binding EditModeTimesCommand}"
                                CommandParameter="{Binding SelectedModeRow}" />
                        <Button Text="删除模式" Style="{StaticResource BtnDanger}" FontSize="12" Padding="12,5"
                                IsEnabled="{Binding CanEditMode}"
                                Command="{Binding RemoveModeCommand}"
                                CommandParameter="{Binding SelectedModeRow}" />
                    </StackLayout>
                </Grid>
            </Border>

        </Grid>

        <!-- 底部：当前生效状态（解释「AI 为什么切不动」）+ 用法提示 -->
        <VerticalStackLayout Grid.Row="2" Padding="16" Spacing="4">
            <Label Style="{StaticResource TxtBody}" FontSize="12" Text="{Binding StateText}" />
            <Label Style="{StaticResource TxtMuted}"
                   Text="场景可在地图页「单场景直接应用」；时间到点自动切换，AI 只能从「此刻可用选项」里选（无模式=仅条目）。模式写了时间区间时，只有落在区间内才能被 AI 切换。" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
