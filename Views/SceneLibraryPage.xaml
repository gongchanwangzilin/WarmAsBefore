<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:models="clr-namespace:WarmAsBefore.Models"
             x:Class="WarmAsBefore.Views.SceneLibraryPage"
             x:Name="Page"
             x:DataType="vm:SceneLibraryViewModel"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 顶部栏：与内容区同一块地，只靠底下一条发丝线分界（LineColor 是退役别名，早没人发这个键了） -->
        <Border Grid.Row="0" Background="{DynamicResource WBarBrush}" StrokeThickness="0"
                Padding="{DynamicResource WPadWell}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button Text="&lt; 返回" Style="{StaticResource BtnText}" Padding="0"
                        VerticalOptions="Center"
                        Command="{Binding BackCommand}" />
                <Label Grid.Column="1" Text="场景工坊" Style="{StaticResource TxtTitle}" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="＋ 新建" Style="{StaticResource BtnPrimary}"
                        VerticalOptions="Center"
                        Command="{Binding AddEntryCommand}" />
            </Grid>
        </Border>
        <BoxView Grid.Row="0" Style="{StaticResource HSep}" VerticalOptions="End" />

        <!-- 主区：条目列表 + 选中详情 -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="{DynamicResource WGapSection}"
              Padding="{DynamicResource WPadCard}">

            <!-- 一个场景 = 一行，全部装进同一张 CardGroup：
                 原来每条一张带描边的浮卡，卡间距比卡内间距还大，「一批场景」被读成「一摞牌子」。 -->
            <Border Grid.Row="0" Style="{StaticResource CardGroup}">
                <CollectionView ItemsSource="{Binding Entries}"
                                BackgroundColor="Transparent"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedEntry}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SceneLibraryEntry">
                            <VerticalStackLayout Spacing="0">
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource TxtRowTitle}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding MapSceneRef, StringFormat='地图引用：{0}'}"
                                                   Style="{StaticResource TxtRowDesc}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <!-- #8 点击式工坊：点一下就把当前场景切到这个条目（无需拖拽）。
                                             每行一颗实心强调钮会把整列压成「一屏全是主行动」，这里用次级档。 -->
                                        <Button Grid.Column="1" Text="应用"
                                                Style="{StaticResource BtnGhostSm}"
                                                VerticalOptions="Center" HorizontalOptions="End"
                                                Command="{Binding BindingContext.ApplyEntryCommand, Source={x:Reference Page}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                                <BoxView Style="{StaticResource HSep}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- 选中条目操作区：一块平的面板，里面的模式列表靠发丝线分行，不再套第二层卡 -->
            <Border Grid.Row="1" Style="{StaticResource CardSolid}" IsVisible="{Binding CanEdit}">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="重命名" Style="{StaticResource BtnGhostSm}"
                                Command="{Binding RenameEntryCommand}" />
                        <Button Text="引用地图场景" Style="{StaticResource BtnGhostSm}"
                                Command="{Binding LinkMapSceneCommand}" />
                        <Button Text="变换规则" Style="{StaticResource BtnGhostSm}"
                                Command="{Binding EditRulesCommand}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="＋ 加模式" Style="{StaticResource BtnGhostSm}"
                                Command="{Binding AddModeCommand}" />
                        <Button Text="删除条目" Style="{StaticResource BtnDangerSm}"
                                Command="{Binding RemoveEntryCommand}" />
                    </HorizontalStackLayout>

                    <!-- 模式列表：可选中，下面的按钮作用于选中项 -->
                    <CollectionView ItemsSource="{Binding SelectedModes}" Margin="0,4,0,0"
                                    HeightRequest="132"
                                    BackgroundColor="Transparent"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedModeRow}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SceneModeRow">
                                <VerticalStackLayout Spacing="0">
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" Style="{StaticResource TxtRowTitle}"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Detail}" Style="{StaticResource TxtRowDesc}"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <!-- #8 点击式工坊：点一下直接切到该「条目/模式」（此刻不可用也会给出原因）。 -->
                                            <Button Grid.Column="1" Text="应用"
                                                    Style="{StaticResource BtnGhostSm}"
                                                    VerticalOptions="Center" HorizontalOptions="End"
                                                    Command="{Binding BindingContext.ApplyModeCommand, Source={x:Reference Page}}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                    <BoxView Style="{StaticResource HSep}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="模式名" Style="{StaticResource BtnGhostSm}"
                                IsEnabled="{Binding CanEditMode}"
                                Command="{Binding EditModeNameCommand}"
                                CommandParameter="{Binding SelectedModeRow}" />
                        <Button Text="背景" Style="{StaticResource BtnGhostSm}"
                                IsEnabled="{Binding CanEditMode}"
                                Command="{Binding EditModeBgCommand}"
                                CommandParameter="{Binding SelectedModeRow}" />
                        <Button Text="BGM" Style="{StaticResource BtnGhostSm}"
                                IsEnabled="{Binding CanEditMode}"
                                Command="{Binding EditModeBgmCommand}"
                                CommandParameter="{Binding SelectedModeRow}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="灯光" Style="{StaticResource BtnGhostSm}"
                                IsEnabled="{Binding CanEditMode}"
                                Command="{Binding EditModeLightingCommand}"
                                CommandParameter="{Binding SelectedModeRow}" />
                        <Button Text="时间区间" Style="{StaticResource BtnGhostSm}"
                                IsEnabled="{Binding CanEditMode}"
                                Command="{Binding EditModeTimesCommand}"
                                CommandParameter="{Binding SelectedModeRow}" />
                        <Button Text="删除模式" Style="{StaticResource BtnDangerSm}"
                                IsEnabled="{Binding CanEditMode}"
                                Command="{Binding RemoveModeCommand}"
                                CommandParameter="{Binding SelectedModeRow}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </Grid>

        <!-- 底部：当前生效状态（解释「AI 为什么切不动」）+ 用法提示，直接落在地上 -->
        <VerticalStackLayout Grid.Row="2" Padding="{DynamicResource WPadCard}" Spacing="4">
            <Label Style="{StaticResource TxtBodySm}" Text="{Binding StateText}" />
            <Label Style="{StaticResource TxtMuted}" LineBreakMode="WordWrap"
                   Text="点条目或模式右侧的「应用」即可立刻切换当前场景（点击式，无需拖拽）；切换结果与此刻可用性会显示在上方状态栏。时间到点自动切换，AI 只能从「此刻可用选项」里选（无模式=仅条目）。模式写了时间区间时，只有落在区间内才能被 AI 切换。" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
