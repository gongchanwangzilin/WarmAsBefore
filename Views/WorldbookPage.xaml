<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:models="clr-namespace:WarmAsBefore.Models"
             x:Class="WarmAsBefore.Views.WorldbookPage"

             Title="世界书"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header：眉栏是同一块地上的一条，不是浮起来的一张卡；底下用发丝线收住 -->
        <VerticalStackLayout Spacing="0">
            <Border Background="{DynamicResource WBarBrush}" StrokeThickness="0" Padding="{DynamicResource WPadRow}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Button Text="&lt; 返回" Style="{StaticResource BtnText}" FontSize="{DynamicResource WSizeSmall}"
                            Padding="0" Command="{Binding GoBackCommand}" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                        <Label Text="世界书" Style="{StaticResource TxtTitle}" />
                        <Label Text="{Binding StatusText}" Style="{StaticResource TxtCaption}" />
                    </VerticalStackLayout>
                    <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsThinking}"
                                       IsVisible="{Binding IsThinking}" Color="{DynamicResource PrimaryAction}"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                </Grid>
            </Border>
            <BoxView Style="{StaticResource HSep}" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="{DynamicResource WGapSection}" Padding="{DynamicResource WPadCard}">

                <!-- 描述你的世界：输入 + 两个开关 + 主行动，本来就是「一件事的几条内容」，
                     因此是一张卡里的四行，控件一律靠右、垂直居中 -->
                <Border Style="{StaticResource CardGroup}">
                    <VerticalStackLayout Spacing="0">
                        <Border Style="{StaticResource SettingRow}">
                            <Label Text="描述你的世界" Style="{StaticResource TxtRowTitle}" />
                        </Border>
                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Editor Text="{Binding Description}"
                                    Placeholder="描述你想要的世界观、角色、剧情…"
                                    PlaceholderColor="{DynamicResource MutedFg}"
                                    BackgroundColor="{DynamicResource InputBg}"
                                    TextColor="{DynamicResource SurfaceFg}"
                                    FontSize="{DynamicResource WSizeBody}" HeightRequest="100" />
                        </Border>
                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="生成封面" Style="{StaticResource TxtRowTitle}"
                                       VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding GenerateCover}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="模式" Style="{StaticResource TxtRowTitle}"
                                       VerticalOptions="Center" />
                                <Picker Grid.Column="1" ItemsSource="{Binding ModeChoices}"
                                        SelectedItem="{Binding Mode}" FontSize="{DynamicResource WSizeSmall}"
                                        WidthRequest="160" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 主行动留在卡外：卡内只放「读与改」，动手的那一颗不参与分组 -->
                <Button Text="生成世界书" Command="{Binding GenerateCommand}"
                        Style="{StaticResource BtnNeumorphAccent}" />

                <!-- Result -->
                <Border x:Name="ResultPanel" IsVisible="{Binding Result}"
                        Style="{StaticResource CardGroup}">
                    <VerticalStackLayout Spacing="0">
                        <Border Style="{StaticResource SettingRow}">
                            <Label Text="{Binding Result.Worldbook.Title}" Style="{StaticResource TxtTitle}"
                                   LineBreakMode="WordWrap" />
                        </Border>
                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Label Text="{Binding Result.Worldbook.Description}" Style="{StaticResource TxtBody}"
                                   LineBreakMode="WordWrap" />
                        </Border>
                        <!-- 封面是图不是行，铺到卡边；行式卡片只装文字条目 -->
                        <Image Source="{Binding Result.CoverImagePath}"
                               IsVisible="{Binding Result.CoverGenerated}"
                               Aspect="AspectFill" HeightRequest="200" />

                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Label Text="角色" Style="{StaticResource TxtRowTitle}" />
                        </Border>
                        <CollectionView ItemsSource="{Binding Result.Worldbook.Characters}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:WorldbookCharacter">
                                    <VerticalStackLayout Spacing="0">
                                        <BoxView Style="{StaticResource HSep}" />
                                        <Border Style="{StaticResource SettingRow}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding Name}" Style="{StaticResource TxtRowTitle}" />
                                                    <Label Text="{Binding Description}" Style="{StaticResource TxtBody}"
                                                           LineBreakMode="WordWrap" />
                                                    <Label Text="{Binding Personality}" Style="{StaticResource TxtRowDesc}"
                                                           LineBreakMode="WordWrap" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <BoxView Style="{StaticResource HSep}" />
                        <Border Style="{StaticResource SettingRow}">
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Button Text="润色" Command="{Binding PolishCommand}"
                                        Style="{StaticResource BtnNeumorphSm}" />
                                <Button Text="转为纯文字" Command="{Binding ConvertToTextOnlyCommand}"
                                        Style="{StaticResource BtnNeumorphSm}" />
                                <Button Text="转立绘模式" Command="{Binding ConvertToSpriteModeCommand}"
                                        Style="{StaticResource BtnNeumorphSm}" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
