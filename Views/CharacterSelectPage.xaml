<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.CharacterSelectPage"
             x:Name="Page"
             x:DataType="vm:CharacterSelectViewModel"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- 微信式顶部栏：返回 + 「微信」标题 + 新建 -->
        <Border BackgroundColor="#2E2E2E" StrokeThickness="0" Padding="12,12,12,12">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button Text="&lt;" Style="{StaticResource BtnText}"
                        TextColor="White" FontSize="20" Padding="0" WidthRequest="28"
                        Command="{Binding BackCommand}" />
                <Label Grid.Column="1" Text="微信" TextColor="White" FontSize="17"
                       FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="2" Text="＋" Style="{StaticResource BtnText}"
                        TextColor="White" FontSize="22" Padding="0" WidthRequest="28"
                        Command="{Binding CreateCharacterCommand}" />
            </Grid>
        </Border>

        <!-- 联系人列表：头像 + 名字 + 副标题（性格/存档） -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Cards}"
                        Margin="0,4,0,0" SelectionMode="None"
                        BackgroundColor="{DynamicResource SurfaceBg}">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="12" Padding="32">
                    <Border BackgroundColor="{DynamicResource SurfaceBg}"
                            StrokeThickness="1" Stroke="{DynamicResource BorderLine}"
                            WidthRequest="96" HeightRequest="96">
                        <Border.StrokeShape><RoundRectangle CornerRadius="48" /></Border.StrokeShape>
                        <Label Text="💬" FontSize="40"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="还没有联系人" Style="{StaticResource TxtTitle}"
                           HorizontalOptions="Center" />
                    <Label Text="新建一个 TA，或导入角色包开始聊天" Style="{StaticResource TxtMuted}"
                           HorizontalOptions="Center" FontSize="13" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CharacterCardItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                          Padding="16,10" BackgroundColor="{DynamicResource SurfaceBg}">
                        <!-- 圆形头像 -->
                        <Border BackgroundColor="{DynamicResource BeigeAccent50}"
                                WidthRequest="48" HeightRequest="48"
                                StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Image Source="{Binding AvatarSource}" Aspect="AspectFill"
                                   IsVisible="{Binding HasAvatar}"
                                   HorizontalOptions="Fill" VerticalOptions="Fill" />
                            <Label Text="{Binding Name, Converter={StaticResource CharInitials}}"
                                   TextColor="White" FontSize="18"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   FontAttributes="Bold"
                                   IsVisible="{Binding HasAvatar, Converter={StaticResource InverseBool}}" />
                        </Border>
                        <!-- 名字 + 副标题 -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource SurfaceFg}" />
                            <Label Text="{Binding Subtitle}" FontSize="12"
                                   TextColor="{DynamicResource MutedFg}"
                                   LineBreakMode="TailTruncation" MaxLines="1" />
                        </VerticalStackLayout>
                        <!-- 右侧：存档时间 -->
                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center"
                                             HorizontalOptions="End" Spacing="3">
                            <Label Text="{Binding SavesLabel}" FontSize="10"
                                   TextColor="{DynamicResource WarmMuted}"
                                   HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.PickCommand}"
                                                  CommandParameter="{Binding Id}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom bar: 新建 / 导入 -->
        <Border Grid.Row="2" Background="{DynamicResource PageBgBrush}" Padding="16,10,16,16"
                StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="新建角色" Style="{StaticResource BtnNeumorph}"
                        HeightRequest="44" FontSize="13"
                        Command="{Binding CreateCharacterCommand}" />
                <Button Grid.Column="1" Text="导入角色包" Style="{StaticResource BtnNeumorph}"
                        HeightRequest="44" FontSize="13"
                        Command="{Binding ImportCharacterCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>