<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.CharacterSelectPage"
             x:Name="Page"
             x:DataType="vm:CharacterSelectViewModel"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource WcPageBg}">

    <!--
      微信壳 · 联系人/会话列表（移动端观感，白 + 蓝）。
      品牌色一律 Wc*（WeChatBrand.xaml），静态、不随四套风格世界与明暗档走 ——
      这里模仿的是「微信本身」，不是软件自己的界面。
      版式：白底 · 顶部白条（返回 + 居中标题「微信」+ 新建）· 白行 + 发丝分隔 · 头像左置。
      分隔与头像面用 BoxView（编译模板里 Border+DynamicResource 有 XamlC 坑，这里直接静态色最稳）。
    -->
    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- 顶栏：白条 + 深色字，微信移动端的消息列表头 -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
              BackgroundColor="{StaticResource WcHeader}" Padding="14,14,14,14">
            <Button Text="&lt;" Style="{StaticResource BtnText}" TextColor="{StaticResource WcInk}"
                    FontSize="20" Padding="0" WidthRequest="30" Command="{Binding BackCommand}" />
            <Label Grid.Column="1" Text="微信" Style="{StaticResource TxtTitle}"
                   TextColor="{StaticResource WcInk}"
                   VerticalOptions="Center" HorizontalOptions="Center" />
            <Button Grid.Column="2" Text="＋" Style="{StaticResource BtnText}" TextColor="{StaticResource WcInk}"
                    FontSize="20" Padding="0" WidthRequest="30"
                    Command="{Binding AddMenuCommand}" />
        </Grid>
        <BoxView HeightRequest="1" Color="{StaticResource WcSep}" />

        <!-- 联系人/会话列表：一行一个角色 = 一个「好友」，白行 + 发丝线 -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Cards}"
                        SelectionMode="None" BackgroundColor="Transparent">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="10" Padding="32">
                    <Grid WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                        <BoxView WidthRequest="64" HeightRequest="64" CornerRadius="32"
                                 Color="{StaticResource WcAvatar}" InputTransparent="True" />
                        <Label Text="💬" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="还没有微信好友" Style="{StaticResource TxtTitle}"
                           TextColor="{StaticResource WcSub}" HorizontalOptions="Center" />
                    <Label Text="让 AI 用「add_wechat」把剧情里的角色加为好友，或下方新建/导入"
                           Style="{StaticResource TxtMuted}" TextColor="{StaticResource WcFaint}"
                           FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CharacterCardItem">
                    <VerticalStackLayout Spacing="0">
                        <Border BackgroundColor="{StaticResource WcRow}" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.PickCommand}"
                                                      CommandParameter="{Binding Id}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <!-- 头像：无图时浅灰圆片 + 首字 -->
                                <Grid Grid.Column="0" WidthRequest="48" HeightRequest="48">
                                    <BoxView WidthRequest="48" HeightRequest="48" CornerRadius="24"
                                             Color="{StaticResource WcAvatar}" InputTransparent="True" />
                                    <Image Source="{Binding AvatarSource}" Aspect="AspectFill"
                                           WidthRequest="48" HeightRequest="48"
                                           IsVisible="{Binding HasAvatar}"
                                           HorizontalOptions="Fill" VerticalOptions="Fill" />
                                    <Label Text="{Binding Name, Converter={StaticResource CharInitials}}"
                                           TextColor="{StaticResource WcInk}" FontSize="18" FontAttributes="Bold"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           IsVisible="{Binding HasAvatar, Converter={StaticResource InverseBool}}" />
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="{Binding Name}" TextColor="{StaticResource WcInk}"
                                           FontSize="17" FontAttributes="Bold" />
                                    <Label Text="{Binding Subtitle}" TextColor="{StaticResource WcSub}"
                                           FontSize="13" LineBreakMode="TailTruncation" MaxLines="1" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding SavesLabel}"
                                       TextColor="{StaticResource WcFaint}" FontSize="12"
                                       VerticalOptions="Center" HorizontalTextAlignment="End" />
                            </Grid>
                        </Border>
                        <!-- 行末发丝线：微信列表就是「白行 + 一条浅灰线」 -->
                        <BoxView HeightRequest="1" Color="{StaticResource WcSep}" Margin="64,0,0,0" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 底部：新建 / 导入，微信白+蓝按钮 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10"
              BackgroundColor="{StaticResource WcPageBg}" Padding="14,12,14,16">
            <BoxView HeightRequest="1" Color="{StaticResource WcSep}" VerticalOptions="Start" />
            <Button Text="＋ 新建角色"
                    BackgroundColor="{StaticResource WcAccent}" TextColor="{StaticResource WcAccentInk}"
                    CornerRadius="22" HeightRequest="44" FontAttributes="Bold"
                    Command="{Binding CreateCharacterCommand}" />
            <Button Grid.Column="1" Text="📥 导入角色包"
                    BackgroundColor="{StaticResource WcAccentSoft}" TextColor="{StaticResource WcAccent}"
                    CornerRadius="22" HeightRequest="44"
                    Command="{Binding ImportCharacterCommand}" />
        </Grid>
    </Grid>
</ContentPage>
