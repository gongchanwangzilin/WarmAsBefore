<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.CharacterSelectPage"
             x:Name="Page"
             x:DataType="vm:CharacterSelectViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- Header -->
        <Border BackgroundColor="{StaticResource SurfaceBg}" Padding="16,12,16,12"
                StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="&lt; 返回" Style="{StaticResource BtnText}"
                        FontSize="14" Padding="0"
                        Command="{Binding BackCommand}" />
                <Label Grid.Column="1" Text="选择角色" Style="{StaticResource TxtTitle}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Roster -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Cards}"
                        Margin="24,16,24,0" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="12" Padding="32">
                    <Border BackgroundColor="{StaticResource SurfaceBg}"
                            StrokeThickness="1" Stroke="{StaticResource BorderLine}"
                            WidthRequest="96" HeightRequest="96">
                        <Border.StrokeShape><RoundRectangle CornerRadius="48" /></Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource ShadowDim}"
                                    Offset="4,4" Radius="12" Opacity="0.3" />
                        </Border.Shadow>
                        <Label Text="♡" TextColor="{StaticResource WarmFaint}" FontSize="40"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="还没有角色" Style="{StaticResource TxtTitle}"
                           HorizontalOptions="Center" />
                    <Label Text="新建一个 TA，或导入角色包开始故事" Style="{StaticResource TxtMuted}"
                           HorizontalOptions="Center" FontSize="13" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CharacterCardItem">
                    <Border Style="{StaticResource CardNeumorph}" Margin="0,0,0,14"
                            Padding="16,14">
                        <Grid ColumnDefinitions="72,*" ColumnSpacing="16">
                            <Border BackgroundColor="{StaticResource BeigeAccent50}"
                                    WidthRequest="64" HeightRequest="64"
                                    StrokeThickness="1" Stroke="{StaticResource BorderLine}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="32" /></Border.StrokeShape>
                                <Image Source="{Binding AvatarSource}" Aspect="AspectFill"
                                       IsVisible="{Binding HasAvatar}"
                                       HorizontalOptions="Fill" VerticalOptions="Fill" />
                                <Label Text="{Binding Name, Converter={StaticResource CharInitials}}"
                                       TextColor="{StaticResource WarmDark}" FontSize="24"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       FontAttributes="Bold"
                                       IsVisible="{Binding HasAvatar, Converter={StaticResource InverseBool}}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Name}" Style="{StaticResource TxtSubhead}" />
                                <Label Text="{Binding Personality}" Style="{StaticResource TxtCaption}" />
                                <Label Text="{Binding SavesLabel}" Style="{StaticResource TxtCaption}"
                                       TextColor="{StaticResource BeigeAccent300}" FontSize="11" />
                            </VerticalStackLayout>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.PickCommand}"
                                                  CommandParameter="{Binding Id}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom bar: new / import character -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource PageBg}" Padding="16,10,16,16"
                StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="新建角色" Style="{StaticResource BtnNeumorph}"
                        HeightRequest="44" FontSize="13"
                        Command="{Binding CreateCharacterCommand}" />
                <Button Grid.Column="1" Text="导入角色包" Style="{StaticResource BtnNeumorph}"
                        HeightRequest="44" FontSize="13"
                        Command="{Binding ImportCharacterCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
