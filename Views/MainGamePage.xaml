<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:motion="clr-namespace:WarmAsBefore.Helpers" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:ctl="clr-namespace:WarmAsBefore.Controls"
xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
xmlns:model="clr-namespace:WarmAsBefore.Models"
             x:Class="WarmAsBefore.Views.MainGamePage"
             x:Name="GameRoot"

             Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <!-- 半透明米白渐变：让全局磨砂叠层透出来，形成「磨砂玻璃底」 -->
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6FBF7F0" Offset="0.0" />
            <GradientStop Color="#D9F3EDE0" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <!-- 玻璃是「表面材质」：卡片 / 按钮 / 上下栏 / 弹窗的样式引用
             GlassTokens 下发的 {DynamicResource ...} 画刷（见 DesignSystem/Theme/GlassTokens.cs）。
             这里不再有任何整页叠加层 —— 那层既挡点击、压对比度，又要在每次交互时重绘。 -->



        <!-- ============ Phone Layout (vertical) ============
             手机竖版整块搬进了 MainGamePhoneView：Windows 上这块永远不显示，却会和桌面版
             一起建完（两条 MediaElement、两个 CollectionView 与两百来颗控件）——
             进存档那一秒的卡顿有一大半在这里。现在只在 VM 判定为手机版时由代码挂进来
             （见 MainGamePage.xaml.cs），桌面上这里只占一颗空的 ContentView。 -->
        <ContentView x:Name="PhoneHost" IsVisible="{Binding IsPhoneLayout}" />

        <!-- ============ Desktop Layout (horizontal) ============
             仅桌面显示；手机/平板都不显（平板走上面的手机主题布局） -->
        <Grid IsVisible="{Binding IsDesktopLayout}"
              RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="Auto,*,Auto" Padding="0">
            <!-- Status bar（液态玻璃材质：半透明渐变 + 1px 内发光描边）；#E4：ESC 可隐藏 -->
            <Border Grid.ColumnSpan="3" Style="{StaticResource CardLiquidGlass}"
                    IsVisible="{Binding HideDesktopPanels, Converter={StaticResource InverseBool}}"
                    Padding="16,8,16,10">
                <Border.StrokeShape><RoundRectangle CornerRadius="0,0,16,16" /></Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <Label Text="{Binding CurrentTimeStr}" TextColor="{DynamicResource WarmDark}" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label Text="{Binding DateLabel}" TextColor="{DynamicResource MutedFg}" FontSize="10" />
                        <Label Text="{Binding WeatherDesc}" TextColor="{DynamicResource MutedFg}" FontSize="10" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{Binding LocationLabel}" TextColor="{DynamicResource SurfaceFg}" FontSize="12" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <Border Grid.Column="3" BackgroundColor="{DynamicResource AccentWarm}" StrokeThickness="0" Padding="10,4" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Label Text="{Binding Energy, StringFormat='精力 {0}%'}" TextColor="{DynamicResource AccentWarmFg}" FontSize="11" FontAttributes="Bold" />
                    </Border>
                    <!-- 同手机版：只留「正在玩」的动作，配置世界的页面走手机桌面 -->
                    <Button Grid.Column="4" Text="存档" TextColor="{DynamicResource SurfaceFg}" BackgroundColor="#B8FDF8F0" FontSize="12" Padding="8,0" CornerRadius="16" HeightRequest="32" MinimumWidthRequest="0" Command="{Binding QuickSaveCommand}" />
                    <Button Grid.Column="5" Text="菜单" TextColor="{DynamicResource SurfaceFg}" BackgroundColor="#B8FDF8F0" FontSize="12" Padding="8,0" CornerRadius="16" HeightRequest="32" MinimumWidthRequest="0" Command="{Binding ToggleMenuCommand}" />
                    <Button Grid.Column="6" Text="手机" TextColor="{DynamicResource SurfaceFg}" BackgroundColor="#B8FDF8F0" FontSize="12" Padding="8,0" CornerRadius="16" HeightRequest="32" MinimumWidthRequest="0" Command="{Binding OpenPhoneCommand}" />
                    <Button Grid.Column="7" Text="{Binding MapButtonText}" TextColor="{DynamicResource SurfaceFg}" BackgroundColor="#B8FDF8F0" FontSize="12" Padding="8,0" CornerRadius="16" HeightRequest="32" MinimumWidthRequest="0" Command="{Binding OpenMapCommand}" />
                    <!-- 临时指定这次由哪个 AI 回答（不动全局设置；指定后按钮高亮） -->
                    <Button Grid.Column="8" Text="AI" TextColor="{DynamicResource SurfaceFg}" FontSize="12" Padding="8,0" CornerRadius="16" HeightRequest="32" MinimumWidthRequest="0"
                            BackgroundColor="{Binding HasTemporaryAi, Converter={StaticResource SelectedBg}}"
                            Command="{Binding PickAnswerAiCommand}" ToolTipProperties.Text="{Binding AnswerAiLabel}" />
                </Grid>
            </Border>

            <!-- Left: Info panel（窄屏下允许压缩，避免与状态栏按钮挤压）；#E4：ESC 可隐藏 -->
            <Border Grid.Row="1" Style="{StaticResource CardLiquidGlass}" WidthRequest="180" MinimumWidthRequest="140" Margin="0"
                    IsVisible="{Binding HideDesktopPanels, Converter={StaticResource InverseBool}}">
                <Border.StrokeShape><RoundRectangle CornerRadius="0,0,16,16" /></Border.StrokeShape>
                <VerticalStackLayout Padding="12,16" Spacing="16">
                    <Label Text="信息" TextColor="{DynamicResource SurfaceFg}" FontSize="14" FontAttributes="Bold" />
                    <VerticalStackLayout Spacing="4">
                        <Label TextColor="{DynamicResource MutedFg}" FontSize="11">当前位置</Label>
                        <Label Text="{Binding LocationLabel}" TextColor="{DynamicResource SurfaceFg}" FontSize="16" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label TextColor="{DynamicResource MutedFg}" FontSize="11">好感度</Label>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <ProgressBar Progress="{Binding AffectionPct}" ProgressColor="{DynamicResource AccentWarm}" BackgroundColor="{DynamicResource BeigeAccent100}" HeightRequest="6" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Affection, StringFormat='{0}/100'}" TextColor="{DynamicResource SurfaceFg}" FontSize="11" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label TextColor="{DynamicResource MutedFg}" FontSize="11">好感等级</Label>
                        <Label Text="{Binding AffectionLevelLabel}" TextColor="{DynamicResource AccentWarmFg}" FontSize="13" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <!-- 大脑预判：一句话读出 TA 现在什么心情（总开关关着整行隐藏） -->
                    <VerticalStackLayout Spacing="2" IsVisible="{Binding BrainVisible}">
                        <Label TextColor="{DynamicResource MutedFg}" FontSize="11">TA 的心情</Label>
                        <Label Text="{Binding BrainStatusText}" TextColor="{DynamicResource AccentWarmFg}" FontSize="12" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label TextColor="{DynamicResource MutedFg}" FontSize="11">信任度</Label>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <ProgressBar Progress="{Binding TrustPct}" ProgressColor="{DynamicResource PrimaryAction}" BackgroundColor="{DynamicResource BeigeAccent100}" HeightRequest="6" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Trust, StringFormat='{0}/100'}" TextColor="{DynamicResource SurfaceFg}" FontSize="11" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label TextColor="{DynamicResource MutedFg}" FontSize="11">精力</Label>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <ProgressBar Progress="{Binding EnergyPct}" ProgressColor="{DynamicResource AccentWarm}" BackgroundColor="{DynamicResource BeigeAccent100}" HeightRequest="6" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Energy, StringFormat='{0}/100'}" TextColor="{DynamicResource SurfaceFg}" FontSize="11" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label TextColor="{DynamicResource MutedFg}" FontSize="11">余额</Label>
                        <Label Text="{Binding Balance, StringFormat='¤ {0}'}" TextColor="{DynamicResource AccentWarmFg}" FontSize="14" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Center: Character area -->
            <Grid Grid.Row="1" Grid.Column="1" x:Name="DesktopStage" SizeChanged="OnStageSizeChanged">
                <BoxView Color="{Binding StageBackdropFill}" />
                <Image Source="{Binding SceneBackdrop}" Aspect="AspectFill" IsVisible="{Binding SceneBackdrop, Converter={StaticResource IsNotNull}}" Opacity="0.55" />
                <toolkit:MediaElement x:Name="SceneVideoDesktop"
                                      Source="{Binding SceneVideoPath}"
                                      IsVisible="{Binding SceneVideoOn}"
                                      Aspect="AspectFill" Opacity="0.55"
                                      ShouldAutoPlay="True" ShouldLoopPlayback="True"
                                      HorizontalOptions="Fill" VerticalOptions="Fill" />
                <!-- 场景亮度遮罩（同手机版说明） -->
                <BoxView Color="Black" Opacity="{Binding SceneDim}" InputTransparent="True"
                         HorizontalOptions="Fill" VerticalOptions="Fill" />
                <!-- 天气特效帧层 + 打雷白闪层（同手机版说明） -->
                <Image Source="{Binding WeatherFxImage}" IsVisible="{Binding WeatherFxVisible}"
                       Aspect="AspectFill" InputTransparent="True"
                       HorizontalOptions="Fill" VerticalOptions="Fill" />
                <BoxView Color="White" Opacity="{Binding FlashOpacity}" InputTransparent="True"
                         HorizontalOptions="Fill" VerticalOptions="Fill" />
                <!-- 立绘支持位置、透明度、缩放；尺寸由 VM 按标定显式给出（见手机版同处说明） -->
                <Image Source="{Binding SpriteSource}" IsVisible="{Binding SpriteVisible}"
                       Aspect="AspectFit"
                       WidthRequest="{Binding SpriteFitW}"
                       HeightRequest="{Binding SpriteFitH}"
                       Opacity="{Binding SpriteOpacity}"
                       TranslationX="{Binding SpriteX}"
                       TranslationY="{Binding SpriteY}"
                       Scale="{Binding SpriteScale}"
                       ScaleX="{Binding SpriteFlipScaleX}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border BackgroundColor="{DynamicResource SurfaceBg}" Opacity="0.7" Stroke="{DynamicResource WSepBrush}" StrokeThickness="1" WidthRequest="280" HeightRequest="360" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding NoSpriteVisible}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <Label Text="🎭" FontSize="64" HorizontalOptions="Center" />
                        <Label Text="{Binding CharacterName}" TextColor="{DynamicResource MutedFg}" FontSize="24" HorizontalOptions="Center" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border IsVisible="{Binding SpriteVisible}" BackgroundColor="#D9FDF8F0" StrokeThickness="1" Stroke="{DynamicResource WSepBrush}" Padding="18,6" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <Label Text="{Binding CharacterName}" TextColor="{DynamicResource SurfaceFg}" FontSize="16" FontAttributes="Bold" />
                </Border>

                <!-- #9 左右竖条切换地点按键（电脑端同样提供，与键盘方向键、手机滑动共用命令）。
                     无地点时置灰：IsEnabled 绑可用态。 -->
                <Button Text="◀"
                        Command="{Binding PrevSceneCommand}"
                        IsEnabled="{Binding CanGoPrevScene}"
                        ToolTipProperties.Text="{Binding PrevSceneLabel}"
                        BackgroundColor="#CCFDF8F0" TextColor="{DynamicResource SurfaceFg}"
                        FontSize="18" WidthRequest="44" HeightRequest="120" Padding="0"
                        CornerRadius="16" HorizontalOptions="Start" VerticalOptions="Center"
                        Margin="10,0,0,0" />
                <Button Text="▶"
                        Command="{Binding NextSceneCommand}"
                        IsEnabled="{Binding CanGoNextScene}"
                        ToolTipProperties.Text="{Binding NextSceneLabel}"
                        BackgroundColor="#CCFDF8F0" TextColor="{DynamicResource SurfaceFg}"
                        FontSize="18" WidthRequest="44" HeightRequest="120" Padding="0"
                        CornerRadius="16" HorizontalOptions="End" VerticalOptions="Center"
                        Margin="0,0,10,0" />

                <!-- #9 用户可选跟上：AI 单独出行后出现。 -->
                <Button Text="{Binding PendingFollowSceneName, StringFormat='跟上到 {0}'}"
                        Command="{Binding FollowAiCommand}"
                        IsVisible="{Binding CanFollowAi}"
                        BackgroundColor="{DynamicResource AccentWarm}" TextColor="{DynamicResource AccentWarmFg}"
                        FontSize="12" Padding="14,4" CornerRadius="16" HeightRequest="34"
                        HorizontalOptions="End" VerticalOptions="Start" Margin="0,16,16,0" />

                <!-- AI 主动黑屏：只黑舞台，右侧对话面板照常可用 -->
                <Grid IsVisible="{Binding IsBlackout}" BackgroundColor="Black">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="（黑屏）" TextColor="#66FFFFFF" FontSize="15" HorizontalOptions="Center" />
                        <Label Text="{Binding BlackoutReason}" TextColor="#99FFFFFF" FontSize="12"
                               HorizontalOptions="Center" LineBreakMode="WordWrap" MaximumWidthRequest="360"
                               IsVisible="{Binding BlackoutReason, Converter={StaticResource IsNotNull}}" />
                        <Button Text="退出黑屏" FontSize="12" Padding="12,4"
                                Command="{Binding ExitBlackoutCommand}"
                                BackgroundColor="#33FFFFFF" TextColor="White" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- Right: Mini-game chat panel（仅桌面显示；手机/平板竖屏时隐藏，给立绘让空间） -->
            <Border Grid.Row="1" Grid.Column="2" BackgroundColor="#D9FCF8F0" WidthRequest="300" StrokeThickness="0"
                    IsVisible="{Binding IsRightPanelVisible}">
                <Border.StrokeShape><RoundRectangle CornerRadius="16,0,0,16" /></Border.StrokeShape>
                <Grid RowDefinitions="Auto,*,Auto" Padding="14,14">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Button Text="摸摸头" TextColor="{DynamicResource SurfaceFg}" BackgroundColor="{DynamicResource SurfaceBg}" FontSize="11" Padding="12,0" CornerRadius="16" HeightRequest="34" Command="{Binding HeadpatCommand}" />
                        <Button Text="抱抱" TextColor="{DynamicResource SurfaceFg}" BackgroundColor="{DynamicResource SurfaceBg}" FontSize="11" Padding="12,0" CornerRadius="16" HeightRequest="34" Command="{Binding HugCommand}" />
                        <Button Text="亲吻" TextColor="{DynamicResource SurfaceFg}" BackgroundColor="{DynamicResource SurfaceBg}" FontSize="11" Padding="12,0" CornerRadius="16" HeightRequest="34" Command="{Binding KissCommand}" />
                        <Button Text="{Binding GalgameModeLabel}" TextColor="{DynamicResource AccentWarmFg}" BackgroundColor="{DynamicResource SurfaceBg}" FontSize="12" Padding="12,0" CornerRadius="16" HeightRequest="34" Command="{Binding ToggleGalgameModeCommand}" />
                    </HorizontalStackLayout>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding Messages}" ItemsUpdatingScrollMode="KeepLastItemInView" Margin="0,8" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DialogueMessage">
                                <Grid Padding="0,3">
                                    <Border IsVisible="{Binding ShowBubbleMine}" BackgroundColor="{DynamicResource BubbleMine}" StrokeThickness="0" Padding="12,8" HorizontalOptions="End" MaximumWidthRequest="250">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="14,14,4,14" /></Border.StrokeShape>
                                        <Label Text="{Binding Text}" TextColor="{DynamicResource SurfaceFg}" FontSize="13" LineBreakMode="WordWrap" />
                                    </Border>
                                    <Border IsVisible="{Binding ShowBubbleTheirs}" BackgroundColor="{DynamicResource BubbleTheirs}" Stroke="{DynamicResource WSepBrush}" StrokeThickness="1" Padding="12,8" HorizontalOptions="Start" MaximumWidthRequest="250">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="14,14,14,4" /></Border.StrokeShape>
                                        <Label Text="{Binding Text}" TextColor="{DynamicResource SurfaceFg}" FontSize="13" LineBreakMode="WordWrap" />
                                    </Border>
                                    <!-- #12 表情消息：图片形态（我发的靠右 / TA 发的靠左） -->
                                    <Image IsVisible="{Binding ShowStickerMine}" Source="{Binding StickerPath}"
                                           Aspect="AspectFit" HeightRequest="110" WidthRequest="110" HorizontalOptions="End" />
                                    <Image IsVisible="{Binding ShowStickerTheirs}" Source="{Binding StickerPath}"
                                           Aspect="AspectFit" HeightRequest="110" WidthRequest="110" HorizontalOptions="Start" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Border Grid.Row="2" BackgroundColor="{DynamicResource SurfaceBg}" StrokeThickness="1" Stroke="{DynamicResource WSepBrush}" Padding="10,0" Margin="0,4,0,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <Entry Text="{Binding InputText}" Placeholder="输入..." PlaceholderColor="{DynamicResource MutedFg}" BackgroundColor="Transparent" TextColor="{DynamicResource SurfaceFg}" FontSize="13" ReturnCommand="{Binding SendMessageCommand}" HeightRequest="36" />
                            <Button Grid.Column="1" Text="文件" TextColor="{DynamicResource MutedFg}" BackgroundColor="Transparent" FontSize="11" Padding="2,0" HeightRequest="36" WidthRequest="40" Command="{Binding PickAttachmentCommand}" />
                            <Button Grid.Column="2" Text="表情" TextColor="{DynamicResource MutedFg}" BackgroundColor="Transparent" FontSize="11" Padding="2,0" HeightRequest="36" WidthRequest="40" Command="{Binding SendStickerCommand}" />
                            <Button Grid.Column="3" Text="🎁" TextColor="{DynamicResource MutedFg}" BackgroundColor="Transparent" FontSize="12" Padding="2,0" HeightRequest="36" WidthRequest="32" Command="{Binding ToggleGiftPanelCommand}" />
                            <Button Grid.Column="4" Text="语音" TextColor="{DynamicResource MutedFg}" BackgroundColor="Transparent" FontSize="11" Padding="4,0" HeightRequest="36" Command="{Binding VoiceInputCommand}" />
                            <Button Grid.Column="5" Text="发送" BackgroundColor="{DynamicResource AccentWarm}" TextColor="{DynamicResource AccentWarmFg}" FontSize="12" FontAttributes="Bold" CornerRadius="18" HeightRequest="36" WidthRequest="52" Padding="0" Command="{Binding SendMessageCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============ Galgame Panel (半透明覆盖在角色上) ============ -->
            <Border Grid.Row="1" Grid.Column="1"
                    IsVisible="{Binding IsGalgamePanelVisible}"
                    BackgroundColor="#CCFDF8F0"
                    Padding="16,12" StrokeThickness="1" Stroke="{DynamicResource WSepBrush}"
                    VerticalOptions="End" Margin="0,0,0,12"
                    HorizontalOptions="Fill"
                    HeightRequest="180">
                <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource ShadowDim}" Offset="0,-4" Radius="12" Opacity="0.3" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <!-- 标题栏：角色名 + 模式切换 -->
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Border BackgroundColor="{DynamicResource AccentWarm}" StrokeThickness="0"
                                Padding="10,4" HorizontalOptions="Start">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Label Text="{Binding CharacterName}" TextColor="{DynamicResource AccentWarmFg}"
                                   FontSize="13" FontAttributes="Bold" />
                        </Border>
                        <Button Text="{Binding GalgameModeLabel}"
                                TextColor="{DynamicResource AccentWarmFg}" BackgroundColor="{DynamicResource SurfaceBg}"
                                FontSize="11" Padding="10,4" CornerRadius="12" HeightRequest="28"
                                Command="{Binding ToggleGalgameModeCommand}" />
                        <Label Text="{Binding LastSpeakerName}" TextColor="{DynamicResource MutedFg}" FontSize="11"
                               VerticalOptions="Center" Margin="8,0,0,0" />
                    </HorizontalStackLayout>

                    <!-- 对话历史 -->
                    <Border Grid.Row="1" BackgroundColor="{DynamicResource SurfaceBg}" StrokeThickness="0"
                            MaximumHeightRequest="80" Padding="8,6">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Label Text="{Binding LastMessageText}" TextColor="{DynamicResource SurfaceFg}" FontSize="13"
                               LineBreakMode="WordWrap" MaxLines="4" VerticalOptions="Center" />
                    </Border>

                    <!-- 沉默提示（开启「允许 AI 沉默」时显示） -->
                    <Label Grid.Row="1" IsVisible="{Binding SilenceHintText, Converter={StaticResource StringNotEmpty}}"
                           Text="{Binding SilenceHintText}" TextColor="{DynamicResource MutedFg}" FontSize="11"
                           VerticalOptions="Start" Margin="8,4,8,0" />

                    <!-- 输入栏 -->
                    <Border Grid.Row="2" BackgroundColor="{DynamicResource SurfaceBg}" StrokeThickness="1"
                            Stroke="{DynamicResource WSepBrush}" Padding="10,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <Entry Text="{Binding InputText}"
                                   Placeholder="输入你想说的话..."
                                   PlaceholderColor="{DynamicResource MutedFg}"
                                   BackgroundColor="Transparent"
                                   TextColor="{DynamicResource SurfaceFg}" FontSize="13"
                                   ReturnCommand="{Binding SendMessageCommand}"
                                   HeightRequest="36"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="文件" TextColor="{DynamicResource MutedFg}"
                                    BackgroundColor="Transparent" FontSize="11"
                                    Padding="2,0" HeightRequest="36" WidthRequest="40"
                                    Command="{Binding PickAttachmentCommand}" />
                            <Button Grid.Column="2" Text="🎁" TextColor="{DynamicResource MutedFg}"
                                    BackgroundColor="Transparent" FontSize="13"
                                    Padding="0" HeightRequest="36" WidthRequest="36"
                                    Command="{Binding ToggleGiftPanelCommand}" />
                            <Button Grid.Column="3" Text="🎤" TextColor="{DynamicResource MutedFg}"
                                    BackgroundColor="Transparent" FontSize="11"
                                    Padding="0" HeightRequest="36" WidthRequest="36"
                                    Command="{Binding VoiceInputCommand}" />
                            <Button Grid.Column="4" Text="发送"
                                    BackgroundColor="{DynamicResource AccentWarm}" TextColor="{DynamicResource AccentWarmFg}"
                                    FontSize="12" FontAttributes="Bold"
                                    CornerRadius="14" HeightRequest="36" WidthRequest="52"
                                    Padding="0"
                                    Command="{Binding SendMessageCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Overlays (shared by phone & desktop) ============ -->

        <!-- 菜单浮层：只放「这一局」的系统动作（设置/存档/收起/回标题）。
             功能入口一律走手机桌面，这里不再重复一遍——同一个功能有两个入口，
             就等于没有入口：用户记不住哪个是正的，我们也改不动另一份。 -->
        <Grid IsVisible="{Binding ShowMenu}" BackgroundColor="{DynamicResource OverlayDim}">
            <Border BackgroundColor="{DynamicResource SurfaceBg}" StrokeThickness="1" Stroke="{DynamicResource WSepBrush}"
                    Padding="24,20" Margin="40" VerticalOptions="Center"
                    MaximumWidthRequest="360">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="菜单" TextColor="{DynamicResource SurfaceFg}" FontSize="20"
                           HorizontalOptions="Center" FontAttributes="Bold" Margin="0,0,0,6" />
                    <Button Text="设置" TextColor="{DynamicResource SurfaceFg}" BackgroundColor="{DynamicResource SecondaryBg}"
                            CornerRadius="8" HeightRequest="40"
                            Command="{Binding OpenSettingsCommand}" />
                    <Button Text="手机" TextColor="{DynamicResource SurfaceFg}" BackgroundColor="{DynamicResource SecondaryBg}"
                            CornerRadius="8" HeightRequest="40"
                            Command="{Binding OpenPhoneCommand}" />
                    <Button Text="本局设定" TextColor="{DynamicResource SurfaceFg}" BackgroundColor="{DynamicResource SecondaryBg}"
                            CornerRadius="8" HeightRequest="40"
                            Command="{Binding OpenRunSettingsCommand}" />
                    <Button Text="存档管理" TextColor="{DynamicResource SurfaceFg}" BackgroundColor="{DynamicResource SecondaryBg}"
                            CornerRadius="8" HeightRequest="40"
                            Command="{Binding OpenSaveCommand}" />
                    <Button Text="桌宠模式" TextColor="{DynamicResource SurfaceFg}" BackgroundColor="{DynamicResource SecondaryBg}"
                            CornerRadius="8" HeightRequest="40"
                            Command="{Binding PetModeCommand}" />
                    <Button Text="回标题" TextColor="{DynamicResource DangerInk}" BackgroundColor="{DynamicResource SecondaryBg}"
                            CornerRadius="8" HeightRequest="40"
                            Command="{Binding BackToTitleCommand}" />
                    <Button Text="关闭" TextColor="{DynamicResource WarmBody}" BackgroundColor="Transparent"
                            CornerRadius="8" HeightRequest="36"
                            Command="{Binding ToggleMenuCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ============ 送礼 / 使用面板 ============ -->
        <Grid IsVisible="{Binding IsGiftPanelVisible}" BackgroundColor="{DynamicResource OverlayDim}">
            <Border Background="{DynamicResource GlassCardBg}" Stroke="{DynamicResource GlassCardStroke}"
                    StrokeThickness="{DynamicResource GlassCardStrokeThickness}"
                    Padding="0" Margin="30" VerticalOptions="Center"
                    MaximumWidthRequest="420">
                <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource ShadowDim}" Offset="0,4" Radius="16" Opacity="0.5" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="18,16" RowSpacing="12">
                    <!-- 标题 -->
                    <Label Text="礼物箱 🎁" TextColor="{DynamicResource SurfaceFg}" FontSize="16"
                           FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="点一下送出心意，小雨会收下并回应" TextColor="{DynamicResource MutedFg}" FontSize="11"
                           HorizontalOptions="Center" />

                    <!-- 模式切换：送礼 / 使用 -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="🎁 送礼" FontSize="13" HeightRequest="34" CornerRadius="10" Padding="0"
                                BackgroundColor="{DynamicResource PrimaryAction}" TextColor="{DynamicResource PrimaryFg}"
                                Command="{Binding ToggleGiftModeCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsGiftMode}" Value="False">
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter Property="TextColor" Value="{DynamicResource MutedFg}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="✨ 使用" FontSize="13" HeightRequest="34" CornerRadius="10" Padding="0"
                                BackgroundColor="Transparent" TextColor="{DynamicResource MutedFg}"
                                Command="{Binding ToggleGiftModeCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsGiftMode}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentWarm}" />
                                    <Setter Property="TextColor" Value="{DynamicResource AccentWarmFg}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <!-- 商品列表（有已购时显示） -->
                    <ScrollView Grid.Row="3" MaximumHeightRequest="300" IsVisible="{Binding HasGiftItems}">
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding GiftItems}">
                            <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,8">
                                            <Border BackgroundColor="{DynamicResource SecondaryBg}" StrokeThickness="0"
                                                    WidthRequest="40" HeightRequest="40" Padding="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                                <Label Text="{Binding Emoji}" FontSize="20"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Name}" TextColor="{DynamicResource SurfaceFg}"
                                                       FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Desc}" TextColor="{DynamicResource MutedFg}"
                                                       FontSize="11" MaxLines="1" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End"
                                                                 VerticalOptions="Center" Spacing="6">
                                                <Border BackgroundColor="{DynamicResource Beige100}" StrokeThickness="0"
                                                        Padding="9,2" HorizontalOptions="End">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                    <Label Text="{Binding Owned, StringFormat='×{0}'}"
                                                           TextColor="{DynamicResource MutedFg}" FontSize="10" />
                                                </Border>
                                                <!-- 送礼（送礼模式下可见） -->
                                                <Button Text="送礼" FontSize="11" HeightRequest="28" Padding="12,0" CornerRadius="10"
                                                        BackgroundColor="{DynamicResource PrimaryAction}" TextColor="{DynamicResource PrimaryFg}"
                                                        IsVisible="{Binding Path=BindingContext.IsGiftMode, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        Command="{Binding Path=BindingContext.GiftItemCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}" />
                                                <!-- 使用（使用模式下可见） -->
                                                <Button Text="使用" FontSize="11" HeightRequest="28" Padding="12,0" CornerRadius="10"
                                                        BackgroundColor="{DynamicResource AccentWarm}" TextColor="{DynamicResource AccentWarmFg}"
                                                        IsVisible="{Binding Path=BindingContext.IsGiftMode, Source={RelativeSource AncestorType={x:Type ContentPage}}, Converter={StaticResource InverseBool}}"
                                                        Command="{Binding Path=BindingContext.UseItemCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{DynamicResource BorderLine}" Margin="4,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- 空态 -->
                    <VerticalStackLayout Grid.Row="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                                         IsVisible="{Binding HasGiftItems, Converter={StaticResource InverseBool}}">
                        <Label Text="🎁" FontSize="34" HorizontalOptions="Center" />
                        <Label Text="还没有已购商品，先去商店逛逛吧～" TextColor="{DynamicResource MutedFg}" FontSize="12" />
                    </VerticalStackLayout>

                    <!-- 关闭 -->
                    <Button Grid.Row="4" Text="关闭" FontSize="13" HeightRequest="40" CornerRadius="12"
                            BackgroundColor="Transparent" TextColor="{DynamicResource MutedFg}"
                            Command="{Binding ToggleGiftPanelCommand}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 未标定闸门遮罩（最上层，不可关闭）=====
             没有标定数据就不生成角色位置，但必须给出口，否则换错一张图就卡死。 -->
        <Grid IsVisible="{Binding IsCalibrationBlocked}" BackgroundColor="#CC000000">
            <Border BackgroundColor="{DynamicResource SurfaceBg}" StrokeThickness="0"
                    Padding="24,22" Margin="28" VerticalOptions="Center" HorizontalOptions="Center"
                    MaximumWidthRequest="520">
                <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="这张背景还没有标定" FontSize="19" FontAttributes="Bold"
                           TextColor="{DynamicResource WarmDark}"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding CalibrationHint}" FontSize="13"
                           TextColor="{DynamicResource MutedFg}" />
                    <Label Text="标定确定两件事：角色能站在哪里（落脚点），以及近处远处该怎么缩放（缩放标定）。"
                           FontSize="12" TextColor="{DynamicResource MutedFg}" />
                    <!-- 这两个钮原来写死「淡面 + 白字」：深色档里淡面令牌会变浅、白字随之糊掉。
                         走共享样式，颜色交给世界，两个档位才都读得动。 -->
                    <Button Text="✓ 现在去标定" Style="{StaticResource BtnNeumorphAccent}"
                            Command="{Binding GoCalibrateCommand}" />
                    <Button Text="移除这张背景（改用纯色）" Style="{StaticResource BtnDangerSm}"
                            Command="{Binding RemoveSceneBackgroundCommand}" />
                    <Button Text="暂时用居中显示继续" FontSize="13" HeightRequest="40" CornerRadius="12"
                            BackgroundColor="Transparent" TextColor="{DynamicResource MutedFg}"
                            Command="{Binding ContinueCenteredCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- 选择了「暂用居中」后的常驻提醒（不挡操作，点了就能去补标定） -->
        <Border IsVisible="{Binding IsUncalibrated}" BackgroundColor="#E6B3261E"
                StrokeThickness="0" Padding="14,8" Margin="12" VerticalOptions="Start" HorizontalOptions="Center">
            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
            <Label Text="{Binding UncalibratedHint}" TextColor="White" FontSize="12">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoCalibrateCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Border>
    </Grid>
</ContentPage>
