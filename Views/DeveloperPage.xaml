<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.DeveloperPage"
             x:DataType="vm:DeveloperViewModel"
             Title="开发者模式"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">
        <Label Text="开发者模式" Style="{StaticResource TxtTitle}" />

        <ScrollView Grid.Row="1" Margin="0,12">
            <VerticalStackLayout Spacing="8">
                <Label Text="提示词日志" Style="{StaticResource TxtSubhead}" />
                <Border Style="{StaticResource CardSolid}" Padding="10"
                        BackgroundColor="#1A1A2E">
                    <Label Text="{Binding PromptLog}" TextColor="#E0E0E0" FontSize="12" FontFamily="monospace" />
                </Border>
                <Label Text="工具调用" Style="{StaticResource TxtSubhead}" />
                <Border Style="{StaticResource CardSolid}" Padding="10"
                        BackgroundColor="#1A1A2E">
                    <Label Text="{Binding ToolLog}" TextColor="#E0E0E0" FontSize="12" FontFamily="monospace" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="12" Margin="0,8,0,0">
            <Button Text="清空" Style="{StaticResource BtnNeumorphic}" Command="{Binding ClearCommand}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>