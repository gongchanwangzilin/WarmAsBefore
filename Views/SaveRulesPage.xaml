<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WarmAsBefore.Views.SaveRulesPage"
             x:Name="Page"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,*">
        <Border Background="{DynamicResource GlassBarBg}" Stroke="{DynamicResource GlassBarStroke}"
                StrokeThickness="{DynamicResource GlassBarStrokeThickness}" Padding="16,12">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="&lt; 返回" Style="{StaticResource BtnText}" FontSize="14" Padding="0"
                        Command="{Binding BackCommand}" />
                <Label Grid.Column="1" Text="存档高级设置" Style="{StaticResource TxtTitle}" VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="24,16,24,28">
            <VerticalStackLayout Spacing="16" MaximumWidthRequest="900" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding SaveLabel}" Style="{StaticResource TxtSubhead}" />
                    <Label Text="这些白名单只属于这一份存档：换档就换一套。插件与工具被关掉时不会执行；角色白名单决定 AI 能在这份存档里让谁出场。"
                           Style="{StaticResource TxtCaption}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- 总开关 -->
                <Border Style="{StaticResource CardGroup}">
                    <VerticalStackLayout Spacing="0">
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="允许全部插件" Style="{StaticResource TxtRowTitle}" />
                                    <Label Text="关掉后，只有下面勾选的插件能在这份存档里跑" Style="{StaticResource TxtRowDesc}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding AllowAllPlugins}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <BoxView Style="{StaticResource HSepInset}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="允许全部工具" Style="{StaticResource TxtRowTitle}" />
                                    <Label Text="工具包括内置工具与外部 Java/Python 工具" Style="{StaticResource TxtRowDesc}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding AllowAllTools}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <BoxView Style="{StaticResource HSepInset}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="AI 可以自行安装插件" Style="{StaticResource TxtRowTitle}" />
                                    <Label Text="默认关闭：装代码应该由你做决定" Style="{StaticResource TxtRowDesc}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding AllowAiInstallPlugins}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 插件 -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="可以运行的插件" Style="{StaticResource TxtSubhead}" />
                    <Border Style="{StaticResource CardGroup}">
                        <VerticalStackLayout Spacing="0">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Plugins}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="0">
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding Name}" Style="{StaticResource TxtRowTitle}" />
                                                        <Label Text="{Binding Hint}" Style="{StaticResource TxtRowDesc}"
                                                               IsVisible="{Binding HasHint}" />
                                                    </VerticalStackLayout>
                                                    <Switch Grid.Column="1" IsToggled="{Binding Allowed}"
                                                            IsEnabled="{Binding Enabled}" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                            <BoxView Style="{StaticResource HSepInset}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="还没有装插件。插件中心可以从 zip / 文件夹安装，也可以让工坊写一个。"
                                   Style="{StaticResource TxtCaption}" Margin="{DynamicResource WPadRow}"
                                   IsVisible="{Binding NoPlugins}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 工具 -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="可以调用的工具" Style="{StaticResource TxtSubhead}" />
                    <Border Style="{StaticResource CardGroup}">
                        <VerticalStackLayout Spacing="0">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tools}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="0">
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding Name}" Style="{StaticResource TxtRowTitle}" />
                                                        <Label Text="{Binding Hint}" Style="{StaticResource TxtRowDesc}"
                                                               LineBreakMode="TailTruncation" MaxLines="1"
                                                               IsVisible="{Binding HasHint}" />
                                                    </VerticalStackLayout>
                                                    <Switch Grid.Column="1" IsToggled="{Binding Allowed}"
                                                            IsEnabled="{Binding Enabled}" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                            <BoxView Style="{StaticResource HSepInset}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 角色 -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="可以出场的角色" Style="{StaticResource TxtSubhead}" />
                    <Border Style="{StaticResource CardGroup}">
                        <VerticalStackLayout Spacing="0">
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="允许全部角色" Style="{StaticResource TxtRowTitle}" />
                                        <Label Text="关掉后只让勾选的角色进入这份存档的剧情" Style="{StaticResource TxtRowDesc}" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1" IsToggled="{Binding AllowAllCharacters}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <BoxView Style="{StaticResource HSepInset}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Characters}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="0">
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding Name}" Style="{StaticResource TxtRowTitle}" />
                                                        <Label Text="{Binding Hint}" Style="{StaticResource TxtRowDesc}"
                                                               LineBreakMode="TailTruncation" MaxLines="1"
                                                               IsVisible="{Binding HasHint}" />
                                                    </VerticalStackLayout>
                                                    <Switch Grid.Column="1" IsToggled="{Binding Allowed}"
                                                            IsEnabled="{Binding Enabled}" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                            <BoxView Style="{StaticResource HSepInset}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="角色库里还没有别的角色。"
                                   Style="{StaticResource TxtCaption}" Margin="{DynamicResource WPadRow}"
                                   IsVisible="{Binding NoCharacters}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 角色世界观：这套设定属于角色，但「这一档用哪一套」可以按档覆盖 -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="这一档的角色世界观" Style="{StaticResource TxtSubhead}" />
                    <Border Style="{StaticResource CardGroup}">
                        <VerticalStackLayout Spacing="0">
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="世界观改动跨存档生效" Style="{StaticResource TxtRowTitle}" />
                                        <Label Text="{Binding WorldviewCrossSaveHint}" Style="{StaticResource TxtRowDesc}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1" IsToggled="{Binding WorldviewCrossSave}"
                                            IsVisible="{Binding HasWorldviews}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <BoxView Style="{StaticResource HSepInset}" />
                            <Label Text="{Binding WorldviewHint}" Style="{StaticResource TxtRowDesc}"
                                   Margin="{DynamicResource WPadRow}" LineBreakMode="WordWrap" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Worldviews}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="0">
                                            <Border Style="{StaticResource SettingRow}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.PickWorldviewCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="4.5"
                                                             Color="Transparent" VerticalOptions="Center">
                                                        <BoxView.Triggers>
                                                            <DataTrigger TargetType="BoxView" Binding="{Binding IsOn}" Value="True">
                                                                <Setter Property="Color" Value="{DynamicResource Signal}" />
                                                            </DataTrigger>
                                                        </BoxView.Triggers>
                                                    </BoxView>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding Name}" Style="{StaticResource TxtRowTitle}" />
                                                        <Label Text="{Binding Hint}" Style="{StaticResource TxtRowDesc}"
                                                               LineBreakMode="WordWrap" IsVisible="{Binding HasHint}" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="2" Text="这一档在用"
                                                           Style="{StaticResource TxtCaption}"
                                                           TextColor="{DynamicResource WarmFaint}"
                                                           VerticalOptions="Center" IsVisible="{Binding IsOn}" />
                                                </Grid>
                                            </Border>
                                            <BoxView Style="{StaticResource HSepInset}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 性欲系统：只在这份存档里点名的人生效 -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="性欲系统参与角色" Style="{StaticResource TxtSubhead}" />
                    <Border Style="{StaticResource CardGroup}">
                        <VerticalStackLayout Spacing="0">
                            <Border Style="{StaticResource SettingRow}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="只对这里点名的人生效" Style="{StaticResource TxtRowTitle}" />
                                    <Label Text="没点名的人完全不参与。数值由设定（写死的值）与女性周期共同决定，设定优先——写死时周期不再影响它。"
                                           Style="{StaticResource TxtRowDesc}" LineBreakMode="WordWrap" />
                                    <Label Text="总开关在「设置 → 体验」里，目前是关的；下面勾了也不会生效。"
                                           Style="{StaticResource TxtCaption}" IsVisible="{Binding LibidoSystemOff}"
                                           TextColor="{DynamicResource AccentWarmFg}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                            <BoxView Style="{StaticResource HSepInset}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Libido}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="0">
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding Name}" Style="{StaticResource TxtRowTitle}" />
                                                        <Label Text="{Binding Hint}" Style="{StaticResource TxtRowDesc}"
                                                               IsVisible="{Binding HasHint}" LineBreakMode="WordWrap" />
                                                    </VerticalStackLayout>
                                                    <Switch Grid.Column="1" IsToggled="{Binding Participates}"
                                                            IsEnabled="{Binding Enabled}" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                            <BoxView Style="{StaticResource HSepInset}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="角色库里还没有别的角色。"
                                   Style="{StaticResource TxtCaption}" Margin="{DynamicResource WPadRow}"
                                   IsVisible="{Binding NoCharacters}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding Status}" Style="{StaticResource TxtCaption}"
                       TextColor="{DynamicResource AccentWarmFg}" />
                <Button Text="保存这份存档的规则" Style="{StaticResource BtnPrimary}" FontSize="13"
                        Padding="16,7" HorizontalOptions="Start" Command="{Binding SaveCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
