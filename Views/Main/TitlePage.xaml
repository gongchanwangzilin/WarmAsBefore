<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:motion="clr-namespace:WarmAsBefore.Helpers" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:i18n="clr-namespace:WarmAsBefore.Services"
             x:Class="WarmAsBefore.Views.TitlePage"

             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid x:Name="Root">
        <!--
          地面不再自己铺渐变、也不摆两团光晕：这一档语言里层次只来自
          「浅灰地 / 纯白卡 / 一条发丝线」，装饰性光斑会把白卡压成「灰底上一块糊掉的亮斑」。
          页面底统一由 AppBackgroundService 按当前世界下发（极简与轻质感是纯色，
          渐变与液态档是一档很浅的斜向渐变），这里只引用 PageBgBrush。
        -->

        <!--
          参考窗（水杉输入法设置页）填住窗口靠的是「左导航 + 右内容」两栏，不是一张居中的卡。
          上一版把整屏压成一张居中卡片，尺寸那一半是修对了，但 1280×800 的窗里四周仍剩一大片空地 ——
          用户说的「大小不合理」剩下的那一半就是这个：不是控件太大，是整个界面没把窗口当回事。
          现在卡片铺满窗口（只留一圈 WPageMargin），左边一条导航带、右边主行动区，中间一根发丝线。
          两栏各自有活干：左栏回答「去哪里」，右栏回答「现在做什么」，没有一处是为了填空而存在。
        -->
        <Border Style="{StaticResource CardSolid}" Padding="0"
                Margin="{DynamicResource WPageMargin}"
                HorizontalOptions="Fill" VerticalOptions="Fill">
            <Grid ColumnDefinitions="{OnPlatform WinUI='Auto,*', Android='*'}">

                <!-- ── 左 · 导航带：抬头 → 发丝线 → 四个入口 → 发丝线 → 页脚。
                     页脚钉在带底而不是跟在列表后面：「退出游戏」和「这是陪伴向工具」属于收尾，
                     不属于入口 —— 跟在列表后面会读成「第五、第六个入口」。 -->
                <Grid Grid.Column="0" WidthRequest="{DynamicResource WRailWidth}"
                      RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <HorizontalStackLayout x:Name="BrandBand" Grid.Row="0" VerticalOptions="Center"
                                           Padding="{DynamicResource WPadCard}"
                                           Spacing="{DynamicResource WGapItem}">
                        <Border Background="{DynamicResource WSurfaceRaised}" StrokeThickness="0"
                                WidthRequest="{DynamicResource WMarkSize}" HeightRequest="{DynamicResource WMarkSize}">
                            <!-- 字面量：RoundRectangle.CornerRadius 吃 CornerRadius 结构，令牌给的是 int，
                                 DynamicResource 不做这种转换，类型不符时运行时静默失败、角掉回 0。 -->
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Image Source="titlelogo.png" Aspect="AspectFill"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                            <Label Text="温暖如初" FontSize="{DynamicResource WSizeTitle}"
                                   FontAttributes="Bold" TextColor="{DynamicResource WarmDark}" />
                            <Label Text="WARM AS BEFORE" FontSize="{DynamicResource WSizeCaption}"
                                   TextColor="{DynamicResource WarmFaint}" CharacterSpacing="2.2" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <BoxView Grid.Row="1" Style="{StaticResource HSep}" />

                <!-- 带 3 · 四个次要入口：行，不是按钮。它们和主行动的区别只靠「没有颜色」来说 ——
                     但「没有颜色」只能说明它不重要，不能说明它不能点，所以静止态留空、
                     鼠标进来才压出一档底（TappableRow）。少了这一档，桌面端就没有任何东西
                     能证明「鼠标此刻在这儿」，四条行读起来和四段死文字一样。 -->
                <VerticalStackLayout Grid.Row="2" x:Name="MenuStack" Spacing="0" VerticalOptions="Start">
                    <Border x:Name="RowSave" Style="{StaticResource TappableRow}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSaveCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding [Title_Save], Source={x:Static i18n:LocalizationService.Current}}"
                                   Style="{StaticResource TxtRowTitle}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="›" FontSize="{DynamicResource WSizeSubhead}"
                                   TextColor="{DynamicResource WarmFaint}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <BoxView Style="{StaticResource HSep}" />
                    <Border x:Name="RowNovels" Style="{StaticResource TappableRow}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenNovelsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding [Title_Novels], Source={x:Static i18n:LocalizationService.Current}}"
                                   Style="{StaticResource TxtRowTitle}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="›" FontSize="{DynamicResource WSizeSubhead}"
                                   TextColor="{DynamicResource WarmFaint}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <BoxView Style="{StaticResource HSep}" />
                    <Border x:Name="RowRoster" Style="{StaticResource TappableRow}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenRosterCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding [Title_Roster], Source={x:Static i18n:LocalizationService.Current}}"
                                   Style="{StaticResource TxtRowTitle}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="›" FontSize="{DynamicResource WSizeSubhead}"
                                   TextColor="{DynamicResource WarmFaint}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <BoxView Style="{StaticResource HSep}" />
                    <Border x:Name="RowSettings" Style="{StaticResource TappableRow}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding [Title_Settings], Source={x:Static i18n:LocalizationService.Current}}"
                                   Style="{StaticResource TxtRowTitle}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="›" FontSize="{DynamicResource WSizeSubhead}"
                                   TextColor="{DynamicResource WarmFaint}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    </VerticalStackLayout>

                    <BoxView Grid.Row="3" Style="{StaticResource HSep}" />
                    <Grid x:Name="RailFoot" Grid.Row="4" Padding="{DynamicResource WPadCard}" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <VerticalStackLayout Grid.Row="0" Spacing="3">
                            <!-- 这一句是「这软件是什么」，不是免责声明：放在导航带底部，
                                 读起来像页脚的签名，而不是主行动下面又一颗按钮的说明。 -->
                            <Label Text="{Binding [Title_Coexist], Source={x:Static i18n:LocalizationService.Current}}"
                                   FontSize="{DynamicResource WSizeSmall}" TextColor="{DynamicResource WarmBody}" />
                            <Label Text="{Binding [Title_CoexistDesc], Source={x:Static i18n:LocalizationService.Current}}"
                                   Style="{StaticResource TxtRowDesc}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <!-- 退出原来是「一行浮空的文字」，看着像哪个控件坏了没画完；
                             给它一颗真的次要钮，它才读得出是「可以按，但不重要」。 -->
                        <Button x:Name="ExitButton" Grid.Row="1"
                                Text="{Binding [Title_Exit], Source={x:Static i18n:LocalizationService.Current}}"
                                Style="{StaticResource BtnGhostSm}" HorizontalOptions="Start"
                                Command="{Binding ExitGameCommand}" />
                    </Grid>
                </Grid>

                <!-- 两栏之间那根竖发丝线：它把「去哪里」和「现在做什么」分开，
                     又不像一块边框那样把卡片劈成两张卡 —— 所以只有 1px，且用线的颜色。 -->
                <BoxView Grid.Column="1" WidthRequest="1" Color="{DynamicResource WSep}"
                         HorizontalOptions="Start" VerticalOptions="Fill" />

                <!-- ── 右 · 主行动区 ─────────────────────────────────────
                     读数带在上（「我现在看到的是什么」是状态，不是入口，所以既不给正文位也不给信号色），
                     标语与那颗胶囊在剩下的空间里垂直居中 —— 整屏唯一饱和的东西就是这颗。 -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*">
                    <Label Grid.Row="0" HorizontalOptions="End" VerticalOptions="Center"
                           Margin="{DynamicResource WPadCard}"
                           FontSize="{DynamicResource WSizeCaption}" TextColor="{DynamicResource WarmFaint}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding ThemeColorName}" TextColor="{DynamicResource MutedFg}" />
                                <Span Text="  ·  " />
                                <Span Text="{Binding ThemeEffectName}" TextColor="{DynamicResource MutedFg}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <VerticalStackLayout x:Name="HeroBand" Grid.Row="1" Padding="{DynamicResource WPadHero}"
                                         Spacing="{DynamicResource WGapItem}"
                                         VerticalOptions="Center" HorizontalOptions="Start"
                                         MaximumWidthRequest="640">
                        <Label Text="{Binding [Title_Tagline], Source={x:Static i18n:LocalizationService.Current}}"
                               FontSize="{DynamicResource WSizeDisplay}" TextColor="{DynamicResource WarmDark}"
                               HorizontalOptions="Start" LineBreakMode="WordWrap" />
                        <Button x:Name="EnterButton" Text="{Binding StartLabel}"
                                Style="{StaticResource BtnSignal}"
                                HorizontalOptions="Start" MinimumWidthRequest="200"
                                Command="{Binding StartGameCommand}" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>

        <!-- ── 键盘光标 ─────────────────────────────────────────────────────
             方向键那一套操作模式的「光标」。只有按过方向键才现身，鼠标用户从头到尾看不见它，
             所以这一屏的观感和原来一模一样，改的只是「怎么选」。
             圈画在自己这一层、跟着量到的位置滑，而不是描到每一行身上：那一行的底归悬停反馈管
             （HoverFeel 压的是原生画刷），再来一层「选中底」就是两边抢同一块面。
             方角而不是本世界的圆角：这一颗要读成操作台上的光标，不是读成一张卡。 -->
        <Border x:Name="FocusRing" IsVisible="False" InputTransparent="True"
                HorizontalOptions="Start" VerticalOptions="Start"
                BackgroundColor="Transparent" StrokeThickness="2"
                Stroke="{DynamicResource WEdgeStrongBrush}"
                StrokeShape="RoundRectangle 0" />

        <!-- 免责声明：留在主菜单之后（放在主菜单之前会被菜单整块盖住，「知道了」点不到），
             但**不是**根 Grid 的最后一个 —— 启动卡比它更早、也要盖在它上面（首次开机先看见品牌，再读条款）。
             遮罩 + 弹窗卡片，整体是模态的（会吃掉点击，这正是想要的）。 -->
        <Grid IsVisible="{Binding ShowDisclaimer}"
              BackgroundColor="{DynamicResource OverlayDim}">
            <!-- 卡片用「Auto,*,Auto」三行：正文那一行是 * 才会被真正约束高度，
                 否则 ScrollView 会按全文高度撑开，永远滚不动（曾经就是这个问题）。 -->
            <Border Style="{StaticResource CardDialog}"
                    MaximumWidthRequest="560" MaximumHeightRequest="640" Margin="48,0"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                    <Label Grid.Row="0" Text="免责声明与使用条款" FontSize="18"
                           FontAttributes="Bold" TextColor="{DynamicResource WarmDark}"
                           HorizontalOptions="Center" />
                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Always">
                        <Label LineBreakMode="WordWrap" FontSize="13"
                               TextColor="{DynamicResource SurfaceFg}"
                               Text="欢迎使用「温暖如初」。在继续之前，请完整阅读以下条款。点击「同意并继续」即表示你已阅读、理解并自愿接受全部内容。&#10;&#10;一、性质说明&#10;本软件是一款由个人开发、免费分享的 AI 陪伴向互动工具，非商业产品，非专业服务。软件中的角色形象、性格、台词、剧情均为程序与 AI 模型生成的虚构内容，不代表开发者立场，也不构成任何形式的真实人际承诺。&#10;&#10;二、AI 生成内容免责&#10;1. AI 输出具有随机性与不确定性，可能出现错误、重复、不当或荒谬的内容，开发者无法预先审核每一句输出。&#10;2. AI 内容不构成医疗、心理、法律、财务或任何专业建议；如你正经历情绪困扰或健康问题，请立即寻求专业机构与人员的帮助。&#10;3. AI 的言行不代表真实价值观，请勿将其作为决策依据；由此产生的后果由使用者自行承担。&#10;&#10;三、版权与知识产权&#10;1. 你自行导入或创建的角色、立绘、背景、音乐、音效、剧本、文本等素材，其版权与合法性由你自行保证。你须确保已获得相应授权，或素材本身为公有领域、可自由使用。&#10;2. 严禁导入、传播任何侵犯他人著作权、商标权、肖像权、名誉权或其他合法权益的内容。因导入侵权素材而引发的一切纠纷、索赔及法律责任，均由导入者本人承担，与开发者无关。&#10;3. 严禁将本软件用于制作、存储或传播违反所在地法律法规的内容，包括但不限于危害国家安全、煽动暴力、色情低俗、侵害未成年人权益等。&#10;4. 本软件本身及其内建的界面、代码、图标等，未经许可不得用于商业用途或二次分发牟利。&#10;&#10;四、插件与外部工具&#10;本软件支持加载第三方插件、MCP 服务、外部工具及自定义 API。这些组件由第三方提供，其功能、安全性与合法性由提供者负责。使用前请自行评估风险，开发者不对第三方组件造成的任何损失负责。&#10;&#10;五、数据与隐私&#10;1. 本软件为本地运行，存档、聊天记录、素材等数据默认保存在你的设备本地，开发者不收集、不上传你的个人数据。&#10;2. 当你配置并启用外部 AI 服务（如 OpenAI、DeepSeek、通义千问等）或机器人通道（如 QQ、微信）时，相关对话内容会按该服务的规则传输至对应第三方服务器。请自行阅读并遵守各服务提供商的条款与隐私政策。&#10;3. 请自行做好数据备份。因设备损坏、误操作、卸载等导致的数据丢失，开发者不承担责任。&#10;&#10;六、使用规范与责任&#10;1. 本软件仅供个人学习、娱乐与合法的非商业用途。&#10;2. 你须遵守所在国家/地区的一切适用法律法规，以及你所使用平台的用户协议。不得利用本软件从事任何违法违规活动。&#10;3. 因使用或无法使用本软件而产生的任何直接或间接损失，开发者不承担赔偿责任。&#10;4. 开发者保留在不另行通知的情况下，随时更新、修改或停止本软件及其相关服务的权利；条款如有变更，以软件内展示的最新版本为准。&#10;&#10;七、未成年人提示&#10;若你为未成年人，请在监护人陪同下阅读并决定是否使用本软件。&#10;&#10;八、其他&#10;本条款未尽事宜，参照中华人民共和国相关法律法规处理。若你不同意上述任何一条，请点击「不同意并退出」，并立即停止使用本软件。" />
                    </ScrollView>
                    <HorizontalStackLayout Grid.Row="2" Spacing="12" HorizontalOptions="Center">
                        <Button Text="不同意并退出" Style="{StaticResource BtnPrimary}"
                                WidthRequest="170" MinimumHeightRequest="48"
                                BackgroundColor="{DynamicResource SurfaceFg}" TextColor="{DynamicResource WarmDark}"
                                Command="{Binding DeclineDisclaimerCommand}" />
                        <Button Text="同意并继续" Style="{StaticResource BtnPrimary}"
                                WidthRequest="170" MinimumHeightRequest="48"
                                Command="{Binding AcknowledgeDisclaimerCommand}" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- ── 启动卡（根 Grid 的最后一块 = 盖在免责声明之上）──────────────────
             一趟进程只放一次（见 IntroCard.HasPlayed）：先逐字写出中文名牌，缩一格，
             再从下面引出本地语言的名字 —— 名牌是图形、不翻译，第二行才跟语言设置走。
             地面吃本世界的纯色 PageBg（不是 PageBgBrush：用户可能把背景设成一张照片，
             而这一刻只有一团字要压在上面，底色必须是被锁过对比的那一档）。
             四档世界在这一屏只有字号与线色不同，没有一块玻璃。 -->
        <Grid motion:HoverFeel.Enabled="True" motion:PressFeel.Enabled="True" x:Name="IntroCurtain" BackgroundColor="{DynamicResource PageBg}"
              Padding="{DynamicResource WPadCard}" IsVisible="{Binding ShowIntro}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnIntroTapped" />
            </Grid.GestureRecognizers>

            <VerticalStackLayout x:Name="IntroLockup" Spacing="{DynamicResource WGapSection}"
                                 HorizontalOptions="Center" VerticalOptions="Center">
                <!-- 名牌带：字与发丝线一起缩，所以它们必须在同一格里。
                     12 是「字形到线」的光学留白 —— 这一处不属于任何间距台阶，它只服务这条线。 -->
                <Grid x:Name="IntroBand" RowDefinitions="Auto,12" HorizontalOptions="Center">
                    <!-- 四个字由代码按 Brand_Mark 逐字建出来（繁体那档的「溫」和简体的「温」不是同一个字，
                         写死在 XAML 里就等于替繁体检定了一个字形）。 -->
                    <HorizontalStackLayout Grid.Row="0" Grid.RowSpan="2" x:Name="IntroMark"
                                           HorizontalOptions="Center" VerticalOptions="Start" />
                    <!-- 线从左扫出来用 ScaleX，不用宽度：宽度每帧都是一次布局，
                         而这条线需要的只是被「擦」出来。
                         线色用 EdgeStrong 而不是卡面上那根 WRule：WRule 是对着白卡算的，
                         铺在 PageBg 上只剩 1.1:1，一条 1px 的装饰线就这么糊进了地里。 -->
                    <BoxView Grid.Row="1" x:Name="IntroRule" HeightRequest="1" ScaleX="0" AnchorX="0"
                             Color="{DynamicResource EdgeStrong}" HorizontalOptions="Fill" VerticalOptions="Center" />
                </Grid>

                <!-- 本地化名：一个字一个 Label，由代码按 Brand_Name 建出来。
                     收字距走的是逐字 TranslationX（见 IntroCard），不是 CharacterSpacing：
                     后者在 WinUI 上只有第一次赋值会重排文字，实测那一行字距从头到尾纹丝不动。 -->
                <HorizontalStackLayout x:Name="IntroNameRow" Spacing="0"
                                       Opacity="0" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Label x:Name="IntroHint" Text="{Binding [Intro_Skip], Source={x:Static i18n:LocalizationService.Current}}"
                   FontSize="{DynamicResource WSizeCaption}" TextColor="{DynamicResource WarmFaint}"
                   Opacity="0" HorizontalOptions="Center" VerticalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>
