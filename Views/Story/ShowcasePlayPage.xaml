<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:motion="clr-namespace:WarmAsBefore.Helpers" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:conv="clr-namespace:WarmAsBefore.Converters"
             xmlns:i18n="clr-namespace:WarmAsBefore.Services"
             x:Class="WarmAsBefore.Views.ShowcasePlayPage"
             Title="播放展示案"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <ContentPage.Resources>
        <conv:SpritePathToImageSourceConverter x:Key="PathConv" />
        <conv:InvertedBoolConverter x:Key="InvertedBool" />
        <conv:ZeroToFalseConverter x:Key="ZeroToFalse" />
    </ContentPage.Resources>

    <Grid motion:HoverFeel.Enabled="True" motion:PressFeel.Enabled="True">
        <ContentPage.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTap" />
        </ContentPage.GestureRecognizers>

        <!-- 这一页内容（背景 + 立绘）就是主角：地面保持中性，没有铺满的黑底。
             原来钉死一个 Black，四套色板与明暗切过来都无效，浮层只好自己也涂一层黑玻璃。 -->
        <Image Source="{Binding BgSource}" IsVisible="{Binding BgVisible}" Aspect="AspectFill" />

        <!-- 立绘舞台 -->
        <Grid>
            <!-- 左 -->
            <Image Source="{Binding LeftSprites[0].Path, Converter={StaticResource PathConv}}"
                   IsVisible="{Binding LeftSprites.Count, Converter={StaticResource ZeroToFalse}}"
                   Aspect="AspectFit" HorizontalOptions="Start" VerticalOptions="End" HeightRequest="480" WidthRequest="280" />
            <!-- 中 -->
            <Image Source="{Binding CenterSprites[0].Path, Converter={StaticResource PathConv}}"
                   IsVisible="{Binding CenterSprites.Count, Converter={StaticResource ZeroToFalse}}"
                   Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="End" HeightRequest="520" WidthRequest="300" />
            <!-- 右 -->
            <Image Source="{Binding RightSprites[0].Path, Converter={StaticResource PathConv}}"
                   IsVisible="{Binding RightSprites.Count, Converter={StaticResource ZeroToFalse}}"
                   Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="End" HeightRequest="480" WidthRequest="280" />
        </Grid>

        <!-- 顶栏：浮在内容上的面板一律用 CardFrost —— 到底通不透由世界决定，这里不自己调玻璃色。 -->
        <Border Style="{StaticResource CardFrost}" VerticalOptions="Start" HorizontalOptions="Fill"
                Margin="{DynamicResource WPadCard}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource WGapSection}">
                <Button Grid.Column="0" Text="◀ 退出" Style="{StaticResource BtnGhostSm}"
                        VerticalOptions="Center" Command="{Binding BackCommand}" />
                <Label Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource TxtBodySm}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="{Binding Script.Name}" Style="{StaticResource TxtCaption}"
                       HorizontalOptions="End" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- CG 全屏覆盖 -->
        <Image Source="{Binding CgSource}" IsVisible="{Binding CgVisible}" Aspect="AspectFit" />

        <!-- 底部对话 -->
        <Border Style="{StaticResource CardFrost}" IsVisible="{Binding DialogueVisible}"
                VerticalOptions="End" Margin="{DynamicResource WPadCard}">
            <VerticalStackLayout Spacing="4">
                <!-- 说话人以前挂的是 AccentWarm：那是一张「面」，压在浅面上只有 1.1:1，等于没写。
                     换成信号墨 —— 整屏唯一的一颗饱和色，正好用来指「此刻是谁在说」。 -->
                <Label Text="{Binding SpeakerName}" Style="{StaticResource TxtRowTitle}"
                       TextColor="{DynamicResource SignalFg}" />
                <Label Text="{Binding DialogueText}" Style="{StaticResource TxtBody}"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>

        <!-- 播放结束：这是盖住整页的对话框，所以用 CardDialog（边和那档影子由世界发） -->
        <Border Style="{StaticResource CardDialog}" IsVisible="{Binding IsFinished}"
                HorizontalOptions="Center" VerticalOptions="Center">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <Label Text="🎉 播放结束" Style="{StaticResource TxtTitle}" HorizontalOptions="Center" />
                <Button Text="返回列表" Style="{StaticResource BtnNeumorphSm}" HorizontalOptions="Center"
                        Command="{Binding BackCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
