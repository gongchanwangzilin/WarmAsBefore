<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.NovelSelectPage"
             x:Name="Page"

             Title=""
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0">
        <!-- Header：顶栏与内容区是同一块地，它不是卡 —— 只靠底下一条发丝线分界。
             原来那圈 GlassBar 描边在极简档会被读成一条不属于地面的框。 -->
        <Border Background="{DynamicResource WBarBrush}" StrokeThickness="0"
                Padding="{DynamicResource WPadWell}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="&lt; 返回" Style="{StaticResource BtnText}"
                        Padding="0"
                        Command="{Binding GoBackCommand}" />
                <Label Grid.Column="1" Text="平行宇宙" Style="{StaticResource TxtTitle}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>
        <BoxView Grid.Row="1" Style="{StaticResource HSep}" />

        <!-- Novel list：一部小说 = 一行，全部装进同一张 CardGroup。
             一行一张卡时卡间距比行内还大，「一组宇宙」被读成「一摞牌子」，分组关系因此消失。 -->
        <Border Grid.Row="2" Style="{StaticResource CardGroup}" Margin="{DynamicResource WPadCard}">
            <CollectionView ItemsSource="{Binding Novels}" BackgroundColor="Transparent">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6"
                                         Padding="{DynamicResource WPadCard}">
                        <Label Text="还没有平行宇宙" Style="{StaticResource TxtSubhead}"
                               HorizontalOptions="Center" />
                        <Label Text="导入一部小说，它就会变成一个可以进入的世界" Style="{StaticResource TxtMuted}"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NovelItem">
                        <VerticalStackLayout Spacing="0">
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Label Text="{Binding Title}" Style="{StaticResource TxtRowTitle}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1" Text="{Binding ImportedAt, StringFormat='{0:MM/dd}'}"
                                                   Style="{StaticResource TxtCaption}" VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding Summary}" Style="{StaticResource TxtRowDesc}"
                                               LineBreakMode="TailTruncation" MaxLines="2" />
                                        <Label Text="{Binding CharactersLabel}" Style="{StaticResource TxtCaption}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="8"
                                                         VerticalOptions="Center" HorizontalOptions="End">
                                        <Button Text="进入世界" Style="{StaticResource BtnNeumorphSm}"
                                                WidthRequest="96"
                                                Command="{Binding Path=BindingContext.EnterNovelCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding Id}" />
                                        <!-- 删除仍是一条文字动作（卡里再摆一颗实心钮会抢掉「进入」的位置），
                                             但危险由 DangerInk 来说：淡灰的「删除」读起来像禁用。 -->
                                        <Button Text="删除" Style="{StaticResource BtnTextSm}"
                                                TextColor="{DynamicResource DangerInk}"
                                                HorizontalOptions="End"
                                                Command="{Binding Path=BindingContext.DeleteNovelCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding Id}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <BoxView Style="{StaticResource HSep}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Bottom bar：主行动直接落在地面上，不再套一层同色的空盒子 -->
        <Button Grid.Row="3" Text="导入小说，创建新世界" Style="{StaticResource BtnNeumorph}"
                Margin="{DynamicResource WPadCard}"
                Command="{Binding ImportNovelCommand}" />
    </Grid>
</ContentPage>
