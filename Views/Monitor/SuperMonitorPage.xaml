<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WarmAsBefore.Controls"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:dev="clr-namespace:WarmAsBefore.Services.Dev"
             x:Class="WarmAsBefore.Views.SuperMonitorPage"
             x:Name="Root"
             x:DataType="vm:SuperMonitorViewModel"
             Title="超级监测"
             BackgroundColor="{DynamicResource PageBg}">

    <!-- ============ 页面骨架（UI 标准书 3.1）：顶栏 → 发丝线 → 工作台 ============
         这一页是 R5 工作台式：左边看「系统怎么跑」（架构活流程图 + 3D 向量），
         右边读「系统现在怎么样」（选中节点详情 / 日程 / 器官 / 记忆层 / 数值）。
         以前所有卡片竖着摞在同一列：日程被切成 150px 的小窗、画布被上下两块卡夹住、
         器官与记忆层根本没有地方显示 —— 读起来就是「全挤在顶上」。
         现在只有两个容器：一块画布 + 一条右栏，栏内用 HSep 分组而不是卡套卡。 -->
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <!-- ============ 顶栏：返回 · 角色 · 3D 开关 · 刷新 ============ -->
        <Border Grid.Row="0" BackgroundColor="{DynamicResource WBarBrush}" StrokeThickness="0"
                Padding="{DynamicResource WPadWell}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Button Grid.Column="0" Text="←" Style="{StaticResource BtnGhostSm}" WidthRequest="34"
                        VerticalOptions="Center" Command="{Binding BackCommand}" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="// VITALS" Style="{StaticResource Eyebrow}" />
                    <Label Text="{Binding CharacterName}" Style="{StaticResource TxtTitle}"
                           MaxLines="1" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding DateText}" Style="{StaticResource TxtCaption}" MaxLines="1"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button Grid.Column="3" Text="刷新" Style="{StaticResource BtnGhostSm}"
                        VerticalOptions="Center" Command="{Binding LoadCommand}" />
            </Grid>
        </Border>

        <BoxView Grid.Row="1" Style="{StaticResource HSep}" />

        <!-- ============ 工作台：左画布 / 右读数栏（窄窗由 code-behind 折成一列） ============ -->
        <Grid Grid.Row="2" x:Name="BodyGrid"
              RowDefinitions="*" ColumnDefinitions="*,360"
              HorizontalOptions="Center" MaximumWidthRequest="{DynamicResource WCardWidthWide}"
              Padding="{DynamicResource WPageMargin}">

            <!-- 左：架构活流程图（+ 可选 3D 向量覆盖层） -->
            <Grid x:Name="CanvasHost" Grid.Row="0" Grid.Column="0"
                  RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                <!-- 标题 + 三盏状态灯：专注（暖）/ 神游（冷）/ 神游介入（红，会闪）。
                     这是整页的状态，不是某一格的属性，所以放在画布顶上。 -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="架构活动流程图" Style="{StaticResource TxtSection}" />
                        <Label Text="对话执行时，流经的节点会亮起；点任意节点看它的读数与影响"
                               Style="{StaticResource TxtCaption}" MaxLines="2" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="End" VerticalOptions="Center">
                        <Label Text="{Binding AmbientTitle}" Style="{StaticResource TxtSection}"
                               HorizontalTextAlignment="End" />
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="End">
                            <HorizontalStackLayout Spacing="5">
                                <Border BackgroundColor="{Binding FocusLampColor}" StrokeThickness="0"
                                        WidthRequest="9" HeightRequest="9" StrokeShape="RoundRectangle 99"
                                        VerticalOptions="Center" />
                                <Label Text="{Binding FocusLampText}" Style="{StaticResource TxtCaption}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="5">
                                <Border BackgroundColor="{Binding WanderLampColor}" StrokeThickness="0"
                                        WidthRequest="9" HeightRequest="9" StrokeShape="RoundRectangle 99"
                                        VerticalOptions="Center" />
                                <Label Text="{Binding WanderLampText}" Style="{StaticResource TxtCaption}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="5">
                                <Border BackgroundColor="{Binding AlarmLampColor}" StrokeThickness="0"
                                        WidthRequest="9" HeightRequest="9" StrokeShape="RoundRectangle 99"
                                        VerticalOptions="Center" />
                                <Label Text="{Binding AlarmLampText}" Style="{StaticResource TxtCaption}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                        <Label Text="{Binding AmbientDetail}" Style="{StaticResource TxtCaption}"
                               MaxLines="2" LineBreakMode="TailTruncation"
                               FlowDirection="{Binding AmbientDetail, Converter={StaticResource BidiFlow}}"
                               HorizontalTextAlignment="{Binding AmbientDetail, Converter={StaticResource BidiAlign}}"
                               MaximumWidthRequest="330" />
                    </VerticalStackLayout>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardSolid}" Padding="4">
                    <Grid>
                        <!-- 流程图按内容自然尺寸绘制，装不下就滚动，不再等比压缩挤成一团 -->
                        <ScrollView Orientation="Both"
                                    HorizontalScrollBarVisibility="Default"
                                    VerticalScrollBarVisibility="Default">
                            <GraphicsView x:Name="ArchCanvas"
                                          EndInteraction="OnCanvasEnd"
                                          WidthRequest="{Binding CanvasWidth}"
                                          HeightRequest="{Binding CanvasHeight}"
                                          BackgroundColor="Transparent" />
                        </ScrollView>
                    </Grid>
                </Border>

                <!-- 向量空间：三维坐标系由 2D 投影画出来（不走原生 3D，见 VectorCloudDrawable），
                     右边并排列出每个点的坐标与它对应的那句话。 -->
                <Border Grid.Row="2" Style="{StaticResource CardSolid}" Padding="8">
                    <Grid ColumnDefinitions="*,236" ColumnSpacing="8" RowDefinitions="Auto,*">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="向量空间" Style="{StaticResource TxtSection}" />
                            <!-- 副标题就是状态：有点时是「量化模型算出的 N 条…」，没点时是原因，
                                 不再写一句永远成立不了的承诺。 -->
                            <Label Text="{Binding VectorNote}"
                                   Style="{StaticResource TxtCaption}" MaxLines="3" LineBreakMode="WordWrap"
                                   FlowDirection="{Binding VectorNote, Converter={StaticResource BidiFlow}}"
                                   HorizontalTextAlignment="{Binding VectorNote, Converter={StaticResource BidiAlign}}" />
                        </VerticalStackLayout>
                        <Label Grid.Row="0" Grid.Column="1" Text="坐标 · 词语" Style="{StaticResource TxtCaption}"
                               VerticalOptions="End" HorizontalOptions="End" />
                        <GraphicsView Grid.Row="1" Grid.Column="0" x:Name="VectorCanvas"
                                      HeightRequest="300" BackgroundColor="Transparent" />
                        <CollectionView Grid.Row="1" Grid.Column="1" ItemsSource="{Binding VectorRows}"
                                        HeightRequest="300" VerticalScrollBarVisibility="Always">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:VectorCloudRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Padding="0,3">
                                        <Label Grid.Column="0" Text="{Binding Word}"
                                               Style="{StaticResource TxtCaption}" MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" Text="{Binding Coords}"
                                               Style="{StaticResource TxtCaption}"
                                               FontFamily="Consolas" HorizontalOptions="End" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <VerticalStackLayout Grid.Row="3" Spacing="2">
                    <Label Text="{Binding StatusText}" Style="{StaticResource TxtCaption}" MaxLines="2"
                           LineBreakMode="TailTruncation" ToolTipProperties.Text="{Binding StatusText}"
                           FlowDirection="{Binding StatusText, Converter={StaticResource BidiFlow}}"
                           HorizontalTextAlignment="{Binding StatusText, Converter={StaticResource BidiAlign}}" />
                    <Label Text="{Binding InfluenceNote}" Style="{StaticResource TxtCaption}" MaxLines="2"
                           LineBreakMode="TailTruncation" ToolTipProperties.Text="{Binding InfluenceNote}"
                           FlowDirection="{Binding InfluenceNote, Converter={StaticResource BidiFlow}}"
                           HorizontalTextAlignment="{Binding InfluenceNote, Converter={StaticResource BidiAlign}}"
                           IsVisible="{Binding HasSelection}" />
                </VerticalStackLayout>
            </Grid>

            <!-- 右：读数栏。选中节点是此刻的焦点，独占一张浮阶卡（全屏配额 1） -->
            <Grid x:Name="RailHost" Grid.Row="0" Grid.Column="1"
                  RowDefinitions="Auto,*" RowSpacing="8">

                <Border Grid.Row="0" IsVisible="{Binding HasSelection}"
                        Style="{StaticResource CardNeumorph}" Padding="{DynamicResource WPadCard}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding SelectedNode.Title}" Style="{StaticResource TxtSubhead}"
                               MaxLines="2" LineBreakMode="TailTruncation"
                               ToolTipProperties.Text="{Binding SelectedNode.Title}" />
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{Binding SelectedNode.Group}" Style="{StaticResource TxtCaption}" />
                            <Label Text="{Binding SelectedNode.Status}" Style="{StaticResource TxtCaption}" />
                        </HorizontalStackLayout>
                        <Button Text="打开这个模块的页面"
                                Command="{Binding OpenInspectorCommand}"
                                Style="{StaticResource BtnGhost}" />
                        <BoxView Style="{StaticResource HSep}" />
                        <ScrollView MaximumHeightRequest="260">
                            <VerticalStackLayout Spacing="8"
                                                 BindableLayout.ItemsSource="{Binding DetailLines}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SuperMonitorViewModel+DetailLine">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="{Binding Label}" Style="{StaticResource TxtCaption}" MaxLines="1" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Value, Converter={StaticResource SoftWrap}}"
                                                   Style="{StaticResource TxtBodySm}"
                                                   LineBreakMode="WordWrap"
                                                   FlowDirection="{Binding Value, Converter={StaticResource BidiFlow}}"
                                                   HorizontalTextAlignment="{Binding Value, Converter={StaticResource BidiAlign}}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardSolid}" Padding="0">
                    <ScrollView Padding="{DynamicResource WPadCard}">
                        <VerticalStackLayout Spacing="0">

                            <!-- 今日日程：这一栏是一条滚动流同时装四块（日程 / 器官 / 记忆分层 / 数值），
                                 所以日程既不换 CollectionView（滚动套滚动 = LayoutCycleException 的老坑，
                                 给它单开一个星号行又要把下面三块挤没），而是分页：先铺 50 条，
                                 「再加载」续 50 条 —— 一次只测 50 行，日程攒到上千条也不卡。 -->
                            <Label Text="今日日程" Style="{StaticResource TxtSection}" />
                            <Label Text="今天还没有日程：她还没排，或者这一档刚开局"
                                   Style="{StaticResource TxtRowDesc}" Margin="0,2,0,4" LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasTimeline, Converter={StaticResource InverseBool}}" />
                            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Timeline}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SuperMonitorViewModel+TimelineRow">
                                        <Grid ColumnDefinitions="52,28,*" ColumnSpacing="6" Padding="0,4">
                                            <Label Grid.Column="0" Text="{Binding Time}"
                                                   Style="{StaticResource TxtCaption}" VerticalOptions="Center" />
                                            <!-- 勾选走 MarkDone（写盘 + 广播 Changed），不直接改 item.Done -->
                                            <Button Grid.Column="1" Text="{Binding Mark}"
                                                    Style="{StaticResource BtnTextSm}" Padding="0"
                                                    WidthRequest="28" VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SuperMonitorViewModel}}, Path=ToggleDoneCommand}"
                                                    CommandParameter="{Binding Id}" />
                                            <VerticalStackLayout Grid.Column="2" Spacing="0">
                                                <Label Text="{Binding Title}" Style="{StaticResource TxtRowTitle}"
                                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Detail}" Style="{StaticResource TxtRowDesc}"
                                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0"
                                  IsVisible="{Binding HasMoreTimeline}">
                                <Label Text="{Binding TimelineNote}" Style="{StaticResource TxtRowDesc}"
                                       VerticalOptions="Center" LineBreakMode="WordWrap" />
                                <Button Grid.Column="1" Text="再加载 50 条" Style="{StaticResource BtnGhostSm}"
                                        Command="{Binding LoadMoreTimelineCommand}" />
                            </Grid>
                            <BoxView Style="{StaticResource HSep}" Margin="0,10" />

                            <!-- 器官：名字 + 状态 + 当前值（点画布上的器官节点看连锁影响） -->
                            <Label Text="器官状态" Style="{StaticResource TxtSection}" />
                            <Label Text="还没有器官读数：躯体化服务还没开始记"
                                   Style="{StaticResource TxtRowDesc}" Margin="0,2,0,4" LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasOrgans, Converter={StaticResource InverseBool}}" />
                            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Organs}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SuperMonitorViewModel+OrganRow">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,4">
                                            <Label Grid.Column="0" Text="{Binding Name}"
                                                   Style="{StaticResource TxtRowTitle}" MaxLines="1"
                                                   LineBreakMode="TailTruncation" ToolTipProperties.Text="{Binding Name}" />
                                            <Label Grid.Column="1" Text="{Binding Status}"
                                                   Style="{StaticResource TxtRowDesc}" VerticalOptions="Center"
                                                   MaxLines="1" LineBreakMode="TailTruncation" />
                                            <!-- 数值列给足 60：44 装不下 9999 / -1 这类极端读数 -->
                                            <Label Grid.Column="2" Text="{Binding Value}"
                                                   Style="{StaticResource TxtBodySm}" WidthRequest="60"
                                                   HorizontalTextAlignment="End" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <BoxView Style="{StaticResource HSep}" Margin="0,10" />

                            <!-- 记忆分层：层名 + 数量（点记忆节点看这一层的说明） -->
                            <Label Text="记忆分层" Style="{StaticResource TxtSection}" />
                            <Label Text="五层都还是 0：和她聊几句，这里会开始长"
                                   Style="{StaticResource TxtRowDesc}" Margin="0,2,0,4" LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasLayers, Converter={StaticResource InverseBool}}" />
                            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding MemoryLayers}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SuperMonitorViewModel+LayerRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,4">
                                            <Label Grid.Column="0" Text="{Binding Name}"
                                                   Style="{StaticResource TxtRowTitle}" MaxLines="1"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1" Text="{Binding Count}"
                                                   Style="{StaticResource TxtRowDesc}" VerticalOptions="Center"
                                                   MaxLines="1" LineBreakMode="TailTruncation"
                                                   FlowDirection="{Binding Count, Converter={StaticResource BidiFlow}}"
                                                   HorizontalTextAlignment="{Binding Count, Converter={StaticResource BidiAlign}}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <BoxView Style="{StaticResource HSep}" Margin="0,10" />

                            <!-- 数值：好感 / 信任 / 精力 -->
                            <Label Text="关系数值" Style="{StaticResource TxtSection}" />
                            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Stats}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SuperMonitorViewModel+StatRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,4">
                                            <Label Grid.Column="0" Text="{Binding Name}"
                                                   Style="{StaticResource TxtRowTitle}" MaxLines="1"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1" Text="{Binding Value}"
                                                   Style="{StaticResource TxtBodySm}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>
        </Grid>

        <!-- dev 压测条：带 worst 启动参数时贴在窗口底边中央，其余时候 0 宽 0 高 -->
        <dev:WorstCaseBar Grid.RowSpan="3" />
    </Grid>
</ContentPage>
