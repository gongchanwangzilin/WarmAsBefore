<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.NovelWorldPage"
             x:DataType="vm:NovelWorldViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBgBrush}">

    <!--
      世界对话页。上下两条 bar 原来是「整宽的描边条」（GlassBarBg/Stroke），
      在这套语言里读起来像贴上去的另一种材质：改成与内容区同一块地 + 一根发丝线。
      气泡的底与字由 BubbleMine / BubbleTheirs 两档令牌给出，视图模型只标「谁说的」。
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="0">

        <!-- Header -->
        <Border Background="{DynamicResource WBarBrush}" StrokeThickness="0"
                Padding="{DynamicResource WPadWell}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Text="&lt; 返回" Style="{StaticResource BtnText}"
                        Padding="0" VerticalOptions="Center"
                        Command="{Binding GoBackCommand}" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                    <Label Text="{Binding Title}" Style="{StaticResource TxtSubhead}"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding WorldLabel}" Style="{StaticResource TxtCaption}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsThinking}"
                                   IsVisible="{Binding IsThinking}" Color="{DynamicResource PrimaryAction}"
                                   WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
            </Grid>
        </Border>
        <BoxView Grid.Row="1" Color="{DynamicResource WRule}" HeightRequest="1" HorizontalOptions="Fill" />

        <!-- Messages -->
        <ScrollView Grid.Row="2" x:Name="MsgScroll">
            <VerticalStackLayout Spacing="6" Padding="{DynamicResource WPadCard}"
                                 BindableLayout.ItemsSource="{Binding Messages}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:NovelMessage">
                        <Grid>
                            <Border IsVisible="{Binding ShowMine}"
                                    BackgroundColor="{DynamicResource BubbleMine}" StrokeThickness="0"
                                    Padding="{DynamicResource WPadWell}"
                                    HorizontalOptions="End"
                                    MaximumWidthRequest="480"
                                    StrokeShape="{DynamicResource WRadiusWell}">
                                <Label Text="{Binding Text}" TextColor="{DynamicResource SurfaceFg}"
                                       Style="{StaticResource TxtBody}" LineBreakMode="WordWrap" />
                            </Border>
                            <Border IsVisible="{Binding ShowTheirs}"
                                    BackgroundColor="{DynamicResource BubbleTheirs}" StrokeThickness="0"
                                    Padding="{DynamicResource WPadWell}"
                                    HorizontalOptions="Start"
                                    MaximumWidthRequest="480"
                                    StrokeShape="{DynamicResource WRadiusWell}">
                                <Label Text="{Binding Text}" TextColor="{DynamicResource SurfaceFg}"
                                       Style="{StaticResource TxtBody}" LineBreakMode="WordWrap" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Input -->
        <BoxView Grid.Row="3" Color="{DynamicResource WRule}" HeightRequest="1" HorizontalOptions="Fill" />
        <Border Grid.Row="4" Background="{DynamicResource WBarBrush}" StrokeThickness="0"
                Padding="{DynamicResource WPadWell}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <!-- 输入是一条井（比卡面沉一档），不是一块贴上去的白 -->
                <Border Background="{DynamicResource WWellBrush}" StrokeThickness="0" Padding="10,0"
                        StrokeShape="{DynamicResource WRadiusPill}">
                    <Entry Text="{Binding InputText}"
                           Placeholder="对这个世界说点什么…"
                           PlaceholderColor="{DynamicResource MutedFg}"
                           BackgroundColor="Transparent"
                           TextColor="{DynamicResource SurfaceFg}" FontSize="{DynamicResource WSizeBody}"
                           ReturnCommand="{Binding SendCommand}"
                           HeightRequest="40" />
                </Border>
                <Button Grid.Column="1" Text="发送" Style="{StaticResource BtnPrimary}"
                        HeightRequest="40" WidthRequest="64" Padding="0"
                        Command="{Binding SendCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
