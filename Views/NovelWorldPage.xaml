<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.NovelWorldPage"
             x:DataType="vm:NovelWorldViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- Header -->
        <Border BackgroundColor="{StaticResource SurfaceBg}" Padding="16,12,16,12"
                StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Text="&lt; 返回" Style="{StaticResource BtnText}"
                        FontSize="14" Padding="0"
                        Command="{Binding GoBackCommand}" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                    <Label Text="{Binding Title}" Style="{StaticResource TxtSubhead}"
                           FontSize="16" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding WorldLabel}" Style="{StaticResource TxtCaption}"
                           FontSize="11" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsThinking}"
                                   IsVisible="{Binding IsThinking}" Color="{StaticResource PrimaryAction}"
                                   WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Messages -->
        <ScrollView Grid.Row="1" Margin="0,4" x:Name="MsgScroll">
            <VerticalStackLayout Spacing="6" Padding="12,8"
                                 BindableLayout.ItemsSource="{Binding Messages}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:NovelMessage">
                        <Border BackgroundColor="{Binding BgColor}" StrokeThickness="0"
                                Padding="10,8" Margin="0,2"
                                HorizontalOptions="{Binding Align}"
                                MaximumWidthRequest="480">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Label Text="{Binding Text}" TextColor="{Binding TextColor}"
                                   FontSize="14" LineBreakMode="WordWrap" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Input -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource SurfaceBg}"
                Padding="12,8,12,12" StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border BackgroundColor="{StaticResource InputBg}" StrokeThickness="0" Padding="10,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Entry Text="{Binding InputText}"
                           Placeholder="对这个世界说点什么…"
                           PlaceholderColor="{StaticResource WarmMuted}"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource SurfaceFg}" FontSize="13"
                           ReturnCommand="{Binding SendCommand}"
                           HeightRequest="40" />
                </Border>
                <Button Grid.Column="1" Text="发送"
                        BackgroundColor="{StaticResource PrimaryAction}" TextColor="{StaticResource PrimaryFg}"
                        FontSize="13" FontAttributes="Bold"
                        CornerRadius="20" HeightRequest="40" WidthRequest="64"
                        Padding="0"
                        Command="{Binding SendCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
