<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:motion="clr-namespace:WarmAsBefore.Helpers"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             x:Class="WarmAsBefore.Views.MapPage"
             x:Name="MapPageRoot"
             x:DataType="vm:MapViewModel"
             Title="地图"
             Background="{DynamicResource PageBgBrush}">

    <Grid Padding="0" RowDefinitions="Auto,*,Auto">

        <!-- Header：工具条与画布之外是同一块地，不再是一块深色板 ——
             深底逼着所有文字都用 OffWhite50/Cream200 这些「面」当字，切到深色世界时整排糊掉。 -->
        <Border Background="{DynamicResource WBarBrush}" StrokeThickness="0" Padding="{DynamicResource WPadWell}">
            <Border.StrokeShape><RoundRectangle CornerRadius="0" /></Border.StrokeShape>
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <!-- 第一行：标题 + 模式切换 + 工具。钮多（14 颗），窄窗时整条横向滚动，
                     不再把标题挤成零宽、把最后几颗裁掉。 -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="地图编辑器" Style="{StaticResource TxtTitle}" />
                        <Label Text="{Binding StatusText}" TextColor="{DynamicResource MutedFg}" FontSize="{DynamicResource WSizeCaption}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                        <Label Text="{Binding LocationLabel, StringFormat='当前位置：{0}'}"
                               TextColor="{DynamicResource SurfaceFg}" FontSize="{DynamicResource WSizeCaption}"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                                VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8">
                            <!-- 一排同档的次级钮（白底 + 一道缝）：当前模式由文字前的「●」说，不靠其中一颗涂成深色 -->
                            <Button Text="{Binding ViewModeLabel}" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding SetModeCommand}" CommandParameter="view" />
                            <Button Text="{Binding EditModeLabel}" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding SetModeCommand}" CommandParameter="edit" />
                            <Button Text="{Binding LinkModeLabel}" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding SetModeCommand}" CommandParameter="link" />
                            <Button Text="{Binding LinkKindText}" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding ToggleLinkKindCommand}"
                                    IsVisible="{Binding IsLinkMode}" />
                            <Button Text="{Binding DoodleModeLabel}" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding SetModeCommand}" CommandParameter="doodle" />
                            <Button Text="↻ 重置布局" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding ResetLayoutCommand}" />
                            <Button Text="导出" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding ExportMapCommand}" />
                            <Button Text="创建地图…" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding CreateMapCommand}" />
                            <!-- 天气来源：这张图按哪儿算（跟随用户 / 地图当地 / 自定义地点） -->
                            <Button Text="{Binding WeatherModeLabel}" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding PickWeatherModeCommand}" />
                            <!-- 取景/导入：手机端取景、电脑端导入，同一页两面 -->
                            <Button Text="取景 / 导入" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding OpenCaptureCommand}" />
                            <!-- 3D 灰度：同一张图的街面读法（编辑器保持 2D 不变） -->
                            <Button Text="3D 灰度" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding Open3dCommand}" />
                            <!-- 流程图：规则（时机 + 条件 + 动作） -->
                            <Button Text="流程图" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding OpenFlowsCommand}" />
                            <Button Text="返回" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding BackCommand}" />
                            <Button Text="ℹ 帮助" Style="{StaticResource BtnNeumorphSm}"
                                    Command="{Binding HelpCommand}" />
                        </HorizontalStackLayout>
                    </ScrollView>
                </Grid>

                <!-- 编辑模式提示行 -->
                <Grid Grid.Row="1" IsVisible="{Binding IsEditMode}" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <Label Text="编辑：拖卡片=移动 · 空白拖动=平移 · 按住空白 0.6秒再拖=框选地点 · 右键=菜单" 
                           TextColor="{DynamicResource MutedFg}" FontSize="{DynamicResource WSizeCaption}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="＋ 新地点" Style="{StaticResource BtnNeumorphSm}"
                            HeightRequest="32" Command="{Binding AddLocationCommand}" />
                    <Button Grid.Column="2" Text="＋ 新场景 / 临时节点" Style="{StaticResource BtnNeumorphSm}"
                            HeightRequest="32" Command="{Binding AddSceneCommand}" />
                    <Button Grid.Column="3" Text="背景（素材库）" Style="{StaticResource BtnNeumorphSm}"
                            HeightRequest="32" Command="{Binding BackgroundFromLibraryCommand}" />
                    <Button Grid.Column="4" Text="AI 画背景" Style="{StaticResource BtnNeumorphSm}"
                            HeightRequest="32" Command="{Binding GenerateBackgroundCommand}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 画布：占满窗口，平移缩放由内部视图实现 -->
        <GraphicsView Grid.Row="1" x:Name="MapCanvas"
                      StartInteraction="OnCanvasStart"
                      DragInteraction="OnCanvasDrag"
                      EndInteraction="OnCanvasEnd"
                      BackgroundColor="Transparent" />

        <!-- 楼层条：贴在画布右缘竖着摞，顶层在上、地下在下（FloorsOf 的次序）。
             当前层由强调底 + 加粗大号字说；「全部」或再点当前层退出分层视图。
             点层 = 切层动画（缩放与位移一起走的「抬层」），不是硬闪。 -->
        <Border Grid.Row="1" IsVisible="{Binding HasFloorBar}"
                HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,14,0"
                Background="{DynamicResource WBarBrush}" Stroke="{DynamicResource WControlEdgeBrush}"
                StrokeThickness="{DynamicResource WControlEdgeWidth}" Padding="6"
                StrokeShape="{DynamicResource WRadiusRaised}">
            <VerticalStackLayout Spacing="4" WidthRequest="88">
                <Label Text="{Binding FloorBarTitle}" Style="{StaticResource TxtMuted}"
                       HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding FloorChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:FloorChip">
                            <Border motion:HoverFeel.Enabled="True" motion:PressFeel.Enabled="True"
                                    BackgroundColor="{DynamicResource WWellBrush}" StrokeThickness="0"
                                    Padding="8,6">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TapCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" FontSize="13" HorizontalTextAlignment="Center"
                                       TextColor="{DynamicResource SurfaceFg}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="FontSize" Value="15" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsAll}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource MutedFg}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource WAccentBrush}" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- 底部：模式操作提示。CardSolid 已经把缝发到画刷（WEdgeBrush）上 ——
             原来这里写 Stroke="{DynamicResource BorderLine}"，那是个 Color 键，Border.Stroke 只吃画刷。 -->
        <Border Grid.Row="2" Style="{StaticResource CardSolid}"
                IsVisible="{Binding IsEditMode}"
                Margin="12,0,12,12" VerticalOptions="End">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Border Background="{DynamicResource WWellBrush}" StrokeThickness="0" Padding="12,0"
                        StrokeShape="{DynamicResource WRadiusWell}">
                    <Label Text="{Binding SelectedNodeLabel}" Style="{StaticResource TxtBodySm}"
                           VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="拖拽卡片调整位置" Style="{StaticResource TxtMuted}"
                       VerticalOptions="Center" />
                <Button Grid.Column="2" Text="删除" Style="{StaticResource BtnDangerSm}"
                        HeightRequest="36" Command="{Binding RemoveSceneCommand}"
                        IsVisible="{Binding HasSelection}" />
                <Button Grid.Column="3" Text="返回" Style="{StaticResource BtnGhostSm}"
                        HeightRequest="36" Command="{Binding BackCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>