<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:motion="clr-namespace:WarmAsBefore.Helpers" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WarmAsBefore.ViewModels"
             xmlns:i18n="clr-namespace:WarmAsBefore.Services"
             x:Class="WarmAsBefore.Views.PetPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{OnPlatform WinUI='#4A3D2C', Default='#1E1712'}">
    <!-- Windows：这一页不再是「舞台」，只剩头顶那条对话小窗，底色就是小窗本身（窗口表面不透明，
         圆角交给 DWM）。立绘改由 PetLayeredWindow 按像素 alpha 直接贴在桌面上，四周与脚下没有矩形。
         其余平台：全屏问答模式，深色舞台底仍然必要——页面上所有文字都是白色系。 -->

    <Grid Padding="0">
        <!-- 顶部：输入条 + 回复气泡共用一个纵向栈。
             Windows 上这条就是小窗的全部内容，整条小窗靠显隐控制（不再藏输入条本身）；
             气泡出现时小窗长高，输入行位置不动。 -->
        <VerticalStackLayout VerticalOptions="Start" Spacing="6"
                             Margin="{OnPlatform WinUI='0,0,0,0', Default='8,6,8,0'}">
            <Border x:Name="InputBar" StrokeThickness="0" Padding="8,6"
                    BackgroundColor="{OnPlatform WinUI='Transparent', Default='#E64A3D2C'}"
                    IsVisible="{OnPlatform WinUI=True, Default=False}">
                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <Entry x:Name="InputEntry" TextColor="White" PlaceholderColor="#AAFFFFFF"
                           Placeholder="和 TA 说点什么…" BackgroundColor="#22FFFFFF"
                           FontSize="12" VerticalOptions="Center"
                           Completed="OnSend" />
                    <!-- 语音输入：识别结果填进输入框，不自动发送——说错了还能改 -->
                    <Button Grid.Column="1" x:Name="MicButton" Text="🎤" FontSize="12" TextColor="White"
                            BackgroundColor="#33FFFFFF" CornerRadius="10" Padding="10,4"
                            Clicked="OnMicClicked" />
                    <Button Grid.Column="2" Text="发送" FontSize="12" TextColor="White"
                            BackgroundColor="#33FFFFFF" CornerRadius="10" Padding="12,4"
                            Clicked="OnSend" />
                </Grid>
            </Border>

            <!-- 回复气泡：桌宠对话时显示 AI 回复 / 思考中…
                 不再限 MaxLines——换行后整段都要看得见，小窗高度由 PetService 按实测文本高度调。
                 超长时 code-behind 会截断到放得下的行数，而不是让它在窗口外被切掉。 -->
            <Border x:Name="ReplyBubble" StrokeThickness="0" Padding="10,6" IsVisible="False"
                    BackgroundColor="{OnPlatform WinUI='Transparent', Default='#CC4A3D2C'}">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Label x:Name="ReplyLabel" TextColor="White" FontSize="12"
                       LineBreakMode="WordWrap" />
            </Border>
        </VerticalStackLayout>

        <!-- 立绘区域：只有移动端用。Windows 的角色站在桌面上，不在这一页里。
             双击回主窗口（输入行与气泡不挂手势，避免抢焦点） -->
        <Grid motion:HoverFeel.Enabled="True" motion:PressFeel.Enabled="True" x:Name="SpriteArea" VerticalOptions="Fill" Margin="0,58,0,50"
              IsVisible="{OnPlatform WinUI=False, Default=True}">
            <Grid.GestureRecognizers>
                <!-- 单击=思考（自言自语嘀咕一句）；双击=回主窗口。单击在 code-behind 里延迟判定，避免被双击抢走。 -->
                <TapGestureRecognizer Tapped="OnSingleTapped" NumberOfTapsRequired="1" />
                <TapGestureRecognizer Tapped="OnDoubleTapped" NumberOfTapsRequired="2" />
            </Grid.GestureRecognizers>

            <!-- 立绘（PNG 自带透明通道）；#E4：可捏合缩放 / 拖动移动 -->
            <Image x:Name="SpriteImage" Aspect="AspectFit"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   Margin="6,0,6,30">
                <Image.GestureRecognizers>
                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                </Image.GestureRecognizers>
            </Image>
            <!-- 名字角标 -->
            <Border BackgroundColor="#7A4A3D2C" StrokeThickness="0"
                    Padding="14,5" HorizontalOptions="Center" VerticalOptions="End"
                    Margin="0,0,0,6">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Label x:Name="NameLabel" TextColor="White" FontSize="12" />
            </Border>
        </Grid>

        <!-- 返回按钮：挪到左下角，不再和顶部输入条抢位置。Windows 上双击角色就回去了，
             小窗里没有它的位置。 -->
        <Button x:Name="BackButton" Text="← 返回"
                TextColor="#CCFFFFFF"
                BackgroundColor="#7A4A3D2C"
                FontSize="12" Padding="10,0" CornerRadius="14" HeightRequest="28"
                HorizontalOptions="Start" VerticalOptions="End"
                Margin="8,0,0,8"
                IsVisible="{OnPlatform WinUI=False, Default=True}"
                Clicked="OnBack" />
    </Grid>
</ContentPage>
