<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="WarmAsBefore.DesignSystem.Styles.TextTypography">

    <!--
      字阶。字号不再写死在这里：每个世界的台阶不一样 ——
      柔和极简靠留白和字重分家，字号收得很紧（显示 26 / 标题 20 / 正文 15，对标桌面系统 UI）；
      液态玻璃要盖在通透的面上，字必须更大才压得住（显示 34 / 正文 16）。
      颜色一律走语义墨阶（WarmDark/SurfaceFg/MutedFg…），它们由世界按对比比算出来，
      所以「说明行和正文一个重量」这类问题不可能再从字典里写回来。
    -->

    <Style x:Key="TxtDisplay" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource WSizeDisplay}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource WarmDark}" />
    </Style>

    <Style x:Key="TxtTitle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource WSizeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource WarmDark}" />
    </Style>

    <Style x:Key="TxtSubhead" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource WSizeSubhead}" />
        <!-- 小标题要重一档：只比正文大两号又同权重，等于没分层 -->
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource SurfaceFg}" />
    </Style>

    <Style x:Key="TxtBody" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource WSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource SurfaceFg}" />
    </Style>

    <Style x:Key="TxtBodySm" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource WSizeSmall}" />
        <Setter Property="TextColor" Value="{DynamicResource SurfaceFg}" />
    </Style>

    <Style x:Key="TxtCaption" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource WSizeCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource MutedFg}" />
    </Style>

    <!-- 辅助说明：走 MutedFg 这一档墨（世界保证 ≥5:1）。 -->
    <Style x:Key="TxtMuted" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource WSizeSmall}" />
        <Setter Property="TextColor" Value="{DynamicResource MutedFg}" />
    </Style>

    <!-- 分组标题：比正文小一档、重一档，靠上方留白和上一组分开，不靠颜色变淡。 -->
    <Style x:Key="TxtSection" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource WSizeSmall}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource WarmBody}" />
        <Setter Property="Margin" Value="4,26,0,12" />
    </Style>

    <!-- 行标题：一行设置项的主语。极简档没有边框也没有影子，一行的「主」只能靠字重 ——
         所以它是加粗的正文号，而不是淡一号的同权重字。颜色用最深那档墨。 -->
    <Style x:Key="TxtRowTitle" TargetType="Label" BasedOn="{StaticResource TxtBody}">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource WarmDark}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- 行说明：跟在标题下面的一行灰字。换行要收紧，否则两行的行高会把整行顶散。 -->
    <Style x:Key="TxtRowDesc" TargetType="Label" BasedOn="{StaticResource TxtMuted}">
        <Setter Property="FontSize" Value="{DynamicResource WSizeCaption}" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>

    <!-- 眉标：宽体大写拉丁，压在小字上。原在角色库/工作室/新建向导/新开局/世界书五处页内各存一份，
         现入系统：顶栏一排、列表头一排、预览里一排，三排说的是三件事（沿用角色库的注释结论）。 -->
    <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="CharacterSpacing" Value="3" />
        <Setter Property="FontSize" Value="{DynamicResource WSizeCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource WarmFaint}" />
    </Style>

    <!-- 信号色标签：当前项、链接、展开/收起这类「可点但不是按钮」的文字。
         全应用只有这一处用饱和色当文字，所以它一说、别处就不用再说。 -->
    <Style x:Key="TxtSignal" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource WSizeSmall}" />
        <Setter Property="TextColor" Value="{DynamicResource SignalFg}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

</ResourceDictionary>
