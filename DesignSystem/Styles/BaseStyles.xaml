<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="WarmAsBefore.DesignSystem.Styles.BaseStyles">

    <!-- 语义色由 StyleWorld 每次换档时写进应用级顶层字典，色板（Theme/ColorPalette*.xaml）只提供色相种子；
         这里因此只可能引用名字，任何写死的颜色都会在换世界/换明暗时留下一半不属于当前档的界面。 -->

    <!-- Page Defaults -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
        <Setter Property="ForegroundColor" Value="{DynamicResource SurfaceFg}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource PrimaryAction}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource PrimaryAction}" />
    </Style>

    <!-- 原生三件套的暖皮：颜色必须走语义资源（世界会整档刷新），尺寸/形状交回平台默认，
         自绘件的 ControlTemplate 级手艺记在愿望单（.local/ui-wishlist.md）。 -->
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource PrimaryAction}" />
        <Setter Property="ThumbColor" Value="{DynamicResource PageBg}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource PrimaryAction}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource WSep}" />
        <Setter Property="ThumbColor" Value="{DynamicResource PrimaryAction}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource SurfaceFg}" />
        <Setter Property="TitleColor" Value="{DynamicResource MutedFg}" />
    </Style>

</ResourceDictionary>