<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="WarmAsBefore.DesignSystem.Styles.BaseStyles">

    <!-- 语义色由 StyleWorld 每次换档时写进应用级顶层字典，色板（Theme/ColorPalette*.xaml）只提供色相种子；
         这里因此只可能引用名字，任何写死的颜色都会在换世界/换明暗时留下一半不属于当前档的界面。 -->

    <!-- Page Defaults -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
        <Setter Property="ForegroundColor" Value="{DynamicResource SurfaceFg}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource PrimaryAction}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource PrimaryAction}" />
    </Style>

</ResourceDictionary>