<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="WarmAsBefore.DesignSystem.Styles.GlassEffects">

    <Style x:Key="EffGlassBg" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="#B3FDF6EE" />
    </Style>

    <Style x:Key="EffFrostBg" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="#80FEFCF8" />
    </Style>

    <Style x:Key="EffLiquidBg" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="#CCFDF6EE" />
    </Style>

</ResourceDictionary>