<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:motion="clr-namespace:WarmAsBefore.Helpers"
                    x:Class="WarmAsBefore.DesignSystem.Styles.NeumorphicStyles">

    <!--
      浮档 / 凹档 / 按钮 / 标签块。
      键名里的 Neumorph 是历史包袱（这套拟物已经退役），但页面里有几百处按名字引用，
      改名只会制造一次没有意义的机械替换 —— 留名，换掉里面的材质。
      现在这里没有任何具体数值：颜色、圆角、缝、影、内距全部由 StyleWorld 下发。

      状态组里**永远不换 Shadow**：WinUI 换阴影会重建合成层，实测点过的按钮返回后
      保住布局位置却不再绘制。位移交给 PressFeel，缩放留给布局重算的坑，都不在这里做。
    -->

    <!-- 浮档：此刻要动它的那一张。轻质感靠更亮的缝 + 大一圈的角站起来，
         渐变档补一团近而柔的影子，液态档则由通透面 + 发光边成立。 -->
    <Style x:Key="CardNeumorph" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassCardBg}" />
        <Setter Property="Stroke" Value="{DynamicResource GlassCardStroke}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource GlassCardStrokeThickness}" />
        <Setter Property="Padding" Value="{DynamicResource WPadCard}" />
        <Setter Property="StrokeShape" Value="{DynamicResource WRadiusRaised}" />
        <Setter Property="Shadow">
            <Shadow Brush="{DynamicResource WShadowCardBrush}" Offset="0,5" Radius="14" Opacity="1" />
        </Setter>
    </Style>

    <!-- 凹档：细节的井。成立靠**底色比容器沉 + 上沿压一道线**，不是影子 ——
         落影永远意味着「浮着」，凹的地方不能有影子。 -->
    <Style x:Key="CardNeumorphInset" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WWellBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource WControlEdgeBrush}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource WControlEdgeWidth}" />
        <Setter Property="Padding" Value="{DynamicResource WPadWell}" />
        <Setter Property="StrokeShape" Value="{DynamicResource WRadiusWell}" />
    </Style>

    <!-- 通用按钮：本档 46，另有 Sm 34 / Lg 56（与 ButtonShapes 的高度梯度对齐）。 -->
    <Style x:Key="BtnNeumorph" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource WSurfaceBrush}" />
        <Setter Property="TextColor" Value="{DynamicResource SurfaceFg}" />
        <Setter Property="FontSize" Value="{DynamicResource WSizeBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="{DynamicResource WRadiusButton}" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="BorderWidth" Value="{DynamicResource WControlEdgeWidth}" />
        <Setter Property="BorderColor" Value="{DynamicResource GlassButtonStroke}" />
        <!-- 按钮不再挂影子：可点击性来自面与底的台阶 + 那一圈缝，不来自浮起。
             而且这是全站数量最多的元素，每个一个合成层，换页时最贵的一笔开销就省下了。 -->
        <Setter Property="motion:PressFeel.Enabled" Value="True" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal" />
                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{DynamicResource GlassButtonBgHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{DynamicResource GlassButtonBgPressed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- 焦点不再自绘一圈：WinUI 本来就在按钮外沿画一条系统焦点框，
                         我们再加一圈就成了「双边框」——首屏那颗主按钮自动获得焦点，
                         用户第一眼看到的是一圈不该有的黑框（实测截图已确认）。 -->
                    <VisualState Name="Focused" />
                    <VisualState Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- 紧凑档：替代表单里内联覆写字号/内距的写法 -->
    <Style x:Key="BtnNeumorphSm" TargetType="Button" BasedOn="{StaticResource BtnNeumorph}">
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="MinimumHeightRequest" Value="34" />
        <Setter Property="FontSize" Value="{DynamicResource WSizeCaption}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- 首屏档：标题页那种「一屏只有几个大钮」的场合。 -->
    <Style x:Key="BtnNeumorphLg" TargetType="Button" BasedOn="{StaticResource BtnNeumorph}">
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="Padding" Value="24,0" />
    </Style>

    <!-- 强调按钮：胶囊底 + 钉在上面的字（AccentWarmFg 是按 AccentWarm 算出来的对比墨） -->
    <Style x:Key="BtnNeumorphAccent" TargetType="Button" BasedOn="{StaticResource BtnNeumorph}">
        <Setter Property="Background" Value="{DynamicResource WAccentBrush}" />
        <Setter Property="TextColor" Value="{DynamicResource WAccentInk}" />
        <Setter Property="BorderColor" Value="Transparent" />
    </Style>

    <!-- 液态玻璃卡：材质完全交给 GlassTokens —— 它按当前世界算色标，
         所以这一段不再需要自己写死一串渐变 hex（那正是「换到蓝灰还剩一块奶油」的来源）。 -->
    <Style x:Key="CardLiquidGlass" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassCardBg}" />
        <Setter Property="Stroke" Value="{DynamicResource GlassCardStroke}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource GlassCardStrokeThickness}" />
        <Setter Property="Padding" Value="{DynamicResource WPadCard}" />
        <Setter Property="StrokeShape" Value="{DynamicResource WRadiusRaised}" />
        <Setter Property="Shadow">
            <Shadow Brush="{DynamicResource WShadowCardBrush}" Offset="0,8" Radius="18" Opacity="1" />
        </Setter>
    </Style>

    <!-- 可点击卡片（游戏入口/功能块）：悬停提亮、按下压暗，位移交给 PressFeel。
         上面那份 PointerOver 在桌面端不会触发（MAUI 不进这个态），真正会亮的是 HoverFeel 那条线；
         PointerOver 留着是因为它在别的控件路径上是对的。 -->
    <Style x:Key="PressableCard" TargetType="Border" BasedOn="{StaticResource CardNeumorph}">
        <Setter Property="motion:PressFeel.Enabled" Value="True" />
        <Setter Property="motion:HoverFeel.Enabled" Value="True" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal" />
                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{DynamicResource WSurfaceRaised}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{DynamicResource WWellBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- 分类/标签选择块：选中态用强调填充，按压位移由 PressFeel 补，状态里不写 TranslationY。 -->
    <Style x:Key="TagChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource BeigeAccent50}" />
        <Setter Property="Stroke" Value="{DynamicResource WControlEdgeBrush}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource WControlEdgeWidth}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="StrokeShape" Value="{DynamicResource WRadiusWell}" />
        <Setter Property="motion:PressFeel.Enabled" Value="True" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal" />
                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource WSurfaceRaised}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource WAccentBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

</ResourceDictionary>
