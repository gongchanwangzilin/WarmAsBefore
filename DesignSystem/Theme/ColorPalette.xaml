<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============ Primitive Palette ============ -->
    <!-- 奶油色 / Cream Base -->
    <Color x:Key="Cream50">#FEFCF8</Color>
    <Color x:Key="Cream100">#FDF6EE</Color>
    <Color x:Key="Cream150">#FCF2E6</Color>
    <Color x:Key="Cream200">#FAEBD7</Color>
    <Color x:Key="Cream250">#F7E5CC</Color>
    <Color x:Key="Cream300">#F5DFC0</Color>

    <!-- 米白色 / Off-White Base -->
    <Color x:Key="OffWhite50">#FFFAF5</Color>
    <Color x:Key="OffWhite100">#FDF8F0</Color>
    <Color x:Key="OffWhite200">#F5F0E8</Color>
    <Color x:Key="OffWhite300">#EDE6DA</Color>

    <!-- 米黄色 / Beige Base -->
    <Color x:Key="Beige50">#FDFBF7</Color>
    <Color x:Key="Beige100">#F5EFE0</Color>
    <Color x:Key="Beige150">#F0E8D5</Color>
    <Color x:Key="Beige200">#E8DFCA</Color>
    <Color x:Key="Beige250">#E0D4BA</Color>
    <Color x:Key="Beige300">#D4C9B0</Color>

    <!-- 暖中性色 / Warm Neutrals -->
    <Color x:Key="WarmWhite">#FFFEFA</Color>
    <Color x:Key="WarmDark">#5D4A3A</Color>
    <Color x:Key="WarmBody">#4A3D2C</Color>
    <Color x:Key="WarmMuted">#8B7D6B</Color>
    <Color x:Key="WarmFaint">#C4B89A</Color>

    <!-- 米色强调色 / Beige Accents (replaces old gold/yellow) -->
    <Color x:Key="BeigeAccent50">#F5EBDA</Color>
    <Color x:Key="BeigeAccent100">#EAD9BD</Color>
    <Color x:Key="BeigeAccent200">#DCC7A0</Color>
    <Color x:Key="BeigeAccent300">#CEB583</Color>

    <!-- 功能色 / Functional -->
    <Color x:Key="GreenSoft">#A5D6A7</Color>
    <Color x:Key="RedSoft">#EF9A9A</Color>
    <Color x:Key="BlueSoft">#90CAF9</Color>

    <!-- 阴影色 / Shadows -->
    <Color x:Key="ShadowLight">#FFFFFF</Color>
    <Color x:Key="ShadowDim">#D6D0C4</Color>
    <Color x:Key="ShadowDeep">#C8C0B0</Color>

    <!-- 气泡色 / Bubble Colors -->
    <Color x:Key="BubbleMine">#EAD9BD</Color>
    <Color x:Key="BubbleTheirs">#FDF8F0</Color>

    <!-- ============ Semantic Palette（语义色随主题切换） ============ -->
    <Color x:Key="PageBg">#F5F0E8</Color>
    <Color x:Key="SurfaceBg">#FDF8F0</Color>
    <Color x:Key="SurfaceFg">#4A3D2C</Color>
    <Color x:Key="PrimaryAction">#DCC7A0</Color>
    <Color x:Key="PrimaryHover">#CEB583</Color>
    <Color x:Key="PrimaryFg">#5D4A3A</Color>
    <Color x:Key="SecondaryBg">#FAEBD7</Color>
    <Color x:Key="MutedFg">#8B7D6B</Color>
    <Color x:Key="BorderLine">#F5DFC0</Color>
    <Color x:Key="InputBg">#F5F0E8</Color>
    <Color x:Key="SuccessTint">#A5D6A7</Color>
    <Color x:Key="DangerTint">#EF9A9A</Color>
    <Color x:Key="InfoTint">#90CAF9</Color>
    <Color x:Key="OverlayDim">#C84A3D2C</Color>
    <Color x:Key="TabActive">#EAD9BD</Color>
    <Color x:Key="TabInactive">#F5F0E8</Color>

    <!-- 紫粉强调色 / Pink Accent（发送胶囊、心情胶囊） -->
    <Color x:Key="AccentWarm">#F5D8B8</Color>
    <Color x:Key="AccentWarmFg">#8A6A4F</Color>

</ResourceDictionary>
