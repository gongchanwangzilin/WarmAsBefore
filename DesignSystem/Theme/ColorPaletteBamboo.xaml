<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============ 翠竹绿主题 Bamboo ============ -->
    <!-- 奶油色 / Cream Base -->
    <Color x:Key="Cream50">#FBFDF8</Color>
    <Color x:Key="Cream100">#F2F8EE</Color>
    <Color x:Key="Cream150">#EBF3E5</Color>
    <Color x:Key="Cream200">#E0ECD8</Color>
    <Color x:Key="Cream250">#D6E6CC</Color>
    <Color x:Key="Cream300">#CCDFC0</Color>

    <!-- 米白色 / Off-White Base -->
    <Color x:Key="OffWhite50">#FAFDF7</Color>
    <Color x:Key="OffWhite100">#F4F9F0</Color>
    <Color x:Key="OffWhite200">#EBF2E5</Color>
    <Color x:Key="OffWhite300">#DFE9D8</Color>

    <!-- 米黄色 / Beige Base -->
    <Color x:Key="Beige50">#FBFDF8</Color>
    <Color x:Key="Beige100">#EDF4E6</Color>
    <Color x:Key="Beige150">#E4EEDA</Color>
    <Color x:Key="Beige200">#DAE7CE</Color>
    <Color x:Key="Beige250">#CFDFC1</Color>
    <Color x:Key="Beige300">#C2D6B3</Color>

    <!-- 暖中性色 / Warm Neutrals -->
    <Color x:Key="WarmWhite">#FCFFFA</Color>
    <Color x:Key="WarmDark">#4C6150</Color>
    <Color x:Key="WarmBody">#5F7A64</Color>
    <Color x:Key="WarmMuted">#8FA393</Color>
    <Color x:Key="WarmFaint">#BCCBBE</Color>

    <!-- 米色强调色 / Beige Accents -->
    <Color x:Key="BeigeAccent50">#EFF7E8</Color>
    <Color x:Key="BeigeAccent100">#D3E6C6</Color>
    <Color x:Key="BeigeAccent200">#BAD99F</Color>
    <Color x:Key="BeigeAccent300">#A3C97E</Color>

    <!-- 功能色 / Functional -->
    <Color x:Key="GreenSoft">#9CC48F</Color>
    <Color x:Key="RedSoft">#EF9A9A</Color>
    <Color x:Key="BlueSoft">#90CAF9</Color>

    <!-- 阴影色 / Shadows -->
    <Color x:Key="ShadowLight">#FFFFFF</Color>
    <Color x:Key="ShadowDim">#DCE9D2</Color>
    <Color x:Key="ShadowDeep">#D0DFC4</Color>

    <!-- 气泡色 / Bubble Colors -->
    <Color x:Key="BubbleMine">#D3E6C6</Color>
    <Color x:Key="BubbleTheirs">#F4F9F0</Color>

    <!-- ============ Semantic Palette ============ -->
    <Color x:Key="PageBg">#F0F5EC</Color>
    <Color x:Key="SurfaceBg">#F8FBF6</Color>
    <Color x:Key="SurfaceFg">#4C6150</Color>
    <Color x:Key="PrimaryAction">#BAD99F</Color>
    <Color x:Key="PrimaryHover">#A3C97E</Color>
    <Color x:Key="PrimaryFg">#4C6150</Color>
    <Color x:Key="SecondaryBg">#E6EFDD</Color>
    <Color x:Key="MutedFg">#8FA393</Color>
    <Color x:Key="BorderLine">#DAE7CE</Color>
    <Color x:Key="InputBg">#F0F5EC</Color>
    <Color x:Key="SuccessTint">#A5D6A7</Color>
    <Color x:Key="DangerTint">#EF9A9A</Color>
    <Color x:Key="InfoTint">#90CAF9</Color>
    <Color x:Key="OverlayDim">#C84C6150</Color>
    <Color x:Key="TabActive">#D3E6C6</Color>
    <Color x:Key="TabInactive">#F0F5EC</Color>

    <!-- 粉调强调色 / Pink Accent（发送胶囊、心情等） -->
    <Color x:Key="AccentWarm">#EDE0C8</Color>
    <Color x:Key="AccentWarmFg">#5C5A48</Color>

</ResourceDictionary>
