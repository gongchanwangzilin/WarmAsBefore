<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============ 樱花粉主题 Sakura ============ -->
    <!-- 奶油色 / Cream Base -->
    <Color x:Key="Cream50">#FEFBFC</Color>
    <Color x:Key="Cream100">#FDF0F3</Color>
    <Color x:Key="Cream150">#FCF1F4</Color>
    <Color x:Key="Cream200">#F9DEE4</Color>
    <Color x:Key="Cream250">#F6D2DA</Color>
    <Color x:Key="Cream300">#F2C5D0</Color>

    <!-- 米白色 / Off-White Base -->
    <Color x:Key="OffWhite50">#FFF9FA</Color>
    <Color x:Key="OffWhite100">#FDF3F5</Color>
    <Color x:Key="OffWhite200">#F8E8EB</Color>
    <Color x:Key="OffWhite300">#F0D9DE</Color>

    <!-- 米黄色 / Beige Base -->
    <Color x:Key="Beige50">#FEF8F9</Color>
    <Color x:Key="Beige100">#F8E6EA</Color>
    <Color x:Key="Beige150">#F4DCE1</Color>
    <Color x:Key="Beige200">#EDCDD4</Color>
    <Color x:Key="Beige250">#E6C0C9</Color>
    <Color x:Key="Beige300">#DDB2BD</Color>

    <!-- 暖中性色 / Warm Neutrals -->
    <Color x:Key="WarmWhite">#FFFBFB</Color>
    <Color x:Key="WarmDark">#5A3340</Color>
    <!-- 粉底上的正文墨以前是 #7A4A56（6.4:1，四套主题里最弱的一档），压深一档，
         给标题→正文→注释留出三级台阶。 -->
    <Color x:Key="WarmBody">#8A4A5E</Color>
    <Color x:Key="WarmMuted">#B98A96</Color>
    <Color x:Key="WarmFaint">#D9B6C0</Color>

    <!-- 米色强调色 / Beige Accents -->
    <Color x:Key="BeigeAccent50">#FDE9EE</Color>
    <Color x:Key="BeigeAccent100">#F3C9D4</Color>
    <Color x:Key="BeigeAccent200">#ECA9BB</Color>
    <Color x:Key="BeigeAccent300">#E08BA4</Color>

    <!-- 功能色 / Functional -->
    <Color x:Key="GreenSoft">#DDA9B8</Color>
    <Color x:Key="RedSoft">#E5738C</Color>
    <Color x:Key="DangerInk">#A83A50</Color>
    <Color x:Key="BlueSoft">#90CAF9</Color>

    <!-- 阴影色 / Shadows -->
    <Color x:Key="ShadowLight">#FFFFFF</Color>
    <Color x:Key="ShadowDim">#F0CFD8</Color>
    <Color x:Key="ShadowDeep">#E4C0CA</Color>

    <!-- 气泡色 / Bubble Colors -->
    <Color x:Key="BubbleMine">#F3C9D4</Color>
    <Color x:Key="BubbleTheirs">#FDF3F5</Color>

    <!-- ============ Semantic Palette ============ -->
    <Color x:Key="PageBg">#FBF1F3</Color>
    <Color x:Key="SurfaceBg">#FEF8F9</Color>
    <Color x:Key="SurfaceFg">#693C49</Color>
    <Color x:Key="PrimaryAction">#ECA9BB</Color>
    <Color x:Key="PrimaryHover">#E08BA4</Color>
    <Color x:Key="PrimaryFg">#7A4A56</Color>
    <Color x:Key="SecondaryBg">#F9DFE5</Color>
    <Color x:Key="MutedFg">#7B5765</Color>
    <Color x:Key="BorderLine">#F3CBD5</Color>
    <Color x:Key="InputBg">#FBF1F3</Color>
    <!-- 深度台阶：凹档底色 / 平档描边（与经典档同一层级关系，只是跟着粉调走） -->
    <Color x:Key="WellBg">#F1D9DE</Color>
    <Color x:Key="EdgeStrong">#EAB6C4</Color>
    <Color x:Key="SuccessTint">#A5D6A7</Color>
    <Color x:Key="DangerTint">#EF9A9A</Color>
    <Color x:Key="InfoTint">#90CAF9</Color>
    <Color x:Key="OverlayDim">#C87A4A56</Color>
    <Color x:Key="TabActive">#F3C9D4</Color>
    <Color x:Key="TabInactive">#FBF1F3</Color>

    <!-- 粉调强调色 / Pink Accent（发送胶囊、心情等） -->
    <Color x:Key="AccentWarm">#F6DCC6</Color>
    <Color x:Key="AccentWarmFg">#6E4652</Color>

</ResourceDictionary>
